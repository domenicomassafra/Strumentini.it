{
  "schema_version": 1,
  "policy": {
    "output": "single filename component",
    "replacement": "_",
    "windows_reserved_names": "suffix underscore",
    "unicode_normalization": "NFC"
  },
  "vectors": [
    {
      "input": "../secret.txt",
      "expected": ".._secret.txt",
      "flags": [
        "path-separator"
      ]
    },
    {
      "input": "a/b\\c.txt",
      "expected": "a_b_c.txt",
      "flags": [
        "path-separator"
      ]
    },
    {
      "input": "CON",
      "expected": "CON_",
      "flags": [
        "windows-reserved-name"
      ]
    },
    {
      "input": "report. ",
      "expected": "report",
      "flags": [
        "windows-trailing-dot-space"
      ]
    },
    {
      "input": "é.txt",
      "expected": "é.txt",
      "flags": [
        "unicode-normalized"
      ]
    },
    {
      "input": "\u0000bad.txt",
      "expected": "_bad.txt",
      "flags": [
        "nul-control"
      ]
    }
  ],
  "security": "A sanitized name is not an authorized path. Callers must separately constrain the destination directory."
}
