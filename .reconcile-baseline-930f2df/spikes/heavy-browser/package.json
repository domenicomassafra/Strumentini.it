{
  "name": "utilityos-heavy-browser-spikes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "serve": "vite --host 127.0.0.1",
    "observe": "node scripts/run-browser-observations.mjs",
    "observe:prod": "node scripts/run-production-smoke.mjs",
    "build:pdf": "vite build pdf-capabilities --outDir ../dist-heavy-browser/pdf-capabilities --emptyOutDir",
    "build:image": "vite build image-pipeline --outDir ../dist-heavy-browser/image-pipeline --emptyOutDir",
    "build:file": "vite build file-pipeline --outDir ../dist-heavy-browser/file-pipeline --emptyOutDir",
    "build": "npm run build:pdf && npm run build:image && npm run build:file",
    "bench": "npm run observe && npm run build && npm run observe:prod && node scripts/collect-bundle-evidence.mjs"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "browser-image-compression": "2.0.2",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "file-type": "22.1.1",
    "hash-wasm": "4.12.0",
    "jsqr": "1.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pica": "10.0.3",
    "piexifjs": "1.0.6",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "vite": "8.3.0"
  }
}
