---
import "../styles/global.css";
import ShellChrome from "../components/shell/ShellChrome.astro";
import ToolRouteTelemetry from "../components/telemetry/ToolRouteTelemetry.astro";
import { catalog } from "../generated/catalog";
import {
  buildLibraryStructuredData,
  buildToolStructuredData,
  buildWebsiteStructuredData,
  formatPageTitle,
  normalizeDiscoveryPath,
  selectPageDescription,
  serializeJsonLd,
} from "../seo/public-discovery";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, image = "/og-image.png", imageAlt = "Local utility workbench", type = "website", noindex = false } = Astro.props;
const pathname = normalizeDiscoveryPath(Astro.url.pathname);
const configuredSite = Astro.site?.href ?? import.meta.env.PUBLIC_SITE_URL;
const canonicalUrl = configuredSite === undefined ? pathname : new URL(pathname, configuredSite).href;
const imageUrl = configuredSite === undefined ? image : new URL(image, configuredSite).href;
const robots = noindex ? "noindex, nofollow" : "index, follow";
const tool = catalog.find((entry) => entry.route === pathname);
const pageTitle = formatPageTitle(tool?.name ?? title);
const pageDescription = selectPageDescription(description, tool);
const structuredData = tool === undefined
  ? pathname === "/library"
    ? buildLibraryStructuredData(catalog, canonicalUrl, configuredSite)
    : pathname === "/"
      ? buildWebsiteStructuredData(canonicalUrl)
      : { "@context": "https://schema.org", "@type": "WebPage", name: pageTitle, description: pageDescription, url: canonicalUrl }
  : buildToolStructuredData(tool, canonicalUrl);
const structuredDataJson = serializeJsonLd(structuredData);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f5f6f2" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="Local Utility Workbench" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={structuredDataJson}></script>
  </head>
  <body>
    <ShellChrome pathname={pathname} search={Astro.url.search}>
      <ToolRouteTelemetry pathname={pathname} />
      <slot />
    </ShellChrome>
  </body>
</html>
