---
import "../styles/global.css";
import CloudflareWebAnalytics from "../components/analytics/CloudflareWebAnalytics.astro";
import ShellChrome from "../components/shell/ShellChrome.astro";
import ToolRouteTelemetry from "../components/telemetry/ToolRouteTelemetry.astro";
import { THEME_STORAGE_KEY, themeBootScript } from "../components/shell/theme";
import { catalog } from "../generated/catalog";
import tokenSheet from "../styles/global.css?raw";
import {
  buildDirectoryStructuredData,
  buildToolStructuredData,
  buildWebsiteStructuredData,
  formatPageTitle,
  normalizeDiscoveryPath,
  resolveDiscoveryUrl,
  selectPageDescription,
  serializeJsonLd,
} from "../seo/public-discovery";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, image = "/og-image.png", imageAlt = "Strumentini.it", type = "website", noindex = false } = Astro.props;
const pathname = normalizeDiscoveryPath(Astro.url.pathname);
const configuredSite = Astro.site?.href ?? import.meta.env.PUBLIC_SITE_URL;
const canonicalUrl = resolveDiscoveryUrl(pathname, configuredSite);
const imageUrl = configuredSite === undefined ? image : new URL(image, configuredSite).href;
const robots = noindex ? "noindex, nofollow" : "index, follow";
const tool = catalog.find((entry) => entry.route === pathname);
const pageTitle = formatPageTitle(tool?.name ?? title);
const pageDescription = selectPageDescription(description, tool);
const structuredData = tool === undefined
  ? pathname === "/strumenti"
    ? buildDirectoryStructuredData(catalog, canonicalUrl)
    : pathname === "/"
      ? buildWebsiteStructuredData(canonicalUrl)
      : { "@context": "https://schema.org", "@type": "WebPage", name: pageTitle, description: pageDescription, url: canonicalUrl }
  : buildToolStructuredData(tool, canonicalUrl);
const structuredDataJson = serializeJsonLd(structuredData);
// Paper, read from the token sheet rather than restated, so browser chrome can
// never drift from the world. `--canvas` is redefined for the night ground, so
// the two theme-color values follow the two themes.
function tokenValue(source: string, name: string): string {
  const match = source.match(new RegExp(`${name}:\\s*(#[0-9a-f]{6})`, "iu"));
  if (match === null) throw new Error(`Token ${name} is missing from the global token sheet`);
  return match[1]!;
}
const themeColor = tokenValue(tokenSheet, "--canvas");
const darkBlock = tokenSheet.split(':root[data-theme="dark"]')[1];
const darkThemeColor = darkBlock === undefined ? themeColor : tokenValue(darkBlock, "--canvas");
---
<!doctype html>
<html lang="it" data-theme-color-light={themeColor} data-theme-color-dark={darkThemeColor}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBootScript(THEME_STORAGE_KEY)}></script>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="Strumentini.it" />
    <meta name="application-name" content="Strumentini.it" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={structuredDataJson}></script>
  </head>
  <body>
    <ShellChrome pathname={pathname}>
      <ToolRouteTelemetry pathname={pathname} />
      <slot />
    </ShellChrome>
    <CloudflareWebAnalytics />
  </body>
</html>
