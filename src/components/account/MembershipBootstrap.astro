---
/**
 * Binds every favourite control on the page to the membership store.
 *
 * The buttons are server-rendered (so the page is complete without JavaScript);
 * this island only reflects the stored state and writes changes back. When a
 * session exists it also reconciles the device list with the account.
 */
---

<script>
  import {
    loadMembership,
    membershipBaselineOwner,
    pushMembershipChange,
    subscribeMembership,
    syncMembershipWithAccount,
    toggleInstalled,
    type Membership,
  } from "../../workbench/membership";

  const toggles = (): HTMLButtonElement[] =>
    Array.from(document.querySelectorAll<HTMLButtonElement>("[data-membership-toggle]"));

  function paint(membership: Membership): void {
    const installed = new Set(membership.installed);
    for (const toggle of toggles()) {
      const toolId = toggle.dataset.membershipToggle;
      if (toolId === undefined) continue;
      const on = installed.has(toolId);
      toggle.dataset.installed = String(on);
      toggle.setAttribute("aria-pressed", String(on));
      const label = on ? "Rimuovi dai tuoi strumenti" : "Aggiungi ai tuoi strumenti";
      toggle.setAttribute("aria-label", label);
      toggle.setAttribute("title", label);
    }
    for (const counter of document.querySelectorAll<HTMLElement>("[data-membership-count]")) {
      counter.textContent = String(membership.installed.length);
    }
    for (const label of document.querySelectorAll<HTMLElement>("[data-membership-label]")) {
      const count = membership.installed.length;
      label.textContent = count === 0
        ? "Nessuno strumento scelto"
        : count === 1 ? "1 strumento scelto" : `${count} strumenti scelti`;
    }
    for (const empty of document.querySelectorAll<HTMLElement>("[data-membership-empty]")) {
      empty.hidden = membership.installed.length > 0;
    }
  }

  let signedIn = false;
  let ready = false;
  let loading = false;

  function controlsReady(value: boolean): void {
    ready = value;
    for (const toggle of toggles()) {
      toggle.disabled = !value;
      toggle.setAttribute("aria-busy", String(!value));
      if (!value) toggle.setAttribute("title", "Attendi la verifica dei preferiti");
    }
  }

  // The session/account and its remote baseline must be known before the first
  // click. Otherwise a quick local add may be silently replaced by the first
  // authenticated GET. Buttons are disabled in server markup until hydrated.
  controlsReady(false);

  document.addEventListener("click", (event) => {
    const toggle = event.target instanceof Element
      ? event.target.closest<HTMLButtonElement>("[data-membership-toggle]")
      : null;
    if (toggle === null) return;
    event.preventDefault();
    if (!ready || toggle.disabled) return;
    const toolId = toggle.dataset.membershipToggle;
    if (toolId === undefined) return;
    const wasInstalled = toggle.dataset.installed === "true";
    void toggleInstalled(toolId).then((membership) => {
      paint(membership);
      void pushMembershipChange(toolId, !wasInstalled, signedIn);
    });
  });

  subscribeMembership((membership) => {
    if (ready) paint(membership);
  });

  async function initialize(): Promise<void> {
    if (loading) return;
    loading = true;
    controlsReady(false);
    document.dispatchEvent(new Event("strumentini:membership-loading"));
    try {
      const response = await fetch("/api/auth/session", { credentials: "same-origin", headers: { accept: "application/json" } });
      if (response.ok) {
        const body = await response.json() as { user?: unknown };
        signedIn = Boolean(body.user);
      } else {
        signedIn = false;
      }
    } catch {
      signedIn = false;
    }
    const membership = signedIn ? await syncMembershipWithAccount() : undefined;
    const baselineOwner = await membershipBaselineOwner();
    const localIsPrivate = !signedIn && baselineOwner !== undefined;
    const cannotVerify = signedIn && membership === undefined;
    const accessible = !localIsPrivate && !cannotVerify;
    const shown = accessible ? membership ?? await loadMembership() : { installed: [], recent: [] };
    paint(shown);
    controlsReady(accessible);
    document.dispatchEvent(new CustomEvent<Membership>("strumentini:membership-ready", { detail: shown }));
    loading = false;
  }

  // A network reconnection is an opportunity to send queued offline changes;
  // the existing sync serial queue and per-tool CAS preserve remote tombstones.
  window.addEventListener("online", () => { void initialize(); });
  void initialize();
</script>
