---
import { catalog } from "../../generated/catalog";
import { contextTagsForTools } from "../../onboarding/membership";
import { getLibraryFacets } from "../../library/model";
import { categoryLabelIt, inputTypeLabelIt, tagLabelIt } from "../../i18n/it/taxonomy";
import { categoryIconSvg } from "../../ui/tool-icons";
import { qualityIndex } from "../../generated/quality";
import { goldToolIds } from "../../onboarding/quality";

const contextTags = contextTagsForTools(catalog);
const verifiedToolIds = goldToolIds(qualityIndex);

const libraryMetadata = catalog.map((tool) => ({
  id: tool.id,
  route: tool.route,
  name: tool.name,
  summary: tool.summary,
  aliases: tool.aliases,
  jobs: tool.jobs,
  category: tool.category,
  inputTypes: tool.inputTypes,
  packTags: contextTags.get(tool.id) ?? [],
  engine: tool.engine,
  runtime: tool.runtime,
  quality: verifiedToolIds.has(tool.id) ? "verified" as const : "checking" as const,
}));
const facets = getLibraryFacets(libraryMetadata);
const tagFacets = [...new Set([...facets.packTags, ...facets.roleTags])].sort((left, right) => left.localeCompare(right));
const libraryMetadataJson = JSON.stringify(libraryMetadata).replaceAll("<", "\\u003c");
const categoryCounts = facets.categories.map((category) => ({
  category,
  label: categoryLabelIt(category),
  count: libraryMetadata.filter((tool) => tool.category === category).length,
  icon: categoryIconSvg(category, "library-category-icon"),
}));
---

<section class="library-workspace" aria-labelledby="library-title">
  <header class="library-heading">
    <p class="library-eyebrow">Libreria</p>
    <h1 id="library-title">Trova lo strumento, non un muro di schede.</h1>
    <p>Parti da ciò che vuoi fare: scegli una categoria oppure cerca direttamente un'attività.</p>
  </header>

  <nav class="category-browser" aria-label="Categorie degli strumenti">
    <a href="/library/" data-library-category=""><span class="category-all-mark" aria-hidden="true">•</span><span>Tutti</span><small>{libraryMetadata.length}</small></a>
    {categoryCounts.map(({ category, label, count, icon }) => (
      <a href={`/library/?category=${encodeURIComponent(category)}`} data-library-category={category}>
        <span set:html={icon}></span><span>{label}</span><small>{count}</small>
      </a>
    ))}
  </nav>

  <form class="library-controls" data-library-form aria-label="Filtra gli strumenti della Libreria">
    <label class="library-search" for="library-search"><span>Ricerca</span><input id="library-search" name="q" type="search" autocomplete="off" placeholder="Prova “giornata lavorativa”" /></label>
    <label><span>Categoria</span><select name="category"><option value="">Tutte</option>{facets.categories.map((value) => <option value={value}>{categoryLabelIt(value)}</option>)}</select></label>
    {tagFacets.length > 0 && <label><span>Ambito / ruolo</span><select name="tag"><option value="">Tutti</option>{tagFacets.map((value) => <option value={value}>{tagLabelIt(value)}</option>)}</select></label>}
    <label><span>Tipo di ingresso</span><select name="input"><option value="">Tutti</option>{facets.inputTypes.map((value) => <option value={value}>{inputTypeLabelIt(value)}</option>)}</select></label>
    <label><span>Esecuzione</span><select name="runtime"><option value="">Tutte</option><option value="LOCAL">Su questo dispositivo</option><option value="NETWORK">Usa la rete</option></select></label>
    <label><span>Affidabilità</span><select name="quality"><option value="">Tutti</option><option value="verified">Verificati</option><option value="checking">In verifica</option></select></label>
    <label><span>Installati</span><select name="installed"><option value="">Tutti</option><option value="installed">Installati</option><option value="not-installed">Non installati</option></select></label>
  </form>

  <div class="library-summary" aria-live="polite"><strong data-library-count>0 strumenti</strong><a href="/library/" data-library-clear><svg class="library-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 8h10"/></svg><span>Azzera i filtri</span></a></div>
  <div class="library-list" data-library-results></div>
  <nav class="library-pagination" aria-label="Pagine della Libreria" data-library-pagination></nav>
  <aside class="request-box" id="request-tool">
    <strong>Manca un'utilità deterministica?</strong>
    <p>Tieni la ricerca corrente nell'URL e richiedi lo strumento senza riempitivi generati.</p>
    <button type="button" data-request-tool data-request-button>Richiedi questo strumento</button>
    <span data-request-status role="status"></span>
  </aside>
  <script is:inline type="application/json" id="strumentiutili-library-catalog" set:html={libraryMetadataJson}></script>
</section>

<script>
  import { isLocalToolRoute } from "../../catalog/manifest";
  import { filterLibrary, pageLibrary, parseLibraryState, serializeLibraryState } from "../../library/library";
  import { createSearch } from "../../search/search";
  import { SEARCH_CONTEXT_EVENT, sanitizeSearchContext } from "../../search/browser-context";
  import { getTelemetryAdapter, rememberToolEntrySource } from "../../telemetry/browser";
  import { classifySearchCategory, classifySearchIntent, trackSearchZeroResult } from "../../telemetry/events";
  import { categoryLabelIt } from "../../i18n/it/taxonomy";
  import { toolIconSvg } from "../../ui/tool-icons";
  import type { LibraryState } from "../../library/library";
  import type { SearchContext, SearchToolMetadata } from "../../search/types";

  const root = document.querySelector<HTMLElement>(".library-workspace");
  const form = root?.querySelector<HTMLFormElement>("[data-library-form]");
  const results = root?.querySelector<HTMLElement>("[data-library-results]");
  const pagination = root?.querySelector<HTMLElement>("[data-library-pagination]");
  const count = root?.querySelector<HTMLElement>("[data-library-count]");
  const dataNode = root?.querySelector<HTMLScriptElement>("#strumentiutili-library-catalog");
  const requestButton = root?.querySelector<HTMLButtonElement>("[data-request-button]");
  const requestStatus = root?.querySelector<HTMLElement>("[data-request-status]");
  const tools = JSON.parse(dataNode?.textContent ?? "[]") as SearchToolMetadata[];
  const search = createSearch(tools);
  let context: SearchContext = {};
  let lastZeroResultKey = "";
  try {
    const stored = window.sessionStorage.getItem("strumentiutili:workbench-context:v1");
    if (stored !== null) {
      context = sanitizeSearchContext(JSON.parse(stored));
    }
  } catch (error) {
    void error;
  }

  const escapeHtml = (value: string): string => value.replace(/[&<>"']/gu, (character) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;",
  })[character] ?? character);

  const runtimeLabel = (tool: SearchToolMetadata): string => {
    if (tool.runtime.location === "LOCAL") return "Su questo dispositivo";
    if (tool.runtime.location === "REFERENCE") return "Solo riferimento";
    return "Usa dati di rete";
  };

  const runtimeCode = (tool: SearchToolMetadata): string => {
    if (tool.runtime.location === "LOCAL") return "locale";
    if (tool.runtime.location === "REFERENCE") return "rif.";
    return "rete";
  };

  const qualityLabel = (tool: SearchToolMetadata): string => tool.quality === "verified" ? "Verificato" : "In verifica";

  // A 1px hairline marker, not a coloured card: the row is ruled like the rest of the ledger.
  const openIcon = '<svg class="library-icon library-icon-open" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 3l7 5-7 5"/></svg>';
  const prevIcon = '<svg class="library-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 3L5 8l5 5"/></svg>';
  const nextIcon = '<svg class="library-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5"/></svg>';

  function stateFromLocation(): LibraryState {
    return parseLibraryState(window.location.search);
  }

  function syncForm(state: LibraryState): void {
    if (!form) return;
    for (const [name, value] of Object.entries(state)) {
      if (name === "page") continue;
      const control = form.elements.namedItem(name);
      if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement) control.value = String(value);
    }
    root?.querySelectorAll<HTMLElement>("[data-library-category]").forEach((item) => {
      if ((item.dataset.libraryCategory ?? "") === state.category) item.setAttribute("aria-current", "page");
      else item.removeAttribute("aria-current");
    });
  }

  function render(): void {
    if (!results || !pagination || !count) return;
    const state = stateFromLocation();
    syncForm(state);
    const filtered = filterLibrary(tools, state, context);
    const page = pageLibrary(filtered, state.page, 50);
    if (page.total === 0) {
      const intentCode = classifySearchIntent(state.q);
      const categoryCode = classifySearchCategory(state.category);
      const zeroResultKey = `${intentCode}:${categoryCode}`;
      if (zeroResultKey !== lastZeroResultKey) {
        trackSearchZeroResult(getTelemetryAdapter(), intentCode, categoryCode);
        lastZeroResultKey = zeroResultKey;
      }
    } else {
      lastZeroResultKey = "";
    }
    count.textContent = `${page.total} ${page.total === 1 ? "strumento" : "strumenti"}`;
    if (page.items.length === 0) {
      const closeIntents = state.q ? search.query(state.q, context, 4).closeIntents : [];
      const suggestions = closeIntents.map((intent) => `<button type="button" data-close-intent="${escapeHtml(intent)}">${escapeHtml(intent)}</button>`).join("");
      const reason = state.q ? `Nessuno strumento corrisponde a “${escapeHtml(state.q)}”.` : "Nessuno strumento corrisponde a questi filtri.";
      results.innerHTML = `<div class="library-zero"><strong>${reason}</strong><p>Ricerca e filtri restano nell'URL. Prova a togliere qualche filtro o richiedi esattamente questo strumento.</p>${suggestions ? `<div class="close-intents">${suggestions}</div>` : ""}</div>`;
    } else {
      results.innerHTML = page.items.filter((tool) => isLocalToolRoute(tool.route)).map((tool) => {
        const installed = (context.installedToolIds ?? []).includes(tool.id);
        const name = escapeHtml(tool.name);
        const summary = escapeHtml(tool.summary);
        const category = categoryLabelIt(tool.category);
        const detail = `${summary} · ${escapeHtml(category)} · ${runtimeLabel(tool)}`;
        const icon = toolIconSvg(tool, "library-tool-icon");
        return `<a class="library-row" data-library-tool-id="${escapeHtml(tool.id)}" href="${escapeHtml(tool.route)}" title="${detail}">`
          + `<span class="tool-main"><strong title="${name}">${icon}${name}</strong><small title="${summary}">${summary}</small></span>`
          + `<span class="tool-category" title="${escapeHtml(category)}"><span>${escapeHtml(category)}</span><small class="tool-quality" data-quality="${tool.quality ?? "checking"}">${qualityLabel(tool)}</small></span>`
          + `<span class="tool-runtime"><span class="tool-runtime-full" title="${runtimeLabel(tool)}">${runtimeLabel(tool)}</span><span class="tool-runtime-code">${runtimeCode(tool)}</span></span>`
          + `<span class="tool-action">${installed ? "Aggiunto · Apri" : "Apri"}${openIcon}</span></a>`;
      }).join("");
    }
    const links: string[] = [];
    if (page.page > 1) links.push(`<button type="button" data-page="${page.page - 1}">${prevIcon}<span>Precedente</span></button>`);
    links.push(`<span class="library-page-label">Pagina ${page.page} di ${page.totalPages}</span>`);
    if (page.page < page.totalPages) links.push(`<button type="button" data-page="${page.page + 1}"><span>Successiva</span>${nextIcon}</button>`);
    pagination.innerHTML = links.join("");
  }

  function replaceState(next: LibraryState, mode: "push" | "replace" = "push"): void {
    const query = serializeLibraryState(next);
    const url = `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`;
    window.history[mode === "push" ? "pushState" : "replaceState"]({}, "", url);
    render();
  }

  const readFormState = (): LibraryState | undefined => {
    if (!form) return;
    const values = new FormData(form);
    return {
      q: String(values.get("q") ?? ""), category: String(values.get("category") ?? ""), tag: String(values.get("tag") ?? ""),
      input: String(values.get("input") ?? ""), runtime: String(values.get("runtime") ?? "") as LibraryState["runtime"],
      installed: String(values.get("installed") ?? "") as LibraryState["installed"], quality: String(values.get("quality") ?? "") as LibraryState["quality"], page: 1,
    };
  };
  form?.querySelector<HTMLInputElement>("input[name='q']")?.addEventListener("input", () => {
    const state = readFormState();
    if (state) replaceState(state, "replace");
  });
  form?.addEventListener("change", (event) => {
    if (event.target instanceof HTMLInputElement && event.target.name === "q") return;
    const state = readFormState();
    if (state) replaceState(state, "push");
  });
  results?.addEventListener("click", (event) => {
    const toolLink = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-library-tool-id]") : null;
    const toolId = toolLink?.dataset.libraryToolId;
    if (toolId !== undefined) rememberToolEntrySource(toolId, "public");
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-close-intent]") : null;
    if (!button) return;
    replaceState({ ...stateFromLocation(), q: button.dataset.closeIntent ?? "", page: 1 }, "push");
    root?.querySelector<HTMLInputElement>("#library-search")?.focus();
  });
  pagination?.addEventListener("click", (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-page]") : null;
    if (!button) return;
    replaceState({ ...stateFromLocation(), page: Number(button.dataset.page ?? 1) }, "push");
  });
  window.addEventListener("popstate", render);
  window.addEventListener(SEARCH_CONTEXT_EVENT, (event) => {
    context = sanitizeSearchContext((event as CustomEvent<SearchContext>).detail);
    try {
      window.sessionStorage.setItem("strumentiutili:workbench-context:v1", JSON.stringify(context));
    } catch (error) {
      void error;
    }
    render();
  });
  requestButton?.addEventListener("click", () => {
    if (requestStatus) requestStatus.textContent = `Richiesta: “${stateFromLocation().q || "nuova utilità"}”. L'invio non è collegato in questa build di validazione.`;
  });
  render();
  if (new URLSearchParams(window.location.search).get("focus") === "search") {
    root?.querySelector<HTMLInputElement>("#library-search")?.focus();
  }
</script>

<style>
  /* Consumer rules only. Missing W1 token-sheet entries reported to the coordinator:
     --carta / --carta-alta / --carta-fonda, --inchiostro / --inchiostro-2 / --inchiostro-3,
     --rossa / --rossa-tenue, --verde / --ambra / --blu-nota, --gutter-width, --numeric. */
  .library-workspace {
    width: min(100% - (var(--container-gutter) * 2), var(--container-workbench-max));
    margin-inline: auto;
    padding-block: var(--space-12) var(--space-16);
  }

  .library-heading { max-width: var(--reading-max); margin-bottom: var(--space-8); }
  .library-heading h1 {
    margin: var(--space-1) 0 var(--space-3);
    max-width: var(--measure-copy);
    font-size: var(--font-size-h2);
    line-height: var(--line-height-heading);
    letter-spacing: -0.02em;
  }
  .library-heading p { margin: 0; color: var(--muted); }
  .library-eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .category-browser {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr));
    margin-bottom: var(--space-6);
    border-top: var(--border-width) solid var(--line);
    border-left: var(--border-width) solid var(--line);
  }
  .category-browser a {
    min-height: var(--control-height-touch);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-right: var(--border-width) solid var(--line);
    border-bottom: var(--border-width) solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .category-browser a:hover,
  .category-browser a[aria-current="page"] { background: var(--surface-muted); }
  .category-browser a[aria-current="page"] { box-shadow: inset var(--state-border-width) 0 0 0 var(--action); }
  .category-browser small { color: var(--muted); font-variant-numeric: tabular-nums lining-nums; }
  .category-browser :global(.library-category-icon),
  .category-all-mark { width: 16px; color: var(--muted); text-align: center; }

  /* Six controls, fluid tracks: the grid fits as many as the width allows instead of
     forcing six fields into four fixed columns. */
  .library-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-4);
    border-block: var(--border-width) solid var(--line);
  }
  .library-controls label { display: grid; gap: var(--space-1); min-width: 0; }
  .library-controls label > span {
    color: var(--muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
  }
  .library-controls input, .library-controls select {
    width: 100%;
    min-width: 0;
    min-height: var(--control-height-touch);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: inherit;
  }
  .library-search { grid-column: span 2; }

  .library-summary {
    min-height: var(--control-height-touch);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--muted);
    font-size: var(--font-size-sm);
  }
  .library-summary strong { font-variant-numeric: tabular-nums lining-nums; font-weight: var(--font-weight-semibold); }
  .library-summary a { min-height: var(--control-height-touch); display: inline-flex; align-items: center; gap: var(--space-2); }
  .library-summary a:hover { color: var(--ink); }

  .library-list { border-top: var(--border-width) solid var(--line); }

  /* Fluid ledger columns: name takes the remaining width, the two metadata columns
     share it by ratio, and the action column is content-sized. */
  .library-workspace :global(.library-row) {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.34fr) minmax(0, 0.42fr) auto;
    gap: var(--space-4);
    align-items: baseline;
    min-height: var(--row-height-compact);
    padding-block: var(--space-3);
    border-bottom: var(--border-width) solid var(--line);
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--motion-ease);
  }
  /* Active-row marker: one hairline rule, ink only, inside the row's own left edge. */
  .library-workspace :global(.library-row::before) {
    content: "";
    position: absolute;
    inset-block: -1px;
    inset-inline-start: calc(var(--space-4) * -1);
    width: var(--state-border-width);
    background: var(--action);
    opacity: 0;
    transition: opacity var(--motion-fast) var(--motion-ease);
  }
  .library-workspace :global(.library-row:hover) { background: var(--surface-muted); }
  .library-workspace :global(.library-row:hover::before),
  .library-workspace :global(.library-row:focus-visible::before) { opacity: 1; }
  .library-workspace :global(.library-row:focus-visible) {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: calc(var(--focus-offset) * -1);
    background: var(--surface-muted);
  }

  .library-workspace :global(.tool-main) { min-width: 0; display: grid; gap: var(--space-1); }
  .library-workspace :global(.tool-main strong) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--font-weight-semibold);
    /* Name wraps to a second line rather than truncating silently. */
    overflow-wrap: anywhere;
  }
  .library-workspace :global(.tool-main small) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
    color: var(--muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }
  .library-workspace :global(.tool-category),
  .library-workspace :global(.tool-runtime) {
    min-width: 0;
    color: var(--muted);
    font-size: var(--font-size-sm);
    overflow-wrap: anywhere;
  }
  .library-workspace :global(.tool-category) { display: grid; gap: var(--space-1); }
  .library-workspace :global(.tool-quality) { font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); }
  .library-workspace :global(.tool-quality[data-quality="verified"]) { color: var(--success); }
  .library-workspace :global(.tool-runtime) { display: flex; align-items: baseline; gap: var(--space-2); }
  .library-workspace :global(.tool-runtime-code) { display: none; font-variant-numeric: tabular-nums lining-nums; }
  .library-workspace :global(.tool-action) {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }
  .library-workspace :global(.library-row:hover .tool-action) { color: var(--action); }
  .library-workspace :global(.library-icon),
  .library-workspace :global(.library-tool-icon) { flex: 0 0 auto; }
  .library-workspace :global(.tool-main .library-tool-icon) { color: var(--muted); }
  .library-workspace :global(.tool-action .library-icon-open) { opacity: 0; transition: opacity var(--motion-fast) var(--motion-ease); }
  .library-workspace :global(.library-row:hover .tool-action .library-icon-open) { opacity: 1; }

  .library-workspace :global(.library-zero) { padding-block: var(--space-8); border-bottom: var(--border-width) solid var(--line); }
  .library-workspace :global(.library-zero p) { max-width: var(--measure-copy); color: var(--muted); }
  .library-workspace :global(.close-intents) { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .library-workspace :global(.close-intents button) {
    min-height: var(--control-height-touch);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: inherit;
  }
  .library-workspace :global(.close-intents button:hover) { background: var(--surface-muted); }

  .library-pagination {
    min-height: var(--space-16);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
  }
  .library-pagination :global(button), .request-box button {
    min-height: var(--control-height-touch);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: inherit;
  }
  .library-pagination :global(button:hover), .request-box button:hover { background: var(--surface-muted); }
  .library-pagination :global(.library-page-label) { color: var(--muted); font-size: var(--font-size-sm); font-variant-numeric: tabular-nums lining-nums; }

