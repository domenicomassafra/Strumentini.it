---
import { catalog } from "../../generated/catalog";
import { getLibraryFacets } from "../../library/model";

const libraryMetadata = catalog.map((tool) => ({
  id: tool.id,
  route: tool.route,
  name: tool.name,
  summary: tool.summary,
  aliases: tool.aliases,
  jobs: tool.jobs,
  category: tool.category,
  inputTypes: tool.inputTypes,
  engine: tool.engine,
  runtime: tool.runtime,
}));
const facets = getLibraryFacets(libraryMetadata);
const tagFacets = [...new Set([...facets.packTags, ...facets.roleTags])].sort((left, right) => left.localeCompare(right));
const libraryMetadataJson = JSON.stringify(libraryMetadata).replaceAll("<", "\\u003c");
---

<section class="library-workspace" aria-labelledby="library-title">
  <header class="library-heading">
    <p class="library-eyebrow">Library</p>
    <h1 id="library-title">Find the tool, not a card wall.</h1>
    <p>Search deterministic catalog metadata and narrow by what the tool accepts or where it runs.</p>
  </header>

  <form class="library-controls" data-library-form aria-label="Filter Library tools">
    <label class="library-search" for="library-search"><span>Search</span><input id="library-search" name="q" type="search" autocomplete="off" placeholder="Try “working day”" /></label>
    <label><span>Category</span><select name="category"><option value="">All</option>{facets.categories.map((value) => <option value={value}>{value}</option>)}</select></label>
    {tagFacets.length > 0 && <label><span>Pack / role</span><select name="tag"><option value="">All</option>{tagFacets.map((value) => <option value={value}>{value}</option>)}</select></label>}
    <label><span>Input</span><select name="input"><option value="">All</option>{facets.inputTypes.map((value) => <option value={value}>{value}</option>)}</select></label>
    <label><span>Runtime</span><select name="runtime"><option value="">All</option><option value="LOCAL">On this device</option><option value="NETWORK">Uses network</option></select></label>
    <label><span>Installed</span><select name="installed"><option value="">All</option><option value="installed">Installed</option><option value="not-installed">Not installed</option></select></label>
  </form>

  <div class="library-summary" aria-live="polite"><strong data-library-count>0 tools</strong><a href="/library/">Clear filters</a></div>
  <div class="library-list" data-library-results></div>
  <nav class="library-pagination" aria-label="Library pages" data-library-pagination></nav>
  <aside class="request-box" id="request-tool">
    <strong>Missing a deterministic utility?</strong>
    <p>Keep your current search in the URL and request the tool without generated filler.</p>
    <button type="button" data-request-button>Request this tool</button>
    <span data-request-status role="status"></span>
  </aside>
  <script is:inline type="application/json" id="utilityos-library-catalog" set:html={libraryMetadataJson}></script>
</section>

<script>
  import { isLocalToolRoute } from "../../catalog/manifest";
  import { filterLibrary, pageLibrary, parseLibraryState, serializeLibraryState } from "../../library/library";
  import { createSearch } from "../../search/search";
  import { SEARCH_CONTEXT_EVENT, sanitizeSearchContext } from "../../search/browser-context";
  import type { LibraryState } from "../../library/library";
  import type { SearchContext, SearchToolMetadata } from "../../search/types";

  const root = document.querySelector<HTMLElement>(".library-workspace");
  const form = root?.querySelector<HTMLFormElement>("[data-library-form]");
  const results = root?.querySelector<HTMLElement>("[data-library-results]");
  const pagination = root?.querySelector<HTMLElement>("[data-library-pagination]");
  const count = root?.querySelector<HTMLElement>("[data-library-count]");
  const dataNode = root?.querySelector<HTMLScriptElement>("#utilityos-library-catalog");
  const requestButton = root?.querySelector<HTMLButtonElement>("[data-request-button]");
  const requestStatus = root?.querySelector<HTMLElement>("[data-request-status]");
  const tools = JSON.parse(dataNode?.textContent ?? "[]") as SearchToolMetadata[];
  const search = createSearch(tools);
  let context: SearchContext = {};
  try {
    const stored = window.sessionStorage.getItem("utilityos:workbench-context:v1");
    if (stored !== null) {
      context = sanitizeSearchContext(JSON.parse(stored));
    }
  } catch (error) {
    void error;
  }

  const escapeHtml = (value: string): string => value.replace(/[&<>"']/gu, (character) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;",
  })[character] ?? character);

  const runtimeLabel = (tool: SearchToolMetadata): string => {
    if (tool.runtime.location === "LOCAL") return "On this device";
    if (tool.runtime.location === "REFERENCE") return "Reference only";
    return "Uses network data";
  };

  function stateFromLocation(): LibraryState {
    return parseLibraryState(window.location.search);
  }

  function syncForm(state: LibraryState): void {
    if (!form) return;
    for (const [name, value] of Object.entries(state)) {
      if (name === "page") continue;
      const control = form.elements.namedItem(name);
      if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement) control.value = String(value);
    }
  }

  function render(): void {
    if (!results || !pagination || !count) return;
    const state = stateFromLocation();
    syncForm(state);
    const filtered = filterLibrary(tools, state, context);
    const page = pageLibrary(filtered, state.page, 50);
    count.textContent = `${page.total} ${page.total === 1 ? "tool" : "tools"}`;
    if (page.items.length === 0) {
      const closeIntents = state.q ? search.query(state.q, context, 4).closeIntents : [];
      const suggestions = closeIntents.map((intent) => `<button type="button" data-close-intent="${escapeHtml(intent)}">${escapeHtml(intent)}</button>`).join("");
      const reason = state.q ? `No tools match “${escapeHtml(state.q)}”.` : "No tools match these filters.";
      results.innerHTML = `<div class="library-zero"><strong>${reason}</strong><p>Your query and filters are preserved. Try fewer filters or request this exact tool.</p>${suggestions ? `<div class="close-intents">${suggestions}</div>` : ""}</div>`;
    } else {
      results.innerHTML = page.items.filter((tool) => isLocalToolRoute(tool.route)).map((tool) => {
        const installed = (context.installedToolIds ?? []).includes(tool.id);
        return `<a class="library-row" data-library-tool-id="${escapeHtml(tool.id)}" href="${escapeHtml(tool.route)}"><span class="tool-main"><strong>${escapeHtml(tool.name)}</strong><small>${escapeHtml(tool.summary)}</small></span><span class="tool-category">${escapeHtml(tool.category)}</span><span class="tool-runtime">${runtimeLabel(tool)}</span><span class="tool-action">${installed ? "Added · Open" : "Open"}</span></a>`;
      }).join("");
    }
    const links: string[] = [];
    if (page.page > 1) links.push(`<button type="button" data-page="${page.page - 1}">Previous</button>`);
    links.push(`<span>Page ${page.page} of ${page.totalPages}</span>`);
    if (page.page < page.totalPages) links.push(`<button type="button" data-page="${page.page + 1}">Next</button>`);
    pagination.innerHTML = links.join("");
  }

  function replaceState(next: LibraryState, mode: "push" | "replace" = "push"): void {
    const query = serializeLibraryState(next);
    const url = `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`;
    window.history[mode === "push" ? "pushState" : "replaceState"]({}, "", url);
    render();
  }

  const readFormState = (): LibraryState | undefined => {
    if (!form) return;
    const values = new FormData(form);
    return {
      q: String(values.get("q") ?? ""), category: String(values.get("category") ?? ""), tag: String(values.get("tag") ?? ""),
      input: String(values.get("input") ?? ""), runtime: String(values.get("runtime") ?? "") as LibraryState["runtime"],
      installed: String(values.get("installed") ?? "") as LibraryState["installed"], page: 1,
    };
  };
  form?.querySelector<HTMLInputElement>("input[name='q']")?.addEventListener("input", () => {
    const state = readFormState();
    if (state) replaceState(state, "replace");
  });
  form?.addEventListener("change", (event) => {
    if (event.target instanceof HTMLInputElement && event.target.name === "q") return;
    const state = readFormState();
    if (state) replaceState(state, "push");
  });
  results?.addEventListener("click", (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-close-intent]") : null;
    if (!button) return;
    replaceState({ ...stateFromLocation(), q: button.dataset.closeIntent ?? "", page: 1 }, "push");
    root?.querySelector<HTMLInputElement>("#library-search")?.focus();
  });
  pagination?.addEventListener("click", (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-page]") : null;
    if (!button) return;
    replaceState({ ...stateFromLocation(), page: Number(button.dataset.page ?? 1) }, "push");
  });
  window.addEventListener("popstate", render);
  window.addEventListener(SEARCH_CONTEXT_EVENT, (event) => {
    context = sanitizeSearchContext((event as CustomEvent<SearchContext>).detail);
    try {
      window.sessionStorage.setItem("utilityos:workbench-context:v1", JSON.stringify(context));
    } catch (error) {
      void error;
    }
    render();
  });
  requestButton?.addEventListener("click", () => {
    if (requestStatus) requestStatus.textContent = `Request target: “${stateFromLocation().q || "new utility"}”. Submission is not connected in this validation build.`;
  });
  render();
  if (new URLSearchParams(window.location.search).get("focus") === "search") {
    root?.querySelector<HTMLInputElement>("#library-search")?.focus();
  }
</script>

<style>
  .library-workspace { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 44px 0 88px; }
  .library-heading { max-width: 760px; margin-bottom: 28px; }
  .library-heading h1 { margin: 4px 0 10px; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1; letter-spacing: -.035em; }
  .library-heading p { color: var(--muted); }
  .library-eyebrow { margin: 0; font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; font-weight: 800; color: var(--muted); }
  .library-controls { display: grid; grid-template-columns: minmax(260px, 1fr) repeat(4, minmax(120px, auto)); gap: 8px; padding: 12px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .library-controls label { display: grid; gap: 4px; }
  .library-controls label > span { color: var(--muted); font-size: .72rem; font-weight: 700; }
  .library-controls input, .library-controls select { width: 100%; min-height: 44px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: inherit; }
  .library-summary { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--muted); font-size: .82rem; }
  .library-summary a { min-height: 44px; display: inline-flex; align-items: center; }
  .library-list { border-top: 1px solid var(--line); }
  .library-workspace :global(.library-row) { min-height: 52px; display: grid; grid-template-columns: minmax(0, 1fr) 130px 140px minmax(90px, auto); gap: 14px; align-items: center; border-bottom: 1px solid var(--line); text-decoration: none; }
  .library-workspace :global(.tool-main) { min-width: 0; }
  .library-workspace :global(.tool-main strong), .library-workspace :global(.tool-main small) { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .library-workspace :global(.tool-main small), .library-workspace :global(.tool-category), .library-workspace :global(.tool-runtime) { color: var(--muted); font-size: .8rem; }
  .library-workspace :global(.tool-action) { justify-self: end; font-weight: 700; color: var(--action); }
  .library-workspace :global(.library-zero) { padding: 32px 0; border-bottom: 1px solid var(--line); }
  .library-workspace :global(.library-zero p) { color: var(--muted); }
  .library-workspace :global(.close-intents) { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .library-workspace :global(.close-intents button) { min-height: 44px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: inherit; padding: 7px 9px; cursor: pointer; }
  .library-pagination { min-height: 56px; display: flex; justify-content: center; align-items: center; gap: 12px; }
  .library-pagination :global(button), .request-box button { min-height: 44px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: inherit; padding: 8px 10px; cursor: pointer; }
  .request-box { margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--line); }
  .request-box p, .request-box span { color: var(--muted); }
  .request-box span { margin-left: 10px; font-size: .8rem; }
  @media (max-width: 840px) { .library-controls { grid-template-columns: 1fr 1fr; } .library-search { grid-column: 1 / -1; } .library-workspace :global(.library-row) { grid-template-columns: minmax(0, 1fr) auto; padding: 8px 0; } .library-workspace :global(.tool-category), .library-workspace :global(.tool-runtime) { display: none; } }
  @media (max-width: 520px) { .library-workspace { padding-top: 28px; padding-bottom: 104px; } .library-controls { grid-template-columns: 1fr; } .library-search { grid-column: auto; } }
</style>
