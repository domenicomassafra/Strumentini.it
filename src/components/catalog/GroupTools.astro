---
import type { CatalogGroup } from "../../catalog/groups";
import type { ToolSummary } from "../../catalog/manifest";
import { categoryLabelIt } from "../../i18n/it/taxonomy";
import { qualityIndex } from "../../generated/quality";
import { goldToolIds } from "../../onboarding/quality";
import ToolCard from "../tools/ToolCard.astro";

/**
 * The filterable, sortable full list of a group's tools.
 *
 * Sub-category pills, pagination and the sort control are plain DOM state: the
 * inline script reads one metadata map (route → category + certification) and
 * moves the `ToolCard` items that are already on the page. No results are
 * fetched and the current <=24-tool category pages keep their one-page behavior.
 */
interface Props {
  group: CatalogGroup;
  tools: readonly ToolSummary[];
}

const { group, tools } = Astro.props;

const verifiedIds = goldToolIds(qualityIndex);

const subCategories = group.memberCategories.map((category) => ({
  value: category,
  label: categoryLabelIt(category),
  // Counts belong to the inventory this surface actually renders. Using the
  // generated production catalog here makes test-only expanded inventories —
  // and any future scoped inventory — lie about their facet totals.
  count: tools.filter((tool) => tool.category === category).length,
}));

const meta: Record<string, { category: string; verified: boolean }> = {};
for (const tool of tools) meta[tool.route] = { category: tool.category, verified: verifiedIds.has(tool.id) };
const metaJson = JSON.stringify(meta).replace(/</gu, "\\u003c");

const total = tools.length;
---

<section class="group-tools" data-group-tools aria-labelledby="tutti-gli-strumenti">
  <div class="section-head">
    <div>
      <h2 class="section-title" id="tutti-gli-strumenti" tabindex="-1">Tutti gli strumenti ({total})</h2>
      <p class="section-sub" data-tool-status aria-live="polite">{total} strumenti in questa categoria.</p>
    </div>

    <label class="group-sort">
      <span>Ordina per</span>
      <select data-tool-sort>
        <option value="az" selected>Nome (A–Z)</option>
        <option value="za">Nome (Z–A)</option>
        <option value="verified">Verificati prima</option>
      </select>
    </label>
  </div>

  <ul class="group-filters" aria-label="Filtra per sottocategoria">
    <li>
      <button type="button" class="pill pill-brand" data-filter="all" aria-pressed="true">Tutti ({total})</button>
    </li>
    {subCategories.map((sub) => (
      <li>
        <button type="button" class="pill" data-filter={sub.value} aria-pressed="false">
          {sub.label} ({sub.count})
        </button>
      </li>
    ))}
  </ul>

  <ul class="tool-grid" data-tool-grid>
    {tools.map((tool) => <ToolCard tool={tool} variant="card" />)}
  </ul>

  <nav aria-label="Pagine della categoria" data-group-pagination hidden>
    <ul class="group-filters" data-group-pagination-list></ul>
  </nav>

  <p class="group-tools-empty" data-tool-empty hidden>Nessuno strumento in questa sottocategoria.</p>

  <script type="application/json" data-tool-meta set:html={metaJson}></script>
  <script is:inline>
    (() => {
      const root = document.querySelector("[data-group-tools]");
      if (!root) return;

      const grid = root.querySelector("[data-tool-grid]");
      const metaSource = root.querySelector("[data-tool-meta]");
      const sortSelect = root.querySelector("[data-tool-sort]");
      const status = root.querySelector("[data-tool-status]");
      const empty = root.querySelector("[data-tool-empty]");
      const pagination = root.querySelector("[data-group-pagination]");
      const paginationList = root.querySelector("[data-group-pagination-list]");
      const heading = root.querySelector("#tutti-gli-strumenti");
      const pills = Array.prototype.slice.call(root.querySelectorAll("[data-filter]"));
      if (!grid || !sortSelect || pills.length === 0) return;

      let meta = {};
      try {
        meta = JSON.parse(metaSource && metaSource.textContent ? metaSource.textContent : "{}");
      } catch (error) {
        meta = {};
      }

      const cards = Array.prototype.slice.call(grid.children);
      cards.forEach((card) => {
        const link = card.querySelector(".tool-card-name a");
        const route = link ? link.getAttribute("href") : "";
        const info = (route && meta[route]) || {};
        card.dataset.category = info.category || "";
        card.dataset.verified = info.verified ? "true" : "false";
        card.dataset.name = link ? link.textContent.trim() : "";
      });

      const collator = new Intl.Collator("it", { sensitivity: "base" });
      const PAGE_SIZE = 24;
      const total = cards.length;
      let active = "all";
      let page = 1;

      const pageItems = (current, pageCount) => {
        const items = [];
        for (let candidate = 1; candidate <= pageCount; candidate += 1) {
          if (candidate === 1 || candidate === pageCount || Math.abs(candidate - current) <= 1) items.push(candidate);
          else if (items[items.length - 1] !== "gap") items.push("gap");
        }
        return items;
      };

      const renderPagination = (pageCount) => {
        if (!pagination || !paginationList) return;
        paginationList.replaceChildren();
        pagination.hidden = pageCount <= 1;
        if (pageCount <= 1) return;

        const addPageButton = (target, label, current = false) => {
          const item = document.createElement("li");
          if (current) {
            const here = document.createElement("span");
            here.className = "pill pill-brand";
            here.setAttribute("aria-current", "page");
            here.textContent = label;
            item.appendChild(here);
          } else {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "pill";
            button.dataset.groupPage = String(target);
            button.textContent = label;
            button.addEventListener("click", () => {
              page = target;
              apply(true);
            });
            item.appendChild(button);
          }
          paginationList.appendChild(item);
        };

        if (page > 1) addPageButton(page - 1, "Precedente");
        for (const item of pageItems(page, pageCount)) {
          if (item === "gap") {
            const gapItem = document.createElement("li");
            const gap = document.createElement("span");
            gap.className = "pill";
            gap.setAttribute("aria-hidden", "true");
            gap.textContent = "…";
            gapItem.appendChild(gap);
            paginationList.appendChild(gapItem);
          } else {
            addPageButton(item, String(item), item === page);
          }
        }
        if (page < pageCount) addPageButton(page + 1, "Successiva");
      };

      const apply = (focusHeading = false) => {
        const mode = sortSelect.value;
        const sorted = cards.slice().sort((a, b) => {
          if (mode === "verified") {
            const aRank = a.dataset.verified === "true" ? 0 : 1;
            const bRank = b.dataset.verified === "true" ? 0 : 1;
            if (aRank !== bRank) return aRank - bRank;
          }
          const byName = collator.compare(a.dataset.name, b.dataset.name);
          return mode === "za" ? -byName : byName;
        });

        const matching = sorted.filter((card) => active === "all" || card.dataset.category === active);
        const pageCount = Math.max(1, Math.ceil(matching.length / PAGE_SIZE));
        page = Math.min(Math.max(page, 1), pageCount);
        const start = (page - 1) * PAGE_SIZE;
        const visible = new Set(matching.slice(start, start + PAGE_SIZE));
        sorted.forEach((card) => {
          card.hidden = !visible.has(card);
          grid.appendChild(card);
        });

        if (status) {
          if (matching.length === 0) status.textContent = "Nessuno strumento in questa sottocategoria.";
          else if (matching.length <= PAGE_SIZE) {
            status.textContent = active === "all"
              ? total + " strumenti in questa categoria."
              : "Mostrati " + matching.length + " di " + total + " strumenti.";
          } else {
            const first = start + 1;
            const last = Math.min(start + PAGE_SIZE, matching.length);
            status.textContent = active === "all"
              ? "Mostrati " + first + "–" + last + " di " + matching.length + " strumenti in questa categoria."
              : "Mostrati " + first + "–" + last + " di " + matching.length + " strumenti filtrati (" + total + " totali).";
          }
        }
        if (empty) empty.hidden = matching.length !== 0;
        renderPagination(pageCount);
        if (focusHeading && heading instanceof HTMLElement) heading.focus();
      };

      pills.forEach((pill) => {
        pill.addEventListener("click", () => {
          active = pill.dataset.filter || "all";
          page = 1;
          pills.forEach((other) => {
            const on = other === pill;
            other.setAttribute("aria-pressed", on ? "true" : "false");
            other.classList.toggle("pill-brand", on);
          });
          apply();
        });
      });

      sortSelect.addEventListener("change", () => {
        page = 1;
        apply();
      });
      apply();
    })();
  </script>
</section>

<style>
  .group-tools { margin-bottom: var(--space-12); }

  .group-sort {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .group-sort select {
    min-height: var(--control-height);
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    font-size: var(--font-size-body);
  }

  .group-sort select:hover { border-color: var(--brand); }

  .group-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .group-filters button { font-size: var(--font-size-xs); }

  .group-tools :global(.tool-card[hidden]) { display: none; }

  .group-tools-empty {
    margin: var(--space-6) 0 0;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  @media (min-width: 900px) {
    .group-filters { margin-bottom: var(--space-8); }
  }
</style>
