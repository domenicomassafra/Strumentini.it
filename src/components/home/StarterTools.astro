---
import ToolCard from "../tools/ToolCard.astro";
import { catalog } from "../../generated/catalog";

/**
 * "Da dove iniziare" is an editorial selection, not a popularity claim: these
 * are the eight jobs a new visitor most often needs on the first visit. The
 * list is by id and any id that leaves the catalog simply drops out.
 */
const starterIds = [
  "pdf-merge",
  "image-compression",
  "csv-cleaner",
  "word-character-line-counter",
  "images-to-pdf",
  "qr-generator",
  "date-difference",
  "margin-markup",
] as const;

const starters = starterIds
  .map((id) => catalog.find((tool) => tool.id === id))
  .filter((tool): tool is (typeof catalog)[number] => tool !== undefined);
---

<section class="section">
  <div class="section-head">
    <div>
      <h2 class="section-title">Da dove iniziare</h2>
      <p class="section-sub">Otto strumenti che coprono i lavori più comuni della giornata.</p>
    </div>
    <a class="section-link" href="/strumenti/">Vedi tutti gli strumenti</a>
  </div>

  <ul class="tool-grid home-starter-grid">
    {starters.map((tool) => <ToolCard tool={tool} />)}
  </ul>
</section>

<style>
  @media (min-width: 1060px) {
    .home-starter-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
