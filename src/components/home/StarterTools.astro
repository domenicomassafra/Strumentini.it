---
import ToolCard from "../tools/ToolCard.astro";
import { catalog } from "../../generated/catalog";
import { curateHomeTools413 } from "../../catalog/home-curation-413";

/**
 * "Da dove iniziare" is an authored collection of eight representative local
 * jobs, NOT a popularity or usage claim. Missing tools fail closed at build.
 */
const starters = curateHomeTools413(catalog);
---

<section class="section">
  <div class="section-head">
    <div>
      <h2 class="section-title">Da dove iniziare</h2>
      <p class="section-sub">Otto esempi editoriali di attività quotidiane: non sono una classifica di popolarità.</p>
    </div>
    <a class="section-link" href="/strumenti/">Vedi tutti gli strumenti</a>
  </div>

  <ul class="tool-grid home-starter-grid">
    {starters.map(({ tool }) => <ToolCard tool={tool} />)}
  </ul>
</section>

<style>
  @media (min-width: 1060px) {
    .home-starter-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
