---
/**
 * #345: A recent activity is a completed tool ID, not a cached document,
 * pasted input or last scalar value. The canonical state is the same bounded
 * IndexedDB list shown in /preferiti/. A deep link reopens a tool, never a blob.
 */
---

<section class="section home-recent" data-recent-section hidden aria-labelledby="home-recent-title">
  <div class="section-head">
    <div>
      <h2 class="section-title" id="home-recent-title">Riprendi da dove eri</h2>
      <p class="section-sub">Gli strumenti con cui hai completato un'attività su questo dispositivo, senza conservare i contenuti.</p>
    </div>
    <a class="section-link" href="/preferiti/#recenti">Tutte le attività recenti</a>
  </div>
  <ul class="tool-grid home-recent-grid" data-recent-list></ul>
  <p class="home-recent-warning" role="status" data-recent-warning hidden>
    La memoria del browser non è disponibile: questi recenti sono temporanei e potrebbero sparire cambiando pagina.
  </p>
</section>

<script>
  import { loadMembership, subscribeMembership } from "../../workbench/membership";
  import type { Membership } from "../../workbench/membership";
  import { selectHomeRecent345 } from "./recent-tools-345";

  const section = document.querySelector<HTMLElement>("[data-recent-section]");
  const list = section?.querySelector<HTMLElement>("[data-recent-list]");
  const warning = section?.querySelector<HTMLElement>("[data-recent-warning]");
  let sequence = 0;

  // The small workbench projection is deferred; never import the full catalog.
  const catalog = import("../../generated/workbench-catalog").catch(() => null);

  async function render(membership: Membership): Promise<void> {
    const revision = ++sequence;
    if (!list || !section) return;
    // Storage disclosure does not depend on the optional catalog download.
    if (warning) warning.hidden = membership.persisted !== false;
    section.hidden = list.childElementCount === 0 && membership.persisted !== false;
    const loaded = await catalog;
    if (revision !== sequence || loaded === null) return;
    const { workbenchCatalog } = loaded;
    const recent = selectHomeRecent345(membership.recent, workbenchCatalog);
    const fragment = document.createDocumentFragment();
    for (const tool of recent) {
      const item = document.createElement("li");
      item.className = "tool-card tool-card-row";
      const body = document.createElement("div");
      body.className = "tool-card-body";
      const heading = document.createElement("h3");
      heading.className = "tool-card-name";
      const anchor = document.createElement("a");
      anchor.href = tool.route;
      anchor.textContent = tool.name;
      heading.append(anchor);
      const summary = document.createElement("p");
      summary.className = "tool-card-summary";
      summary.textContent = tool.summary;
      body.append(heading, summary);
      const footer = document.createElement("div");
      footer.className = "tool-card-foot";
      const label = document.createElement("span");
      label.className = "tool-card-category";
      label.textContent = tool.category;
      const action = document.createElement("a");
      action.className = "home-recent-open";
      action.href = tool.route;
      action.textContent = "Apri di nuovo";
      footer.append(label, action);
      item.append(body, footer);
      fragment.append(item);
    }
    list.replaceChildren(fragment);
    // A denied store can leave Recenti empty even after a real completion.
    // Keep its warning accessible instead of hiding the whole section.
    section.hidden = recent.length === 0 && membership.persisted !== false;
  }

  subscribeMembership((membership) => { void render(membership).catch(() => undefined); });
  void loadMembership().then(render).catch(() => {
    if (section) section.hidden = true;
  });
</script>

<style>
  .home-recent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .home-recent-open { color: var(--brand); font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); }
  .home-recent-warning { font-size: var(--font-size-sm); color: var(--text-muted); margin-top: var(--space-3); }

  @media (min-width: 1060px) {
    .home-recent-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
