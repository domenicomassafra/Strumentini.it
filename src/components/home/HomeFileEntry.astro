---
import { catalog } from "../../generated/catalog";
import { fileSuggestions335 } from "./file-suggestions-335";

// Only actual Astro tool pages count as destinations; catalog entries alone
// cannot promote a missing route into a recommendation.
const publishedRoutes = new Set(
  Object.keys(import.meta.glob("../../pages/tools/*.astro")).map((path) =>
    "/tools/" + path.split("/").at(-1)!.replace(/\.astro$/u, "")
  ),
);
const mimeByFormat = {
  pdf: "application/pdf", png: "image/png", jpeg: "image/jpeg",
  webp: "image/webp", gif: "image/gif", zip: "application/zip", csv: "text/csv",
} as const;
const suggestions = (Object.keys(mimeByFormat) as (keyof typeof mimeByFormat)[]).flatMap((format) =>
  fileSuggestions335({
    status: "supported", format, mime: mimeByFormat[format],
    name: "", bytes: 1, readBytes: 1,
    method: "bounded-signature-and-container-metadata",
    note: "candidate only; decoding and content safety are not verified",
  }, catalog, publishedRoutes),
);
---

<section class="home-file-entry" aria-labelledby="home-file-title" data-home-file-entry>
  <div class="home-file-heading">
    <div>
      <h2 id="home-file-title">Hai già un file?</h2>
      <p id="home-file-help">Scegli un'immagine da Foto o un file dal dispositivo. Scopri quali strumenti locali possono aprirlo.</p>
    </div>
    <span class="home-file-privacy">Controllo locale, nessun caricamento</span>
  </div>

  <div class="home-file-dropzone" data-home-file-dropzone>
    <div class="home-file-picker-options">
      <div class="home-file-picker-option">
        <label for="home-photos-picker" class="home-file-picker-label">Foto e immagini</label>
        <input id="home-photos-picker" type="file" accept="image/*" class="home-file-picker" data-home-photos-picker aria-describedby="home-file-photos-help home-file-status" />
        <p id="home-file-photos-help" class="home-file-picker-help">La galleria disponibile dipende dal dispositivo. Il controllo locale riconosce PNG, JPEG, GIF e WebP.</p>
      </div>
      <div class="home-file-picker-option">
        <label for="home-file-picker" class="home-file-picker-label">File dal dispositivo</label>
        <input id="home-file-picker" type="file" class="home-file-picker" data-home-file-picker aria-describedby="home-file-files-help home-file-status" />
        <p id="home-file-files-help" class="home-file-picker-help">Apri il selettore File anche per PDF e altri formati. Massimo 32 MiB per il controllo iniziale; per CSV, verifica strutturale completa fino a 256 KiB.</p>
      </div>
    </div>
    <p class="home-file-drop-hint">Oppure trascina un solo file in quest'area, se usi mouse o trackpad. Nessuna foto viene scattata automaticamente.</p>
  </div>

  <p id="home-file-status" class="home-file-status" role="status" aria-live="polite" aria-atomic="true" data-home-file-status>
    Il file rimane in questo browser. Nessuna operazione parte automaticamente.
  </p>

  <div class="home-file-result" data-home-file-result hidden>
    <h3>Operazioni disponibili per questo formato</h3>
    <p class="home-file-caution" data-home-file-prior-notice hidden>
      Il controllo del nuovo file è in corso. Le operazioni elencate si riferiscono al file precedente.
    </p>
    <ul class="home-file-actions" data-home-file-actions>
      {suggestions.map(({ format, route, name }) => (
        <li data-home-file-action-format={format} hidden>
          <a href={route + "/"}>{name}</a>
        </li>
      ))}
    </ul>
    <p data-home-file-no-actions hidden>
      Il formato è riconoscibile, ma non abbiamo confermato una pagina locale compatibile.
      Puoi cercare uno strumento manualmente.
    </p>
    <p class="home-file-caution">
      Aprendo lo strumento dovrai selezionare di nuovo il file: in questa versione
      non viene trasferito tra pagine. Il riconoscimento iniziale non garantisce
      che il contenuto sia elaborabile.
    </p>
    <button type="button" class="home-file-reset" data-home-file-reset>Rimuovi la selezione</button>
  </div>
</section>

<script>
  import type { LocalFileRefusalReason } from "../../runtime/file-detection";

  const root = document.querySelector<HTMLElement>("[data-home-file-entry]");
  const dropzone = root?.querySelector<HTMLElement>("[data-home-file-dropzone]");
  const picker = root?.querySelector<HTMLInputElement>("[data-home-file-picker]");
  const photosPicker = root?.querySelector<HTMLInputElement>("[data-home-photos-picker]");
  const status = root?.querySelector<HTMLElement>("[data-home-file-status]");
  const resultPanel = root?.querySelector<HTMLElement>("[data-home-file-result]");
  const priorNotice = root?.querySelector<HTMLElement>("[data-home-file-prior-notice]");
  const actions = root?.querySelector<HTMLElement>("[data-home-file-actions]");
  const noActions = root?.querySelector<HTMLElement>("[data-home-file-no-actions]");
  const resetButton = root?.querySelector<HTMLButtonElement>("[data-home-file-reset]");
  let generation = 0;
  let active: AbortController | null = null;
  const previousOptionsHint = " Le operazioni visualizzate si riferiscono all'ultimo file riconosciuto.";

  const reasonText: Record<LocalFileRefusalReason, string> = {
    EMPTY: "Il file è vuoto. Scegli un file che contenga dati.",
    TOO_LARGE: "File oltre il limite di verifica locale: massimo 32 MiB in generale e 256 KiB per il controllo strutturale CSV. Nessun file è stato caricato.",
    UNSUPPORTED: "Formato non riconosciuto dal controllo locale. Usa la ricerca per cercare uno strumento.",
    MALFORMED: "Il file sembra incompleto o non rispetta la struttura prevista. Nessuna operazione suggerita.",
    POLYGLOT: "Il file contiene strutture incompatibili o ambigue. Nessuna operazione suggerita.",
    MIME_MISMATCH: "Il tipo dichiarato non coincide con i dati rilevati. Nessuna operazione suggerita.",
    EXTENSION_MISMATCH: "L'estensione non coincide con il formato effettivo. Nessuna operazione suggerita.",
    CANCELLED: "Controllo annullato. Puoi scegliere nuovamente un file.",
    READ_FAILED: "Impossibile leggere il file in questo browser. Puoi riprovare o cercare uno strumento.",
  };

  function clearActions(): void {
    if (resultPanel) resultPanel.hidden = true;
    if (priorNotice) priorNotice.hidden = true;
    for (const option of actions?.querySelectorAll<HTMLElement>("[data-home-file-action-format]") ?? []) {
      option.hidden = true;
    }
    if (noActions) noActions.hidden = true;
  }

  function clearSelection(): void {
    generation += 1;
    active?.abort();
    active = null;
    if (picker) picker.value = "";
    if (photosPicker) photosPicker.value = "";
    clearActions();
    if (status) status.textContent = "Selezione rimossa. Puoi scegliere un altro file.";
    root?.removeAttribute("aria-busy");
  }

  async function inspect(files: readonly File[], photosOnly = false): Promise<void> {
    if (!status) return;
    if (files.length === 0) {
      // An empty drop/change is not a replacement for a file already chosen.
      // Keep its pending read (and the previous validated result) intact.
      cancelledPicker("Scelta annullata. Puoi riprovare.");
      return;
    }
    const current = ++generation;
    active?.abort();
    active = null;
    if (files.length !== 1) {
      clearActions();
      if (priorNotice) priorNotice.hidden = true;
      root?.removeAttribute("aria-busy");
      status.textContent = "Scegli un solo file alla volta. Nessun file è stato elaborato.";
      return;
    }
    const file = files[0];
    if (!file) return;
    const controller = new AbortController();
    active = controller;
    status.textContent = "Controllo locale del formato in corso…";
    if (priorNotice) priorNotice.hidden = !resultPanel || resultPanel.hidden;
    root?.setAttribute("aria-busy", "true");
    try {
      const { detectLocalFile } = await import("../../runtime/file-detection");
      if (current !== generation || controller.signal.aborted) return;
      const detected = await detectLocalFile(file, { signal: controller.signal });
      if (current !== generation || controller.signal.aborted) return;
      if (detected.status === "refused") {
        const recoverable = detected.reason === "READ_FAILED" || detected.reason === "CANCELLED";
        if (!recoverable) clearActions();
        status.textContent = reasonText[detected.reason]
          + (recoverable && resultPanel && !resultPanel.hidden ? previousOptionsHint : "");
        return;
      }
      if (photosOnly && !["png", "jpeg", "gif", "webp"].includes(detected.format)) {
        clearActions();
        status.textContent = "Il selettore Foto accetta soltanto immagini PNG, JPEG, GIF o WebP. Usa File dal dispositivo per altri formati.";
        return;
      }
      clearActions();
      const matches = [...(actions?.querySelectorAll<HTMLElement>("[data-home-file-action-format]") ?? [])]
        .filter((option) => option.dataset.homeFileActionFormat === detected.format);
      for (const option of matches) option.hidden = false;
      if (resultPanel) resultPanel.hidden = false;
      if (noActions) noActions.hidden = matches.length > 0;
      status.textContent = "Formato " + detected.format.toUpperCase() + " riconosciuto localmente. "
        + matches.length + (matches.length === 1 ? " strumento possibile." : " strumenti possibili.");
    } catch {
      if (current !== generation || controller.signal.aborted) return;
      status.textContent = "Controllo locale non disponibile. Nessuna operazione avviata."
        + (resultPanel && !resultPanel.hidden ? previousOptionsHint : "");
    } finally {
      if (current === generation) {
        active = null;
        if (priorNotice) priorNotice.hidden = true;
        root?.removeAttribute("aria-busy");
      }
    }
  }

  function cancelledPicker(message: string): void {
    resetDrag();
    // The chooser can be opened again while an earlier file is still being
    // inspected. Dismissing that chooser does not revoke the already selected
    // File; only a new nonempty selection or Reset supersedes its inspection.
    if (active) return;
    generation += 1;
    if (priorNotice) priorNotice.hidden = true;
    root?.removeAttribute("aria-busy");
    if (status) status.textContent = message
      + (resultPanel && !resultPanel.hidden ? previousOptionsHint : "");
  }

  function receivePickerFiles(input: HTMLInputElement): void {
    const files = [...(input.files ?? [])];
    // Reset native inputs so browsers can emit a change event when the same
    // file is selected again after cancellation or a refusal.
    input.value = "";
    if (files.length === 0) {
      cancelledPicker("Nessun nuovo file ricevuto. Puoi riprovare.");
      return;
    }
    void inspect(files, input === photosPicker);
  }

  for (const input of [picker, photosPicker]) {
    input?.addEventListener("change", () => receivePickerFiles(input));
    input?.addEventListener("cancel", () => {
      input.value = "";
      cancelledPicker("Scelta annullata. Puoi aprire di nuovo Foto o File.");
    });
    input?.addEventListener("error", () => {
      input.value = "";
      cancelledPicker("Impossibile completare la selezione. Controlla gli eventuali permessi e riprova.");
    });
  }
  // Native file controls are visible before this deferred Astro module loads.
  // If the OS chooser returned first, its change event was missed; the chosen
  // File still lives in the input and must take the normal validation path.
  const earlyFiles = [picker, photosPicker].filter((input): input is HTMLInputElement => Boolean(input?.files?.length));
  if (earlyFiles.length === 1) {
    receivePickerFiles(earlyFiles[0]!);
  } else if (earlyFiles.length > 1) {
    // Order of two pre-initialization selections is unknowable; require an
    // explicit new choice instead of guessing which File the user intended.
    for (const input of earlyFiles) input.value = "";
    if (status) status.textContent = "Sono presenti due selezioni precedenti. Scegli un solo file per continuare.";
  }
  resetButton?.addEventListener("click", clearSelection);

  function isFileDrag(event: DragEvent): boolean {
    return [...(event.dataTransfer?.types ?? [])].includes("Files");
  }

  function resetDrag(): void {
    dropzone?.classList.remove("home-file-drag-active");
  }

  dropzone?.addEventListener("dragenter", (event) => {
    if (!isFileDrag(event)) return;
    event.preventDefault();
    dropzone.classList.add("home-file-drag-active");
  });
  dropzone?.addEventListener("dragover", (event) => {
    if (!isFileDrag(event)) return;
    event.preventDefault();
    if (event.dataTransfer) event.dataTransfer.dropEffect = "copy";
  });
  dropzone?.addEventListener("dragleave", (event) => {
    if (!dropzone.contains(event.relatedTarget as Node | null)) resetDrag();
  });
  dropzone?.addEventListener("drop", (event) => {
    if (!isFileDrag(event)) return;
    event.preventDefault();
    resetDrag();
    void inspect([...(event.dataTransfer?.files ?? [])]);
  });
  window.addEventListener("dragend", resetDrag);
  window.addEventListener("blur", resetDrag);
  window.addEventListener("drop", (event) => {
    resetDrag();
    if (isFileDrag(event)) event.preventDefault();
  });
</script>

<style>
  .home-file-entry {
    margin: var(--space-5) 0 var(--space-10);
    padding: var(--space-6);
    min-width: 0;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .home-file-entry [hidden] { display: none !important; }
  .home-file-heading { display: flex; gap: var(--space-4); align-items: start; justify-content: space-between; flex-wrap: wrap; }
  .home-file-heading h2 { margin: 0; font-size: var(--font-size-h2); }
  .home-file-heading p { margin: var(--space-2) 0 var(--space-4); color: var(--text-muted); }
  .home-file-privacy { font-size: var(--font-size-sm); color: var(--text-muted); }
  .home-file-dropzone {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-5);
    border: 2px dashed var(--border);
    border-radius: var(--radius-md);
    min-width: 0;
  }
  .home-file-drag-active { border-color: var(--brand); background: var(--brand-soft); }
  .home-file-picker-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .home-file-picker-option { display: grid; align-content: start; gap: var(--space-2); min-width: 0; }
  .home-file-picker-label { font-weight: var(--font-weight-semibold); }
  .home-file-picker { display: block; width: 100%; min-height: 44px; min-width: 0; max-width: 100%; box-sizing: border-box; font: inherit; color: var(--text); }
  .home-file-picker::file-selector-button { min-height: 44px; border-radius: var(--radius-md); border: var(--border-width) solid var(--border); background: var(--surface); color: var(--text); font: inherit; cursor: pointer; }
  .home-file-picker:focus-visible { outline: 3px solid var(--brand); outline-offset: 3px; }
  .home-file-picker-help { margin: 0; color: var(--text-muted); font-size: var(--font-size-sm); overflow-wrap: anywhere; }
  .home-file-drop-hint { margin: 0; color: var(--text-muted); font-size: var(--font-size-sm); }
  .home-file-status { min-height: 1.5em; color: var(--text-muted); margin: var(--space-4) 0 0; overflow-wrap: anywhere; }
  .home-file-result { margin-top: var(--space-5); border-top: var(--border-width) solid var(--border); padding-top: var(--space-5); }
  .home-file-result h3 { margin: 0 0 var(--space-3); font-size: var(--font-size-body-lg); }
  .home-file-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); list-style: none; padding: 0; margin: 0; }
  .home-file-actions a, .home-file-reset {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3);
    min-height: 44px;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--border);
    color: var(--text);
    background: var(--surface);
    font: inherit;
  }
  .home-file-actions a:hover, .home-file-reset:hover { border-color: var(--brand); }
  .home-file-caution { font-size: var(--font-size-sm); color: var(--text-muted); }
  .home-file-reset { cursor: pointer; }
  @media (max-width: 620px) {
    .home-file-picker-options { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 390px) {
    .home-file-entry { padding: var(--space-4); }
    .home-file-actions { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-file-entry, .home-file-dropzone { transition: none; }
  }
</style>
