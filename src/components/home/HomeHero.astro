---
import UiIcon from "../icons/UiIcon.astro";
import { catalog } from "../../generated/catalog";
import { curateHomeTools413 } from "../../catalog/home-curation-413";

// These are verified local destinations from the existing editorial starter set.
const starters = curateHomeTools413(catalog).slice(0, 3);
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero-copy">
    <h1 id="home-hero-title">Trova lo strumento per il lavoro che hai davanti.</h1>
    <p>Un PDF da sistemare, un'immagine da ridurre, un dato da controllare. Cerca l'operazione e comincia subito, anche senza account.</p>
    <button class="home-hero-search" type="button" data-search-open aria-haspopup="dialog">
      <UiIcon name="search" size={20} />
      <span>Cerca uno strumento…</span>
      <span class="home-hero-search-go" aria-hidden="true"><UiIcon name="arrow-right" size={20} /></span>
    </button>
    <p class="home-hero-hint">Scrivi cosa devi fare, ad esempio «unisci PDF» o «calcola margine».</p>
  </div>

  <nav class="home-hero-tasks" aria-label="Esempi di operazioni da iniziare">
    <h2>Oppure inizia da un'attività</h2>
    <ul>
      {starters.map(({ tool, job }) => (
        <li><a href={`${tool.route}/`}><span>{job}</span><UiIcon name="arrow-right" size={18} /></a></li>
      ))}
    </ul>
    <a class="home-hero-all" href="/strumenti/">Sfoglia il catalogo completo</a>
  </nav>
</section>

<style>
  .home-hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-10);
    min-width: 0;
    padding: clamp(var(--space-6), 4vw, var(--space-12));
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .home-hero h1 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2rem, 3.7vw, 3.25rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .home-hero-copy > p:first-of-type {
    margin: var(--space-5) 0 var(--space-7);
    max-width: 56ch;
    color: var(--text-muted);
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-relaxed);
  }
  .home-hero-search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: 60px;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text-muted);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .home-hero-search:hover { border-color: var(--brand); }
  .home-hero-search > span:first-of-type { flex: 1; }
  .home-hero-search-go {
    display: grid;
    place-items: center;
    flex: 0 0 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--brand);
    color: var(--brand-ink);
  }
  .home-hero-hint { margin: var(--space-3) 0 0; color: var(--text-faint); font-size: var(--font-size-sm); }
  .home-hero-tasks { border-top: var(--border-width) solid var(--border); padding-top: var(--space-6); }
  .home-hero-tasks h2 { margin: 0 0 var(--space-3); font-size: var(--font-size-body-lg); }
  .home-hero-tasks ul { list-style: none; margin: 0; padding: 0; }
  .home-hero-tasks li + li { border-top: var(--border-width) solid var(--border); }
  .home-hero-tasks li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) 0;
    color: var(--text);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }
  .home-hero-tasks li a:hover, .home-hero-all:hover { color: var(--brand); }
  .home-hero-all { display: inline-block; margin-top: var(--space-4); color: var(--brand); font-weight: var(--font-weight-semibold); }
  @media (max-width: 390px) {
    .home-hero { padding: var(--space-5); }
    .home-hero h1 { font-size: 1.9rem; }
  }
</style>
