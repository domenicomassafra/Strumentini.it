---
import { catalog } from "../../generated/catalog";
import { contextTagsForTools } from "../../onboarding/membership";

const contextTags = contextTagsForTools(catalog);

const searchMetadata = catalog.map((tool) => ({
  id: tool.id,
  route: tool.route,
  name: tool.name,
  summary: tool.summary,
  aliases: tool.aliases,
  jobs: tool.jobs,
  category: tool.category,
  inputTypes: tool.inputTypes,
  packTags: contextTags.get(tool.id) ?? [],
  engine: tool.engine,
  runtime: tool.runtime,
}));
const searchMetadataJson = JSON.stringify(searchMetadata).replaceAll("<", "\\u003c");
---

<div class="global-search">
  <button class="search-trigger" type="button" data-search-trigger aria-haspopup="dialog">
    <span>Search tools</span>
    <kbd>⌘/Ctrl K</kbd>
  </button>

  <dialog class="search-dialog" data-search-dialog aria-labelledby="global-search-title">
    <div class="palette-shell">
      <h2 id="global-search-title" class="visually-hidden">Search tools</h2>
      <label class="search-label" for="global-search-input">Search by task, tool, input, or category</label>
      <input
        id="global-search-input"
        class="palette-input"
        type="search"
        autocomplete="off"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls="global-search-results"
        aria-activedescendant=""
        data-search-input
      />
      <div id="global-search-results" class="palette-results" role="listbox" aria-label="Tool results" data-search-results></div>
      <div class="palette-help" aria-hidden="true"><span>↑↓ navigate</span><span>Enter open</span><span>Esc close</span></div>
    </div>
  </dialog>
  <script is:inline type="application/json" id="utilityos-search-catalog" set:html={searchMetadataJson}></script>
</div>

<script>
  import { createSearch } from "../../search/search";
  import { SEARCH_CONTEXT_EVENT } from "../../search/browser-context";
  import type { SearchContext, SearchToolMetadata } from "../../search/types";

  const root = document.querySelector<HTMLElement>(".global-search");
  const trigger = root?.querySelector<HTMLButtonElement>("[data-search-trigger]");
  const dialog = root?.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const input = root?.querySelector<HTMLInputElement>("[data-search-input]");
  const results = root?.querySelector<HTMLElement>("[data-search-results]");
  const dataNode = root?.querySelector<HTMLScriptElement>("#utilityos-search-catalog");
  const tools = JSON.parse(dataNode?.textContent ?? "[]") as SearchToolMetadata[];
  const search = createSearch(tools);
  let context: SearchContext = {};
  let activeIndex = 0;
  let invoker: HTMLElement | null = null;
  let visibleRoutes: string[] = [];

  const escapeHtml = (value: string): string => value.replace(/[&<>"']/gu, (character) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    "\"": "&quot;",
    "'": "&#39;",
  })[character] ?? character);

  function render(): void {
    if (!results || !input) return;
    const result = search.query(input.value, context, 18);
    visibleRoutes = [];
    let optionIndex = 0;
    const sections = result.sections.map((section) => {
      if (section.hits.length === 0) return "";
      const rows = section.hits.map((hit) => {
        const current = optionIndex;
        optionIndex += 1;
        visibleRoutes.push(hit.route);
        return `<a id="global-search-option-${current}" class="palette-row" data-option-index="${current}" role="option" aria-selected="${current === activeIndex ? "true" : "false"}" href="${escapeHtml(hit.route)}"><span><strong>${escapeHtml(hit.name)}</strong><small>${escapeHtml(hit.summary)}</small></span><span class="row-meta">${escapeHtml(hit.category)} · ${hit.runtime.location === "LOCAL" ? "On this device" : "Network"}</span></a>`;
      }).join("");
      const groupId = `global-search-group-${section.id}`;
      return `<div class="palette-section" role="group" aria-labelledby="${groupId}"><h3 id="${groupId}">${escapeHtml(section.label)}</h3>${rows}</div>`;
    }).join("");

    if (optionIndex === 0) {
      const suggestions = result.closeIntents.map((intent) => `<button type="button" class="intent-button" data-intent="${escapeHtml(intent)}">${escapeHtml(intent)}</button>`).join("");
      results.innerHTML = `<div class="zero-results"><strong>No matching tool</strong><p>Keep “${escapeHtml(result.query)}” and try a close catalog intent.</p>${suggestions ? `<div class="intent-list">${suggestions}</div>` : ""}<a class="request-tool" href="/library/?q=${encodeURIComponent(result.query)}#request-tool">Request this tool</a></div>`;
      input.setAttribute("aria-activedescendant", "");
      activeIndex = 0;
      return;
    }

    activeIndex = Math.min(activeIndex, optionIndex - 1);
    results.innerHTML = sections;
    updateActiveOption();
  }

  function updateActiveOption(): void {
    if (!results || !input) return;
    results.querySelectorAll<HTMLElement>("[role='option']").forEach((option, index) => {
      option.setAttribute("aria-selected", String(index === activeIndex));
    });
    const active = results.querySelector<HTMLElement>(`#global-search-option-${activeIndex}`);
    input.setAttribute("aria-activedescendant", active?.id ?? "");
    active?.scrollIntoView({ block: "nearest" });
  }

  function openPalette(source: HTMLElement | null): void {
    if (!dialog || !input || dialog.open) return;
    invoker = source ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null);
    activeIndex = 0;
    dialog.showModal();
    render();
    input.focus();
  }

  function closePalette(): void {
    if (!dialog?.open) return;
    dialog.close();
    invoker?.focus();
  }

  trigger?.addEventListener("click", () => openPalette(trigger));
  window.addEventListener(SEARCH_CONTEXT_EVENT, (event) => {
    context = (event as CustomEvent<SearchContext>).detail ?? {};
    if (dialog?.open) render();
  });
  window.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase() === "k") {
      event.preventDefault();
      dialog?.open ? closePalette() : openPalette(document.activeElement instanceof HTMLElement ? document.activeElement : trigger ?? null);
    }
  });
  dialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closePalette();
  });
  input?.addEventListener("input", () => {
    activeIndex = 0;
    render();
  });
  input?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown" && visibleRoutes.length > 0) {
      event.preventDefault();
      activeIndex = (activeIndex + 1) % visibleRoutes.length;
      updateActiveOption();
    } else if (event.key === "ArrowUp" && visibleRoutes.length > 0) {
      event.preventDefault();
      activeIndex = (activeIndex - 1 + visibleRoutes.length) % visibleRoutes.length;
      updateActiveOption();
    } else if (event.key === "Enter" && visibleRoutes[activeIndex]) {
      event.preventDefault();
      window.location.assign(visibleRoutes[activeIndex] ?? "/library/");
    } else if (event.key === "Escape") {
      event.preventDefault();
      closePalette();
    }
  });
  results?.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-intent]") : null;
    if (!target || !input) return;
    input.value = target.dataset.intent ?? "";
    activeIndex = 0;
    render();
    input.focus();
  });
</script>

<style>
  .global-search { flex: 1; max-width: 640px; }
  .search-trigger { width: 100%; min-height: 40px; padding: 7px 10px 7px 12px; border: 1px solid var(--line); border-radius: 7px; background: var(--surface); color: var(--muted); display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; text-align: left; }
  .search-trigger kbd { border: 1px solid var(--line); border-radius: 4px; padding: 2px 5px; background: var(--canvas); font-size: .72rem; font-family: inherit; }
  .search-dialog { width: min(720px, calc(100vw - 32px)); max-height: 72vh; padding: 0; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); box-shadow: 0 20px 60px rgb(0 0 0 / .2); }
  .search-dialog::backdrop { background: rgb(0 0 0 / .3); }
  .palette-shell { display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; max-height: 72vh; }
  .search-label { padding: 14px 16px 5px; color: var(--muted); font-size: .76rem; font-weight: 700; }
  .palette-input { margin: 0 12px 10px; width: calc(100% - 24px); border: 1px solid var(--line); border-radius: 7px; padding: 11px 12px; background: var(--canvas); }
  .palette-results { overflow: auto; border-top: 1px solid var(--line); }
  .palette-section h3 { margin: 0; padding: 11px 14px 5px; color: var(--muted); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  .palette-row { min-height: 54px; padding: 8px 14px; display: flex; align-items: center; justify-content: space-between; gap: 18px; border-bottom: 1px solid var(--line); text-decoration: none; }
  .palette-row[aria-selected="true"] { background: var(--surface-muted); outline: 2px solid var(--action); outline-offset: -2px; }
  .palette-row strong, .palette-row small { display: block; }
  .palette-row small, .row-meta { color: var(--muted); font-size: .78rem; }
  .row-meta { white-space: nowrap; }
  .zero-results { padding: 24px 16px; }
  .zero-results p { color: var(--muted); }
  .intent-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
  .intent-button, .request-tool { border: 1px solid var(--line); border-radius: 6px; background: var(--canvas); padding: 8px 10px; color: inherit; cursor: pointer; text-decoration: none; }
  .request-tool { display: inline-flex; margin-top: 8px; }
  .palette-help { padding: 8px 14px; display: flex; gap: 14px; border-top: 1px solid var(--line); color: var(--muted); font-size: .72rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 640px) { .search-trigger { display: none; } .row-meta { display: none; } }
</style>
