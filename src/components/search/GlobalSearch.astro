---
---

<div class="global-search">
  <button class="search-trigger" type="button" data-search-trigger aria-haspopup="dialog">
    <svg class="search-trigger-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m15.8 15.8 4.2 4.2"/></svg>
    <span class="search-trigger-label">Cerca uno strumento…</span>
    <kbd class="search-trigger-keys" aria-hidden="true">⌘K</kbd>
    <span class="visually-hidden">Cerca fra tutti gli strumenti. Comandi: ⌘K o Ctrl+K</span>
  </button>

  <dialog class="search-dialog" data-search-dialog aria-labelledby="global-search-title">
    <div class="palette-shell">
      <h2 id="global-search-title" class="visually-hidden">Cerca uno strumento</h2>
      <div class="palette-field">
        <svg class="palette-field-icon" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="4.25"/><path d="M10.2 10.2 14 14"/></svg>
        <label class="visually-hidden" for="global-search-input">Cerca per attività, strumento, ingresso o categoria</label>
        <input
          id="global-search-input"
          class="palette-input"
        type="search"
        autocomplete="off"
        placeholder="Cerca per attività, strumento, ingresso o categoria"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="global-search-results"
        aria-activedescendant=""
        aria-describedby="global-search-help"
        data-search-input
      />
      </div>
      <div id="global-search-results" class="palette-results" role="listbox" aria-label="Risultati degli strumenti" data-search-results></div>
      <div id="global-search-help" class="palette-help"><span><kbd>↑</kbd><kbd>↓</kbd> naviga</span><span><kbd>Invio</kbd> apri</span><span><kbd>Esc</kbd> chiudi</span><span class="palette-help-hint"><kbd>⌘K</kbd> ovunque</span></div>
    </div>
  </dialog>
</div>

<script>
  import { createSearch } from "../../search/search";
  import { isLocalToolRoute } from "../../catalog/manifest";
  import { sanitizeSearchContext } from "../../search/browser-context";
  import { SEARCH_CONTEXT_EVENT } from "../../search/browser-context";
  import { getTelemetryAdapter, rememberToolEntrySource } from "../../telemetry/browser";
  import { classifySearchIntent, trackSearchZeroResult } from "../../telemetry/events";
  import { categoryLabelIt } from "../../i18n/it/taxonomy";
  import { toolIconSvg } from "../../ui/tool-icons";
  import type { SearchContext, SearchToolMetadata } from "../../search/types";

  const root = document.querySelector<HTMLElement>(".global-search");
  const trigger = root?.querySelector<HTMLButtonElement>("[data-search-trigger]");
  const dialog = root?.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const input = root?.querySelector<HTMLInputElement>("[data-search-input]");
  const results = root?.querySelector<HTMLElement>("[data-search-results]");
  let search: ReturnType<typeof createSearch> | undefined;
  let searchLoad: Promise<ReturnType<typeof createSearch>> | undefined;
  let context: SearchContext = {};
  let activeIndex = 0;
  let invoker: HTMLElement | null = null;
  let visibleRoutes: string[] = [];
  let visibleToolIds: string[] = [];
  let lastZeroResultKey = "";

  function loadSearch(): Promise<ReturnType<typeof createSearch>> {
    if (search !== undefined) return Promise.resolve(search);
    searchLoad ??= import("../../generated/search-catalog").then(({ searchCatalog }) => {
      search = createSearch(searchCatalog as readonly SearchToolMetadata[]);
      return search;
    });
    return searchLoad;
  }

  const escapeHtml = (value: string): string => value.replace(/[&<>"']/gu, (character) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    "\"": "&quot;",
    "'": "&#39;",
  })[character] ?? character);

  const runtimeLabel = (location: SearchToolMetadata["runtime"]["location"]): string => {
    if (location === "LOCAL") return "Su questo dispositivo";
    if (location === "REFERENCE") return "Solo riferimento";
    return "Dati di rete";
  };

  const qualityLabel = (tool: SearchToolMetadata): string => tool.quality === "verified" ? "Verificato" : "In verifica";

  function render(): void {
    if (!results || !input) return;
    if (search === undefined) {
      visibleRoutes = [];
      visibleToolIds = [];
      results.setAttribute("role", "status");
      results.setAttribute("aria-live", "polite");
      results.innerHTML = `<div class="zero-results"><strong>Caricamento strumenti</strong><p>L'indice locale della ricerca si sta preparando.</p></div>`;
      input.setAttribute("aria-activedescendant", "");
      return;
    }
    const result = search.query(input.value, context, 18);
    visibleRoutes = [];
    visibleToolIds = [];
    let optionIndex = 0;
    const sections = result.sections.map((section) => {
      if (section.hits.length === 0) return "";
      const rows = section.hits.map((hit) => {
        if (!isLocalToolRoute(hit.route)) return "";
        const current = optionIndex;
        optionIndex += 1;
        visibleRoutes.push(hit.route);
        visibleToolIds.push(hit.id);
        const name = escapeHtml(hit.name);
        const summary = escapeHtml(hit.summary);
        const category = categoryLabelIt(hit.category);
        const icon = toolIconSvg(hit, "palette-row-icon");
        const detail = `${summary} · ${escapeHtml(category)} · ${runtimeLabel(hit.runtime.location)}`;
        return `<a id="global-search-option-${current}" class="palette-row" data-option-index="${current}" role="option" tabindex="-1" aria-selected="${current === activeIndex ? "true" : "false"}" href="${escapeHtml(hit.route)}" title="${detail}">`
          + `<span class="palette-row-main"><strong title="${name}">${icon}${name}</strong><small title="${summary}">${summary}</small></span>`
          + `<span class="row-meta"><span class="row-meta-full" title="${runtimeLabel(hit.runtime.location)}">${escapeHtml(category)} · ${qualityLabel(hit)} · ${runtimeLabel(hit.runtime.location)}</span><span class="row-meta-code">${qualityLabel(hit)}</span></span></a>`;
      }).join("");
      const groupId = `global-search-group-${section.id}`;
      return `<div class="palette-section" role="group" aria-labelledby="${groupId}"><h3 id="${groupId}">${escapeHtml(section.label)}</h3>${rows}</div>`;
    }).join("");

    if (optionIndex === 0) {
      results.setAttribute("role", "region");
      results.setAttribute("aria-live", "polite");
      const intentCode = classifySearchIntent(result.query);
      if (intentCode !== lastZeroResultKey) {
        trackSearchZeroResult(getTelemetryAdapter(), intentCode);
        lastZeroResultKey = intentCode;
      }
      const suggestions = result.closeIntents.map((intent) => `<button type="button" class="intent-button" data-intent="${escapeHtml(intent)}">${escapeHtml(intent)}</button>`).join("");
      results.innerHTML = `<div class="zero-results"><strong>Nessuno strumento corrispondente</strong><p>Mantieni “${escapeHtml(result.query)}” e prova un'intenzione vicina del catalogo, oppure apri tutti gli strumenti con la stessa ricerca.</p>${suggestions ? `<div class="intent-list">${suggestions}</div>` : ""}<a class="request-tool" href="/strumenti/?q=${encodeURIComponent(result.query)}">Apri tutti gli strumenti</a></div>`;
      input.setAttribute("aria-activedescendant", "");
      activeIndex = 0;
      return;
    }

    results.setAttribute("role", "listbox");
    results.removeAttribute("aria-live");
    lastZeroResultKey = "";
    activeIndex = Math.min(activeIndex, optionIndex - 1);
    results.innerHTML = sections;
    updateActiveOption();
  }

  function updateActiveOption(): void {
    if (!results || !input) return;
    results.querySelectorAll<HTMLElement>("[role='option']").forEach((option, index) => {
      option.setAttribute("aria-selected", String(index === activeIndex));
    });
    const active = results.querySelector<HTMLElement>(`#global-search-option-${activeIndex}`);
    input.setAttribute("aria-activedescendant", active?.id ?? "");
    active?.scrollIntoView({ block: "nearest" });
  }

  async function openPalette(source: HTMLElement | null): Promise<void> {
    if (!dialog || !input || dialog.open) return;
    invoker = source ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null);
    activeIndex = 0;
    dialog.showModal();
    input.setAttribute("aria-expanded", "true");
    render();
    input.focus();
    try {
      await loadSearch();
      if (dialog.open) render();
    } catch {
      if (results) {
        results.setAttribute("role", "alert");
        results.removeAttribute("aria-live");
        results.innerHTML = `<div class="zero-results"><strong>Ricerca non disponibile</strong><p>Ricarica la pagina per riprovare con l'indice locale.</p></div>`;
      }
    }
  }

  function closePalette(): void {
    if (!dialog?.open) return;
    dialog.close();
    input?.setAttribute("aria-expanded", "false");
    invoker?.focus();
  }

  trigger?.addEventListener("click", () => void openPalette(trigger));
  // Any surface may open the palette by marking its own control: the homepage
  // hero search field, the directory's empty state, the mobile panel.
  for (const opener of document.querySelectorAll<HTMLElement>("[data-search-open]")) {
    opener.addEventListener("click", (event) => {
      event.preventDefault();
      void openPalette(opener);
    });
  }
  window.addEventListener(SEARCH_CONTEXT_EVENT, (event) => {
    context = sanitizeSearchContext((event as CustomEvent<SearchContext>).detail);
    if (dialog?.open) render();
  });
  window.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLocaleLowerCase() === "k") {
      event.preventDefault();
      dialog?.open ? closePalette() : void openPalette(document.activeElement instanceof HTMLElement ? document.activeElement : trigger ?? null);
    }
  });
  dialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closePalette();
  });
  input?.addEventListener("input", () => {
    activeIndex = 0;
    render();
  });
  input?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown" && visibleRoutes.length > 0) {
      event.preventDefault();
      activeIndex = (activeIndex + 1) % visibleRoutes.length;
      updateActiveOption();
    } else if (event.key === "ArrowUp" && visibleRoutes.length > 0) {
      event.preventDefault();
      activeIndex = (activeIndex - 1 + visibleRoutes.length) % visibleRoutes.length;
      updateActiveOption();
    } else if (event.key === "Enter" && visibleRoutes[activeIndex]) {
      event.preventDefault();
      const toolId = visibleToolIds[activeIndex];
      if (toolId !== undefined) rememberToolEntrySource(toolId, "search");
      window.location.assign(visibleRoutes[activeIndex] ?? "/strumenti/");
    } else if (event.key === "Escape") {
      event.preventDefault();
      closePalette();
    }
  });
  results?.addEventListener("click", (event) => {
    const option = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-option-index]") : null;
    const optionIndex = option?.dataset.optionIndex;
    if (optionIndex !== undefined) {
      const toolId = visibleToolIds[Number(optionIndex)];
      if (toolId !== undefined) rememberToolEntrySource(toolId, "search");
    }
    const target = event.target instanceof Element ? event.target.closest<HTMLElement>("[data-intent]") : null;
    if (!target || !input) return;
    input.value = target.dataset.intent ?? "";
    activeIndex = 0;
    render();
    input.focus();
  });
</script>

<style>
  .global-search { min-width: 0; }

  .search-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 38px;
    padding: var(--space-1) var(--space-3) var(--space-1) var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface-subtle);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    text-align: start;
    transition: border-color var(--motion-fast) var(--motion-ease), background-color var(--motion-fast) var(--motion-ease);
  }

  .search-trigger:hover { border-color: var(--brand-soft-strong); background: var(--brand-soft); color: var(--brand); }
  .search-trigger-icon { flex: 0 0 auto; }
  .search-trigger-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .search-trigger kbd {
    flex: 0 0 auto;
    margin-inline-start: var(--space-4);
    padding: 1px var(--space-2);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-xs);
    background: var(--surface);
    color: var(--text-faint);
    font-family: inherit;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* The one sanctioned overlay exception: offset plus blur, from the elevation scale. */
  .search-dialog {
    width: min(100% - (var(--container-gutter) * 2), var(--measure-tool));
    max-height: 72vh;
    padding: 0;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--elevation-2);
  }
  .search-dialog::backdrop { background: var(--overlay-backdrop); }

  .palette-shell { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; max-height: 72vh; }

  .palette-field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-4) var(--space-4) var(--space-2);
    padding: var(--space-1) var(--space-4);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface-subtle);
    color: var(--text-muted);
  }
  .palette-field:focus-within { border-color: var(--brand); background: var(--surface); }
  .palette-field-icon { flex: 0 0 auto; }
  .palette-input {
    flex: 1;
    min-width: 0;
    padding: var(--space-2) 0;
    border: 0;
    background: transparent;
  }
  .palette-input:focus { outline: none; }

  .palette-results { overflow: auto; margin-top: var(--space-2); border-top: var(--border-width) solid var(--border); }
  /* Result markup is injected at runtime, so these rules cannot be Astro-scoped. */
  :global(.palette-section h3) {
    margin: 0;
    padding: var(--space-3) var(--space-4) var(--space-1);
    color: var(--text-faint);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  :global(.palette-row) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--row-height-compact);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  :global(.palette-row:hover) { background: var(--brand-soft); }
  :global(.palette-row[aria-selected="true"]) {
    background: var(--brand-soft);
    box-shadow: inset var(--state-border-width) 0 0 0 var(--brand);
  }
  :global(.palette-row-main) { min-width: 0; display: grid; gap: var(--space-1); }
  :global(.palette-row strong) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--font-weight-semibold);
    overflow-wrap: anywhere;
  }
  :global(.palette-row-icon) { flex: 0 0 auto; color: var(--brand); }
  :global(.palette-row small) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }
  :global(.row-meta) { flex: 0 0 auto; display: flex; align-items: baseline; gap: var(--space-2); color: var(--text-faint); font-size: var(--font-size-sm); font-variant-numeric: tabular-nums lining-nums; }
  :global(.row-meta-full) { white-space: nowrap; }
  :global(.row-meta-code) { display: none; font-variant-numeric: tabular-nums lining-nums; }

  :global(.zero-results) { padding: var(--space-6) var(--space-4); }
  :global(.zero-results p) { max-width: var(--measure-copy); color: var(--text-muted); }
  :global(.intent-list) { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0; }
  :global(.intent-button), :global(.request-tool) {
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
  }
  :global(.intent-button:hover), :global(.request-tool:hover) { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
  :global(.request-tool) { display: inline-flex; margin-top: var(--space-2); }

  .palette-help {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-top: var(--border-width) solid var(--border);
    color: var(--text-faint);
    font-size: var(--font-size-xs);
  }
  .palette-help kbd {
    padding: 0 var(--space-1);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-xs);
    font-family: inherit;
    font-size: inherit;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .palette-help-hint { margin-inline-start: auto; }

  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 640px) {
    .search-trigger-label,
    .search-trigger kbd { display: none; }
    .search-trigger {
      min-width: var(--control-height-touch);
      min-height: var(--control-height-touch);
      justify-content: center;
      border-radius: var(--radius-md);
      padding: var(--space-2);
    }
    :global(.row-meta) { display: none; }
    .palette-help-hint { display: none; }
  }
</style>
