---
/**
 * The icon set — authored inline SVG on a 24×24 box.
 *
 * Every glyph is drawn with `currentColor` strokes so it inherits the colour of
 * whatever it sits inside: an icon tile, a pill, a button, a nav row. Icons are
 * `aria-hidden` by default because the interface always pairs them with a
 * visible label; pass `title` only where the icon stands alone.
 *
 * The value of each entry is the raw inner markup, so a glyph may be a single
 * path, a path plus a circle, or a group.
 */
export type IconName =
  | "search"
  | "sun"
  | "moon"
  | "menu"
  | "close"
  | "chevron-down"
  | "grid"
  | "arrow-right"
  | "arrow-up"
  | "arrow-down"
  | "check"
  | "check-circle"
  | "alert"
  | "info"
  | "lock"
  | "shield"
  | "zap"
  | "devices"
  | "infinity"
  | "upload"
  | "download"
  | "trash"
  | "plus"
  | "heart"
  | "clock"
  | "user"
  | "sliders"
  | "logout"
  | "eye"
  | "eye-off"
  | "grip"
  | "star"
  | "sparkle"
  | "external"
  | "copy"
  | "refresh"
  | "wallet";

interface Props {
  name: IconName;
  size?: number;
  title?: string;
  class?: string;
}

const { name, size = 20, title, class: className } = Astro.props;

const icons: Record<IconName, string> = {
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m15.8 15.8 4.2 4.2"/>',
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.4M12 19v2.4M2.6 12h2.4M19 12h2.4M5.4 5.4l1.7 1.7M16.9 16.9l1.7 1.7M18.6 5.4l-1.7 1.7M7.1 16.9l-1.7 1.7"/>',
  moon: '<path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.5 8.5 0 1 0 10.2 10.2Z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>',
  "chevron-down": '<path d="m6.5 9.5 5.5 5.5 5.5-5.5"/>',
  grid: '<rect x="3.75" y="3.75" width="7" height="7" rx="1.8"/><rect x="13.25" y="3.75" width="7" height="7" rx="1.8"/><rect x="3.75" y="13.25" width="7" height="7" rx="1.8"/><rect x="13.25" y="13.25" width="7" height="7" rx="1.8"/>',
  "arrow-right": '<path d="M4.5 12h15M13.5 6l6 6-6 6"/>',
  "arrow-up": '<path d="M12 19.5v-15M6 10.5 12 4.5l6 6"/>',
  "arrow-down": '<path d="M12 4.5v15M6 13.5l6 6 6-6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7"/>',
  "check-circle": '<circle cx="12" cy="12" r="8.5"/><path d="m8 12.3 2.8 2.8L16 9.9"/>',
  alert: '<path d="M12 4.6 3.4 19h17.2z"/><path d="M12 10v4.2M12 16.8v.2"/>',
  info: '<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5M12 7.8v.2"/>',
  lock: '<rect x="4.75" y="10.5" width="14.5" height="9.75" rx="2.5"/><path d="M8.25 10.5V7.9a3.75 3.75 0 0 1 7.5 0v2.6"/>',
  shield: '<path d="M12 3.5 5 6v6c0 4.2 3 7.2 7 9 4-1.8 7-4.8 7-9V6z"/><path d="m9.2 12.2 2 2 3.6-3.8"/>',
  zap: '<path d="M13.2 3 5.5 13.4h5L10 21l7.7-10.4h-5z"/>',
  devices: '<rect x="2.75" y="5.5" width="12.5" height="9" rx="2"/><path d="M6.5 18.5h5.5M8.75 14.5v4"/><rect x="16.75" y="8.5" width="4.5" height="10" rx="1.6"/>',
  infinity: '<path d="M8.6 15.4c-2 0-3.6-1.5-3.6-3.4s1.6-3.4 3.6-3.4c2.6 0 4.2 6.8 6.8 6.8 2 0 3.6-1.5 3.6-3.4s-1.6-3.4-3.6-3.4c-2.6 0-4.2 6.8-6.8 6.8z"/>',
  upload: '<path d="M12 15.5V4.5M8 8.5l4-4 4 4"/><path d="M4.5 14.5v3a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-3"/>',
