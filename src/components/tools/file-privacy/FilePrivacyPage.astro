---
import BaseLayout from "../../../layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  methodTitle: string;
  methodItems: string[];
}

const { title, description, methodTitle, methodItems } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="tool-page">
    <header class="tool-heading">
      <nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Files &amp; privacy</nav>
      <p class="eyebrow">Files &amp; privacy</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="trust-strip" role="note">
        <strong>Runs on this device.</strong>
        <span>Selected files and text stay in this browser operation; no upload or remote fallback is used.</span>
      </div>
    </header>
    <slot />
    <section class="method-card" aria-labelledby="file-privacy-method-title">
      <p class="eyebrow">Local method</p>
      <h2 id="file-privacy-method-title">{methodTitle}</h2>
      <ul>{methodItems.map((item) => <li>{item}</li>)}</ul>
    </section>
  </article>
</BaseLayout>
