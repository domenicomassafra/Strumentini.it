---
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import TelemetryBootstrap from "../telemetry/TelemetryBootstrap.astro";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const normalizedPath = pathname === "/" ? "/" : pathname.replace(/\/+$/u, "") || "/";
---

<a class="shell-skip-link" href="#main-content">Vai al contenuto</a>
<SiteHeader pathname={normalizedPath} />
<main id="main-content" class="shell-main">
  <slot />
</main>
<SiteFooter>
  <TelemetryBootstrap slot="legal" />
</SiteFooter>

<style>
  .shell-skip-link {
    position: absolute;
    left: var(--space-4);
    top: -60px;
    z-index: 60;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--brand);
    color: var(--brand-ink);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    transition: top var(--motion-fast) var(--motion-ease);
  }

  .shell-skip-link:focus { top: var(--space-4); color: var(--brand-ink); }

  .shell-main { display: block; }
</style>
