---
import GlobalSearch from "../search/GlobalSearch.astro";
import BrandMark from "./BrandMark.astro";
import ShellIcon, { type ShellIconName } from "./ShellIcon.astro";

interface Props {
  pathname: string;
  search?: string;
}

const { pathname, search = "" } = Astro.props;
const normalizedPath = pathname === "/" ? "/" : pathname.replace(/\/+$/u, "") || "/";
const isLibrary = normalizedPath === "/library";
const isOnboarding = normalizedPath === "/onboarding";
const isSearchDestination = isLibrary && new URLSearchParams(search).get("focus") === "search";
const isWorkbench = !isLibrary && !isOnboarding;

/**
 * One declaration table, rendered twice: the desktop rail and the mobile bar.
 * Adding a destination is a single edit here, which is what makes `/onboarding`
 * and `/#recent` reachable on every viewport instead of being desktop-only.
 */
interface NavDestination {
  readonly id: string;
  readonly label: string;
  readonly short: string;
  readonly href: string;
  readonly icon: ShellIconName;
  readonly current: boolean;
}

const destinations: readonly NavDestination[] = [
  { id: "workbench", label: "Your Tools", short: "Tools", href: "/", icon: "tools", current: isWorkbench },
  { id: "recent", label: "Recent", short: "Recent", href: "/#recent", icon: "recent", current: false },
  { id: "library", label: "Library", short: "Library", href: "/library/", icon: "library", current: isLibrary && !isSearchDestination },
  { id: "search", label: "Search", short: "Search", href: "/library/?focus=search", icon: "search", current: isSearchDestination },
  { id: "onboarding", label: "Set up tools", short: "Set up", href: "/onboarding/", icon: "onboarding", current: isOnboarding },
  { id: "profile", label: "Work Profile", short: "Profile", href: "/#work-profile", icon: "profile", current: false },
];

const railGroups: readonly { readonly label: string; readonly ids: readonly string[]; readonly bottom?: boolean }[] = [
  { label: "Your work", ids: ["workbench", "recent"] },
  { label: "Discover", ids: ["library", "search"] },
  { label: "Workspace", ids: ["onboarding", "profile"], bottom: true },
];

/**
 * The mobile bar is the four highest-traffic destinations plus the ledger's own
 * Recent section, named explicitly. A positional slice is what silently stranded
 * Work Profile: every destination must be in this list or in
 * `headerDestinationIds` below, or it does not exist on mobile. Together the two
 * lists are exhaustive, and the guard below fails the build if they ever are not.
 */
const primaryBarIds: readonly string[] = ["workbench", "recent", "library", "search"];

/**
 * The rail's Workspace group — the set-once destinations the ledger makes you
 * configure once. They promote to the mobile header because the rail has no
 * mobile counterpart, not because they are top-level: Work Profile is a section
 * of the Workbench, sitting beside Recent, and gets no fifth bar slot.
 */
const headerDestinationIds: readonly string[] = ["onboarding", "profile"];

const resolveAll = (ids: readonly string[]): readonly NavDestination[] =>
  ids
    .map((id) => destinations.find((entry) => entry.id === id))
    .filter((entry): entry is NavDestination => entry !== undefined);

const primaryBar = resolveAll(primaryBarIds);
const headerDestinations = resolveAll(headerDestinationIds);

const stranded = destinations.filter(
  (entry) => !primaryBarIds.includes(entry.id) && !headerDestinationIds.includes(entry.id),
);
if (stranded.length > 0) {
  throw new Error(`shell: destination(s) unreachable on mobile: ${stranded.map((entry) => entry.id).join(", ")}`);
}
---

<a class="shell-skip-link" href="#main-content">Skip to content</a>
<div
  class="app-shell"
  data-shell-root
  data-shell-path={normalizedPath}
  style={`--shell-bar-slots: ${primaryBar.length};`}
>
  <aside class="shell-rail" aria-label="Application shell">
    <a class="shell-brand" href="/" aria-label="StrumentiUtili.it">
      <BrandMark />
      <span class="shell-brand-word">StrumentiUtili.it</span>
    </a>
    <nav class="shell-rail-nav" aria-label="Primary" data-shell-nav="desktop">
      {railGroups.map((group) => (
        <div class:list={["shell-nav-group", group.bottom === true && "shell-nav-group-bottom"]}>
          <p class="shell-nav-label">{group.label}</p>
          {group.ids.map((id) => {
            const destination = destinations.find((entry) => entry.id === id);
            if (destination === undefined) return null;
            return (
              <a
                href={destination.href}
                data-shell-destination={destination.id}
                data-shell-nav-item
                aria-current={destination.current ? "page" : undefined}
              >
                <ShellIcon name={destination.icon} size={18} />
                <span>{destination.label}</span>
              </a>
            );
          })}
        </div>
      ))}
    </nav>
    <p class="shell-local-note">Local-first · no account required</p>
  </aside>

  <div class="shell-body">
    <header class="shell-header">
      <a class="shell-header-brand" href="/" aria-label="StrumentiUtili.it">
        <BrandMark size={24} />
        <span class="shell-brand-word">StrumentiUtili.it</span>
      </a>
      <div class="shell-header-search">
        <GlobalSearch />
      </div>
      <div class="shell-header-setup">
        {headerDestinations.map((destination) => (
          <a
            href={destination.href}
            data-shell-destination={destination.id}
            data-shell-nav-item
            aria-current={destination.current ? "page" : undefined}
          >
            <ShellIcon name={destination.icon} size={18} />
            <span>{destination.short}</span>
          </a>
        ))}
      </div>
    </header>
    <main id="main-content" class="shell-main" tabindex="-1">
      <slot />
    </main>
  </div>

  <nav class="shell-mobile-nav" aria-label="Primary" data-shell-nav="mobile" data-shell-mobile-nav>
    {primaryBar.map((destination) => (
      <a
        href={destination.href}
        data-shell-destination={destination.id}
        data-shell-nav-item
        aria-current={destination.current ? "page" : undefined}
      >
        <ShellIcon name={destination.icon} size={20} />
        <span>{destination.short}</span>
      </a>
    ))}
  </nav>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-shell-root]");
  if (root) {
    const normalizePath = () => window.location.pathname.replace(/\/+$/u, "") || "/";
    const update = () => {
      const path = normalizePath();
      const hash = window.location.hash;
      const searchDestination = path === "/library" && new URLSearchParams(window.location.search).get("focus") === "search";
      const activeDestination = path === "/library"
        ? searchDestination ? "search" : "library"
        : path === "/onboarding"
          ? "onboarding"
          : hash === "#work-profile"
          ? "profile"
          : hash === "#recent"
            ? "recent"
            : "workbench";
      root.dataset.shellPath = path;
      root.querySelectorAll<HTMLElement>("[data-shell-destination]").forEach((link) => {
        const active = link.dataset.shellDestination === activeDestination;
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
        link.toggleAttribute("data-active", active);
      });
    };
    window.addEventListener("hashchange", update);
    window.addEventListener("popstate", update);
    update();
  }
</script>

<style>
  /* W1's token sheet has no rail token yet. Consumer fallback only; the token
     request is reported so the sheet can absorb it and this becomes var(--rail-width). */
  .app-shell {
    --shell-rail-width: var(--rail-width, 15rem);
    --shell-rail-pad: var(--space-5);
    --shell-nav-ink: var(--inchiostro, #1a1714);
    --shell-nav-ink-muted: var(--inchiostro-3, #7a7367);
    --shell-nav-rule: color-mix(in srgb, var(--inchiostro-3, #7a7367) 34%, transparent);
    --shell-nav-surface: var(--carta-alta, #fbf9f4);
    --shell-nav-surface-active: var(--carta, #f4f1ea);
    --shell-nav-marker: 2px;

    min-height: 100vh;
    display: grid;
    grid-template-columns: var(--shell-rail-width) minmax(0, 1fr);
    background: var(--canvas);
    color: var(--ink);
  }

  .shell-skip-link {
    position: fixed;
    z-index: 100;
    top: var(--space-2);
    left: var(--space-2);
    min-height: var(--control-height-touch);
    padding: 0 var(--space-4);
    display: inline-flex;
    align-items: center;
    border: var(--border-width) solid var(--border-strong, var(--line));
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .shell-skip-link:focus-visible {
    transform: translateY(0);
  }

  .shell-rail {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    padding: var(--space-5) var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    border-right: var(--border-width) solid var(--shell-nav-rule);
    background: var(--surface-subtle);
  }

  .shell-brand,
  .shell-header-brand {
    min-height: var(--control-height-touch);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--shell-nav-ink);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .shell-brand {
    padding-inline: var(--space-2);
  }

  .shell-rail-nav {
    display: grid;
    gap: var(--space-5);
  }

  .shell-nav-group {
    display: grid;
    gap: var(--space-0);
  }

  .shell-nav-group-bottom {
    margin-top: auto;
  }

  .shell-nav-label {
    margin: 0;
    padding: 0 var(--space-2) var(--space-2);
    color: var(--shell-nav-ink-muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .shell-rail-nav a {
    min-height: var(--control-height-touch);
    padding: var(--space-2) var(--space-2);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--shell-nav-ink);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .shell-rail-nav a:hover {
    background: var(--shell-nav-surface);
  }

  .shell-rail-nav a[aria-current="page"] {
    background: var(--shell-nav-surface-active);
    box-shadow: inset var(--shell-nav-marker) 0 0 var(--rossa, #9e2b1f);
  }

  .shell-local-note {
    margin: 0;
    padding: var(--space-3) var(--space-2) 0;
    border-top: var(--border-width) solid var(--shell-nav-rule);
    color: var(--shell-nav-ink-muted);
    font-size: var(--font-size-xs);
  }

  .shell-body {
    min-width: 0;
  }

  .shell-header {
    position: sticky;
    z-index: 10;
    top: 0;
    min-height: var(--nav-height);
    padding: var(--space-2) var(--container-gutter);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    border-bottom: var(--border-width) solid var(--shell-nav-rule);
    background: var(--canvas);
  }

  .shell-header-brand {
    display: none;
  }

  .shell-header-search {
    min-width: 0;
    flex: 1 1 auto;
    max-width: var(--measure-tool);
  }

  .shell-header-setup {
    margin-left: auto;
    display: none;
    align-items: center;
    gap: var(--space-1);
  }

  .shell-header-setup a {
    min-height: var(--control-height-touch);
    padding: 0 var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: var(--border-width) solid var(--shell-nav-rule);
    border-radius: var(--radius-sm);
    color: var(--shell-nav-ink);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .shell-header-setup a:hover {
    background: var(--shell-nav-surface);
  }

  .shell-header-setup a[aria-current="page"] {
    background: var(--shell-nav-surface);
  }

  .shell-main {
    min-width: 0;
    padding-bottom: var(--space-16);
  }

  .shell-main:focus-visible {
    outline-offset: calc(-1 * var(--focus-width));
  }

  /* Anchor targets scroll under the sticky header. `#recent` / `#work-profile`
     are the shell's published in-page destinations; ID selectors, not class
     coupling — a renamed section class can never break the shell again. */
  .shell-main :global(#work-profile),
  .shell-main :global(#recent) {
    scroll-margin-top: calc(var(--nav-height) + var(--space-4));
  }

  .shell-mobile-nav {
    display: none;
  }

  @media (max-width: 900px) {
    .app-shell {
      display: block;
    }

    .shell-rail {
      display: none;
    }

    .shell-header {
      padding-inline: var(--space-4);
      gap: var(--space-3);
    }

    .shell-header-brand {
      display: inline-flex;
      flex: 0 0 auto;
    }

    .shell-header-search {
      display: none;
    }

    /* The rail has no mobile counterpart, so its Workspace group promotes to the
       header — the same declarations, never a second copy of the string. */
    .shell-header-setup {
      display: inline-flex;
    }

    .shell-main {
      padding-bottom: calc(var(--nav-height) + var(--space-16));
    }

    .shell-mobile-nav {
      position: fixed;
      z-index: 30;
      inset: auto 0 0;
      min-height: calc(var(--control-height-touch) + var(--space-4));
      padding: var(--space-1) var(--space-2) max(var(--space-1), env(safe-area-inset-bottom));
      display: grid;
      grid-template-columns: repeat(var(--shell-bar-slots), minmax(0, 1fr));
      align-items: stretch;
      border-top: var(--border-width) solid var(--shell-nav-rule);
      background: var(--surface);
    }

    .shell-mobile-nav a {
      min-width: 0;
      min-height: var(--control-height-touch);
      padding: var(--space-1) var(--space-1);
      display: grid;
      place-items: center;
      align-content: center;
      gap: var(--space-half);
      border-radius: var(--radius-sm);
      color: var(--shell-nav-ink-muted);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
      line-height: 1.1;
      text-align: center;
      text-decoration: none;
    }

    .shell-mobile-nav a[aria-current="page"] {
      color: var(--shell-nav-ink);
      box-shadow: inset 0 var(--shell-nav-marker) 0 var(--rossa, #9e2b1f);
    }
  }

  @media (max-width: 420px) {
    .shell-header {
      padding-inline: var(--space-3);
    }

    /* At the narrowest width the setup group sheds its shorter label and keeps
       its icon at 44px rather than squeezing two labelled buttons. The remaining
       label carries the accessible name, so the pair is never ambiguous. */
    .shell-header-setup a[data-shell-destination="onboarding"] span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shell-skip-link {
      transition: none;
    }
  }
</style>
