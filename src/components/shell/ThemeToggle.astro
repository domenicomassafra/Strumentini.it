---
/**
 * The light/dark switch. One button, two states, one stored choice; the icon
 * shown is the ground you would get, not the one you are on.
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Passa al tema scuro"
  title="Cambia tema"
>
  <svg class="theme-toggle-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.5 8.5 0 1 0 10.2 10.2Z" />
  </svg>
  <svg class="theme-toggle-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.6v2.4M12 19v2.4M2.6 12h2.4M19 12h2.4M5.4 5.4l1.7 1.7M16.9 16.9l1.7 1.7M18.6 5.4l-1.7 1.7M7.1 16.9l-1.7 1.7" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-muted);
    transition: background-color var(--motion-fast) var(--motion-ease),
                color var(--motion-fast) var(--motion-ease);
  }

  .theme-toggle:hover { background: var(--brand-soft); color: var(--brand); }

  .theme-toggle svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-toggle-sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle-sun { display: block; }
  :global(:root[data-theme="dark"]) .theme-toggle-moon { display: none; }
</style>

<script>
  import { resolveTheme, THEME_STORAGE_KEY } from "./theme";

  const root = document.documentElement;
  const system = window.matchMedia("(prefers-color-scheme: dark)");

  /** Reflects a resolved ground without writing the stored choice. */
  function paint(theme: "light" | "dark"): void {
    root.dataset.theme = theme;
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]:not([media])');
    const value = theme === "dark" ? root.dataset.themeColorDark : root.dataset.themeColorLight;
    if (meta !== null && value !== undefined) meta.content = value;
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      button.setAttribute("aria-label", theme === "dark" ? "Passa al tema chiaro" : "Passa al tema scuro");
    }
  }

  function store(choice: string): void {
    try {
      localStorage.setItem(THEME_STORAGE_KEY, choice);
    } catch {
      /* Storage unavailable: the choice holds for this page only. */
    }
  }

  function storedChoice(): string | null {
    try {
      return localStorage.getItem(THEME_STORAGE_KEY);
    } catch {
      return null;
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      store(next);
      paint(next);
    });
  }

  system.addEventListener("change", (event) => {
    // Only an explicit "system" choice follows the operating system.
    if (storedChoice() === "system") paint(event.matches ? "dark" : "light");
  });

  paint(resolveTheme(storedChoice(), system.matches));
</script>
