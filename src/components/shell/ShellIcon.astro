---
/**
 * Shell icon set — authored inline SVG.
 *
 * Every path here is drawn in a 24×24 box with `currentColor` strokes, so an icon
 * inherits the ink of whatever it sits inside and never carries its own colour.
 * `aria-hidden` is the default because the shell always pairs an icon with a
 * visible text label; pass a `title` only when the icon stands alone.
 */
export type ShellIconName =
  | "tools"
  | "recent"
  | "library"
  | "search"
  | "profile"
  | "onboarding"
  | "mark";

interface Props {
  name: ShellIconName;
  size?: number;
  title?: string;
}

const { name, size = 20, title } = Astro.props;

const paths: Record<ShellIconName, string> = {
  // Ledger: two ruled rows and the fixed value column the product promises.
  tools: "M4 5.5h6.5M4 12h6.5M4 18.5h6.5M14 5.5h6M14 12h6M14 18.5h6",
  // Recent: a clock face with a single hand back over the ruled baseline.
  recent: "M12 4.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15ZM12 8.5V12l2.5 2",
  // Library: the bound spine and the ruled leaves.
  library: "M5 4.5h14v15H5zM9 4.5v15M12 9h4M12 12.5h4M12 16h4",
  // Search: a lens over the page.
  search: "M11 4.5a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13ZM15.8 15.8 20 20",
  // Profile: the person who owns the ledger.
  profile: "M12 4.75a3.25 3.25 0 1 1 0 6.5 3.25 3.25 0 0 1 0-6.5ZM5.5 19.5c.9-3.4 3.4-5 6.5-5s5.6 1.6 6.5 5",
  // Onboarding: the first ruled page being filled in.
  onboarding: "M6 3.5h8.5L18 7v13.5H6zM14 3.5V7h4M9 11h6M9 14.5h6M9 17.5h3.5",
  // Brand mark: a gutter rule with a red pen stroke committing a value.
  mark: "M4 3.5h11.5v17H4zM15.5 3.5H20v17h-4.5M7.5 8h5M7.5 12h5M7.5 16h3",
};
---

<svg
  class="shell-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title === undefined ? "presentation" : "img"}
  aria-hidden={title === undefined ? "true" : undefined}
  focusable="false"
>
  {title !== undefined && <title>{title}</title>}
  <path d={paths[name]} />
</svg>

<style>
  .shell-icon {
    flex: 0 0 auto;
    display: block;
  }
</style>
