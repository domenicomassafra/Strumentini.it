---
/**
 * The brand mark: an isometric box, three faces, one blue.
 *
 * Authored inline so every face reads from the token sheet and the mark follows
 * the theme instead of shipping a raster logo. The white seam between faces is
 * the surface colour, so the box keeps its edges on either ground.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
---

<svg
  class:list={["brand-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <polygon class="brand-mark-top" points="16 2.5 29 10 16 17.5 3 10" />
  <polygon class="brand-mark-left" points="3 10 16 17.5 16 30.5 3 23" />
  <polygon class="brand-mark-right" points="16 17.5 29 10 29 23 16 30.5" />
</svg>

<style>
  .brand-mark { flex: 0 0 auto; display: block; }
  .brand-mark polygon { stroke: var(--surface); stroke-width: 1.6; stroke-linejoin: round; }
  .brand-mark-top { fill: var(--brand); }
  .brand-mark-left { fill: color-mix(in srgb, var(--brand) 62%, var(--surface)); }
  .brand-mark-right { fill: var(--brand-hover); }
</style>
