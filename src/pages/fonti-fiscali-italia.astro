---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getItalySourcePackDecision } from "../reference-data/italy/source-packs";
import { VERIFIED_IRPEF_EXCERPTS_117 as irpef, VERIFIED_FORFETTARIO_COEFFICIENTS_2025_117 as coeff, INVOICE_STAMP_REFERENCE_2024_117 as bollo } from "../reference-data/italy/fiscal-annual-117";
import { diffFiscalBands409 } from "../reference-data/italy/fiscal-revisions-409";
import { buildAnnualFiscalSourceReview117 } from "../reference-data/italy/annual-source-registry-117";
import { todayItaly158 } from "../reference-data/italy/freshness-158";
const pack = getItalySourcePackDecision(117);
const irpefDiff = diffFiscalBands409(irpef[0]!, irpef[1]!);
const annualReview = buildAnnualFiscalSourceReview117(todayItaly158());
const shortHash = (value: string) => `${value.slice(0, 23)}…`;
const yearRows = [...annualReview.rows].sort((a, b) => b.taxYear - a.taxYear || a.datasetId.localeCompare(b.datasetId));
---
<BaseLayout title="Fonti fiscali ufficiali italiane per anno" description="Consulta fonti e intervalli di validità verificati per IRPEF, forfettario e bollo con riferimenti normativi e limiti aggiornati.">
  <main class="sources-fiscal">
    <p><a href="/strumenti/">← Strumenti</a> · <a href="/codici-geografici-italia/">Comuni e Stati esteri</a></p>
    <h1>Fonti fiscali ufficiali per anno</h1>
    <p>Archivi con intervalli, aliquote e riferimenti verificabili. Il pacchetto completo annuale IVA–IRPEF–forfettario richiede ancora fonti di dettaglio: ogni tabella sotto dichiara esattamente quale sottoinsieme è documentato.</p>
    <p>Revisione delle fonti: <strong>{pack.checkedAt}</strong> · Identificativo: <code>{pack.decisionVersion}</code> · Aggiornamenti quando cambiano la norma o l'anno fiscale.</p>
    <section aria-label="Registro ufficiale delle fonti annuali" data-annual-sources117>
      <h2>Registro ufficiale delle fonti per anno</h2>
      <p>Gli agenti mantengono il registro usando solo fonti ufficiali: Agenzia delle Entrate, Ministero dell'Economia e delle Finanze, Gazzetta Ufficiale e Normattiva come pubblicazione ufficiale della legge. Ogni riga riporta anno, versione identificabile, data di verifica, intervallo di vigenza, collegamento e impronta SHA-256 dello snapshot conservato.</p>
      <div class="fiscal-scroll409" role="region" aria-label="Tabella fonti annuali scorrevole" tabindex="0"><table><thead><tr><th>Anno</th><th>Dati</th><th>Versione</th><th>Autorità ufficiale</th><th>Verificato il</th><th>Vigenza</th><th>Fonte</th><th>SHA-256</th></tr></thead><tbody>
        {yearRows.map(entry => <tr data-annual-source117={`${entry.datasetId}:${entry.taxYear}:${entry.version}`}>
          <td>{entry.taxYear}</td><td>{entry.label}</td><td><code>{entry.version}</code></td><td>{entry.authority}</td>
          <td>{entry.checkedAt}</td><td>{entry.effectiveFrom} / {entry.effectiveTo}</td>
          <td><a href={entry.url} target="_blank" rel="noopener noreferrer">Documento ufficiale</a></td>
          <td><code>{shortHash(entry.sha256)}</code></td></tr>)}
      </tbody></table></div>
      <p data-annual-review117>Revisione annuale automatica al 1º gennaio: anno corrente <strong>{annualReview.currentYear}</strong>, prossimo controllo <strong>{annualReview.nextAnnualReviewAt}</strong>. Dataset con valori dell'anno corrente verificati: {annualReview.currentYearCovered.length > 0 ? annualReview.currentYearCovered.join(", ") : "nessuno"}. {annualReview.blockedClaims.length > 0 ? `Senza snapshot ufficiale dell'anno corrente: ${annualReview.blockedClaims.join(", ")} — restano non determinati e non ereditano altri anni.` : "Nessun dataset con claim anno corrente è privo di snapshot ufficiale."} Il controllo automatico blocca i calcoli con claim anno corrente e apre una richiesta di revisione, senza inventare aliquote.</p>
    </section>
    <section aria-label="Registro versioni fiscali" data-fiscal-versions409>
      <h2>Registro delle versioni IRPEF nazionali</h2>
      <p>Ogni calcolo identifica la propria versione delle regole; una rettifica con efficacia retroattiva deve aggiungere una versione distinta e richiedere una selezione esplicita, mantenendo accessibile il risultato basato sulla versione precedente.</p>
      <div class="fiscal-scroll409" role="region" aria-label="Tabella versioni fiscali scorrevole" tabindex="0"><table><thead><tr><th>Anno</th><th>Versione</th><th>Vigenza</th><th>Verifica snapshot</th><th>Responsabile revisione fiscale</th></tr></thead><tbody>
        {irpef.map(entry => <tr data-fiscal-version409={entry.revisionId}><td>{entry.taxYear}</td><td><code>{entry.revisionId}</code></td>
          <td>{entry.effectiveFrom} / {entry.effectiveTo}</td><td>{entry.checkedAt}</td>
          <td>{entry.reviewOwner ?? "Da nominare — approvazione fiscale non attestata"}</td></tr>)}
      </tbody></table></div>
      <p data-fiscal-diff409>Confronto 2025 → 2026: {irpefDiff.changedBands.map(change => `fino a ${change.upToCents === null ? "oltre l'ultima soglia" : `${(change.upToCents / 100).toLocaleString("it-IT")} €`}: ${(change.previousBasisPoints ?? 0) / 100}% → ${(change.nextBasisPoints ?? 0) / 100}%`).join("; ")}. La legge 199/2025 modifica la seconda aliquota con decorrenza 2026; non è una rettifica retroattiva del 2025.</p>
      <p data-fiscal-amendments409>Rettifiche retroattive verificate e registrate: nessuna. L'eventuale revisione successiva richiede fonte ufficiale, data di efficacia, nuova versione e validazione del responsabile; il pacchetto fiscale annuale completo rimane bloccato.</p>
    </section>
    {irpef.map(year => <section class="fiscal-year">
      <h2>Anno fiscale {year.taxYear} — IRPEF nazionale lorda</h2>
      <p>Versione <code>{year.revisionId}</code>. Validità {year.effectiveFrom} / {year.effectiveTo}. Solo scaglioni nazionali lordi; detrazioni e addizionali richiedono verifiche separate.</p>
      <table><thead><tr><th>Reddito imponibile fino a</th><th>Aliquota</th></tr></thead><tbody>
        {year.bands.map(band => <tr><td>{band.upToCents === null ? "Oltre lo scaglione precedente" : new Intl.NumberFormat("it-IT",{style:"currency",currency:"EUR"}).format(band.upToCents/100)}</td><td>{(band.rateBasisPoints/100).toLocaleString("it-IT")}%</td></tr>)}
      </tbody></table>
      <p>Documenti: {year.sources.map((source, i) => <span>{i > 0 ? " · " : ""}<a href={source.url} target="_blank" rel="noopener noreferrer">{source.authority}, copia identificata da SHA-256</a></span>)}</p>
    </section>)}
    <section class="fiscal-year"><h2>Anno fiscale 2025 — coefficienti forfettario ATECO 2007</h2>
      <p>Validità {coeff.effectiveFrom} / {coeff.effectiveTo}. Nove righe ufficiali; l'ammissibilità al regime, i contributi e il passaggio ad ATECO 2025 richiedono verifiche separate.</p>
      <table><thead><tr><th>Settore nella tabella ufficiale</th><th>Coefficiente</th></tr></thead><tbody>{coeff.rows.map(row => <tr><td>{row.sectorLabel}</td><td>{row.coefficientPercent}%</td></tr>)}</tbody></table>
      <p>{coeff.sources.map((source, i) => <span>{i > 0 ? " · " : ""}<a href={source.url} target="_blank" rel="noopener noreferrer">{source.authority}{source.pageNumber ? `, pagina ${source.pageNumber}` : ""}</a></span>)}</p>
    </section>
    <section class="fiscal-year"><h2>Anno 2024 — riferimento bollo fatture</h2>
      <p>Guida archiviata e limitata all'anno indicato. <a href={bollo.source.url} target="_blank" rel="noopener noreferrer">Agenzia delle Entrate, documento originale</a>.</p>
    </section>
    <h2>Fonti candidate ancora da completare</h2>
    <p>Per aliquote IVA applicabili alle singole operazioni e per un modello annuale completo del forfettario, il catalogo mantiene i riferimenti con stato di copertura insufficiente.</p>
    <ul>{pack.candidateOfficialSources?.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.authority} — {source.title}</a>: {source.limitation}</li>)}</ul>
    <p>Nessun anno non supportato eredita automaticamente aliquote o coefficienti da un altro anno.</p>
  </main>
</BaseLayout>
<style>
  .sources-fiscal{max-width:1000px;margin:0 auto;padding:30px 22px 80px}.sources-fiscal p{line-height:1.65}.sources-fiscal .fiscal-year{border:1px solid var(--border);border-radius:14px;padding:18px;margin:24px 0}.sources-fiscal table{width:100%;border-collapse:collapse}.sources-fiscal th,.sources-fiscal td{text-align:left;padding:9px;border-bottom:1px solid var(--border)}.fiscal-scroll409{max-width:100%;overflow-x:auto}.fiscal-scroll409 table{min-width:680px}
</style>
