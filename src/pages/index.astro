---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeFileEntry from "../components/home/HomeFileEntry.astro";
import { catalog } from "../generated/catalog";
import TrustRow from "../components/home/TrustRow.astro";
import CategoryGrid from "../components/home/CategoryGrid.astro";
import StarterTools from "../components/home/StarterTools.astro";
import RecentTools from "../components/home/RecentTools.astro";
import ClosingBanner from "../components/home/ClosingBanner.astro";
---

<BaseLayout
  title="Strumenti online gratuiti, nel tuo browser"
  description={catalog.length + " strumenti online gratuiti per PDF, immagini, CSV, testo e business. Molte operazioni sono locali nel browser; verifica i dettagli su ogni strumento."}
  imageAlt="Strumentini: strumenti online semplici e gratuiti"
>
  <HomeHero />
  <div class="home-body">
    <HomeFileEntry />
    <TrustRow />
    <CategoryGrid />
    <RecentTools />
    <StarterTools />
    <ClosingBanner />
  </div>
</BaseLayout>

<style>
  .home-body {
    width: min(calc(100% - (var(--container-gutter) * 2)), var(--container-max));
    margin: 0 auto;
    padding-bottom: var(--space-16);
  }
</style>
