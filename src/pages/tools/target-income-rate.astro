---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TargetIncomeRateTool } from "../../components/tools/business-math/TargetIncomeRateTool";
import { targetIncomeRateConfig } from "../../components/tools/business-math/configs";
import "../../components/tools/tool-surface.css";
---
<BaseLayout title={targetIncomeRateConfig.title} description={targetIncomeRateConfig.lede}>
  <article class="tool-page">
    <header class="tool-heading">
      <nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Business math</nav>
      <p class="eyebrow">Business math</p>
      <h1>{targetIncomeRateConfig.title}</h1>
      <p class="lede">{targetIncomeRateConfig.lede}</p>
      <div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>No income data is uploaded.</span></div>
    </header>
    <TargetIncomeRateTool client:load />
    <section class="method-card" aria-labelledby="target-rate-method">
      <p class="eyebrow">Rules &amp; assumptions</p>
      <h2 id="target-rate-method">Billable rate and all-hours rate</h2>
      <ul><li>Required hourly rate = (target income + expenses) ÷ billable hours.</li><li>Non-billable hours are shown separately and included in the all-hours comparison.</li></ul>
    </section>
  </article>
</BaseLayout>
