---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ImageDimensionsBatchInspectorTool } from "../../components/tools/image-visual/ImageDimensionsBatchInspectorTool";
import "../../components/tools/tool-surface.css";
---
<BaseLayout title="Image Dimensions Batch Inspector" description="Inspect several local image headers and report dimensions, MIME signatures, and bounded size guidance.">
  <article class="tool-page">
    <header class="tool-heading">
      <nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Image &amp; visual</nav>
      <p class="eyebrow">Image &amp; visual</p>
      <h1>Image Dimensions Batch Inspector</h1>
      <p class="lede">Inspect several local image headers and report dimensions, MIME signatures, and bounded size guidance.</p>
      <div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>Your input stays in this browser tab.</span></div>
    </header>
    <ImageDimensionsBatchInspectorTool client:load />
    <section class="method-card"><p class="eyebrow">Bounded contract</p><h2>Header inspection</h2><ul><li>Reads bounded local image headers and reports dimensions, signatures, and size guidance.</li><li>Reports each selected file separately, including unsupported headers.</li><li>Does not upload or fully decode files just to inspect headers.</li></ul></section>
  </article>
</BaseLayout>
