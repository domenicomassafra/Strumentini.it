---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TrackingCleanerTool } from "../../components/tools/TrackingCleanerTool";
---
<BaseLayout title="Tracking Parameter Cleaner" description="Remove known tracking parameters locally while preserving unrelated URL semantics."><article class="tool-page"><header class="tool-heading"><nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Marketing</nav><p class="eyebrow">Marketing</p><h1>Tracking Parameter Cleaner</h1><p class="lede">Remove known UTM and click identifiers while preserving unrelated repeated parameters and fragments.</p><div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>Your URL is not uploaded.</span></div></header><TrackingCleanerTool client:load /><section class="method-card"><h2>Keep / drop policy</h2><ul><li>Drops keys beginning with <code>utm_</code> plus known click identifiers such as gclid, fbclid and msclkid, matched case-insensitively.</li><li>Keeps unrelated parameters in their original order, including repeated keys and blank values.</li><li>Keeps the URL fragment. Running the cleaner twice produces the same result.</li></ul></section></article></BaseLayout>
