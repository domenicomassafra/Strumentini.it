---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Base64CodecTool } from "../../components/tools/Base64CodecTool";
import "../../components/tools/tool-surface.css";
const title = "Base64 Encode & Decode";
---
<BaseLayout title={title} description="Encode and strictly decode UTF-8 Base64 locally.">
  <article class="tool-page">
    <header class="tool-heading"><nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Developer</nav><p class="eyebrow">Developer</p><h1>{title}</h1><p class="lede">Encode and strictly decode UTF-8 Base64 locally.</p><div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>Text never leaves this page.</span></div></header>
    <Base64CodecTool client:load />
    <section class="method-card"><p class="eyebrow">Method</p><h2>RFC 4648 with strict text decoding</h2><p>Standard and URL-safe alphabets are supported. Padding, alphabet, and UTF-8 failures are reported as typed local errors.</p></section>
  </article>
</BaseLayout>
