---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ContrastCheckerTool } from "../../components/tools/image-visual/ContrastCheckerTool";
---
<BaseLayout title="Contrast Checker" description="Contrast Checker runs locally in your browser with bounded inputs and explicit results.">
  <article class="tool-page">
    <header class="tool-heading">
      <nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Image &amp; visual</nav>
      <p class="eyebrow">Image &amp; visual</p>
      <h1>Contrast Checker</h1>
      <p class="lede">A bounded local operation with no upload, remote fallback, or hidden persistence.</p>
      <div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>Your input stays in this browser tab.</span></div>
    </header>
    <ContrastCheckerTool client:load />
    <section class="method-card"><p class="eyebrow">Bounded contract</p><h2>Local, explicit, verifiable</h2><ul><li>Input is read locally and is never sent to a network service.</li><li>Size, dimension, pixel, and file-count limits fail closed before expensive work.</li><li>Result fields show the actual computed values and any warnings.</li></ul></section>
  </article>
</BaseLayout>
