---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { UnixTimestampTool } from "../../components/tools/UnixTimestampTool";
import "../../components/tools/tool-surface.css";
const title = "Unix Timestamp Converter";
---
<BaseLayout title={title} description="Convert Unix seconds or milliseconds to UTC date-time locally.">
  <article class="tool-page">
    <header class="tool-heading"><nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Developer</nav><p class="eyebrow">Developer</p><h1>{title}</h1><p class="lede">Convert Unix seconds or milliseconds to UTC date-time locally.</p><div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>UTC output avoids implicit local timezone assumptions.</span></div></header>
    <UnixTimestampTool client:load />
    <section class="method-card"><p class="eyebrow">Method</p><h2>Unix seconds and milliseconds</h2><p>Numeric timestamps and parseable date strings are supported. The selected unit is explicit and the result is always an ISO UTC string.</p></section>
  </article>
</BaseLayout>
