---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MetaPreviewTool } from "../../components/tools/MetaPreviewTool";
---
<BaseLayout title="Meta Title / Description Preview" description="Measure and safely escape SEO title and description metadata locally.">
  <article class="tool-page">
    <header class="tool-heading"><nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Marketing</nav><p class="eyebrow">Marketing</p><h1>Meta Title / Description Preview</h1><p class="lede">Measure metadata lengths and inspect escaped text without rendering active content.</p><div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>Metadata is not uploaded.</span></div></header>
    <MetaPreviewTool client:load />
    <section class="method-card"><h2>Preview policy</h2><ul><li>Default review limits are 60 title characters and 160 description characters.</li><li>Output escapes HTML-sensitive characters instead of executing supplied markup.</li><li>Whitespace is trimmed for the measured preview, while the original input is not mutated.</li></ul></section>
  </article>
</BaseLayout>
