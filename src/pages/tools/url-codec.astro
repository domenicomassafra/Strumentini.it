---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { UrlCodecTool } from "../../components/tools/UrlCodecTool";
const title = "URL Encode & Decode";
---
<BaseLayout title={title} description="Percent-encode and decode text with explicit URL rules.">
  <article class="tool-page">
    <header class="tool-heading"><nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Developer</nav><p class="eyebrow">Developer</p><h1>{title}</h1><p class="lede">Percent-encode and decode text with explicit URL rules.</p><div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>No URL is fetched or opened.</span></div></header>
    <UrlCodecTool client:load />
    <section class="method-card"><p class="eyebrow">Method</p><h2>WHATWG percent sets</h2><p>Choose the component, query, path, or userinfo encode set. Decoding preserves malformed percent sequences and reports invalid UTF-8 instead of silently replacing it.</p></section>
  </article>
  <style is:global>.developer-result-json { max-height: 34rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; font-family: var(--font-family-mono); }</style>
</BaseLayout>
