---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TfrCalculator15 } from "../../components/tools/TfrCalculator15";
---

<BaseLayout title="Calcola TFR lordo e rivalutazione" description="Simula il TFR accantonato per ogni anno e la rivalutazione FOI, distinguendo quote e rivalutazioni con fonti e limiti chiari.">
  <main class="tfr-page">
    <p><a href="/strumenti/">← Tutti gli strumenti</a></p>
    <h1>Calcola TFR lordo e rivalutazione</h1>
    <p>Inserisci le retribuzioni utili per ciascun anno e la variazione annuale dell'indice FOI. Il risultato è locale al browser e usa i valori che hai indicato.</p>
    <TfrCalculator15 client:load />
  </main>
</BaseLayout>

<style>
  .tfr-page { max-width: 1000px; padding: 30px 22px 84px; margin: auto; }
  .tfr-page :global(.tfr15) { display: grid; gap: 22px; }
  .tfr-page :global(form), .tfr-page :global(.tfr-result) { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px; display: grid; gap: 18px; }
  .tfr-page :global(form label) { display: grid; gap: 8px; font-weight: 600; }
  .tfr-page :global(textarea), .tfr-page :global(input) { display: block; width: 100%; max-width: 100%; padding: 10px; box-sizing: border-box; background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 8px; }
  .tfr-page :global(form p) { margin: 0; color: var(--text-muted); }
  .tfr-page :global(.tfr-error) { color: var(--danger); }
  .tfr-page :global(.tfr-result dl) { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; }
  .tfr-page :global(.tfr-result dt) { color: var(--text-muted); }
  .tfr-page :global(.tfr-result dd) { margin: 5px 0 0; font-weight: 700; }
  .tfr-page :global(.tfr-table-scroll) { overflow-x: auto; }
  .tfr-page :global(table) { width: 100%; border-collapse: collapse; white-space: nowrap; }
  .tfr-page :global(th), .tfr-page :global(td) { padding: 10px; text-align: left; border-bottom: 1px solid var(--border); }
</style>
