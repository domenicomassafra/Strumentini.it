<FilePrivacyPage title="Secret / Token Pattern Scanner" description="Scan selected text-like files for common API key, token, and private-key patterns." methodTitle="Redacted local pattern scan" methodItems={["Only bounded text-like files and pasted text are scanned.", "Findings show file, line, kind, and a redacted preview rather than the complete secret.", "Heuristic matches require human review; a clean result is not a guarantee."]}>
  <SecretTokenPatternScannerTool client:load />
