---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PaletteExtractorTool } from "../../components/tools/image-visual/PaletteExtractorTool";
---
<BaseLayout title="Palette Extractor" description="Extract a bounded local color palette from decoded image pixels using deterministic quantization.">
  <article class="tool-page">
    <header class="tool-heading">
      <nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Image &amp; visual</nav>
      <p class="eyebrow">Image &amp; visual</p>
      <h1>Palette Extractor</h1>
      <p class="lede">Extract a bounded local color palette from decoded image pixels using deterministic quantization.</p>
      <div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>Your input stays in this browser tab.</span></div>
    </header>
    <PaletteExtractorTool client:load />
    <section class="method-card"><p class="eyebrow">Bounded contract</p><h2>Palette policy</h2><ul><li>Extracts a bounded local palette from decoded image pixels with deterministic quantization.</li><li>Enforces the requested color count and image limits.</li><li>Does not identify brand colors or query a remote service.</li></ul></section>
  </article>
</BaseLayout>
