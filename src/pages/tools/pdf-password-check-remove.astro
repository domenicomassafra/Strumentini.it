---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PdfPasswordCheckRemoveTool } from "../../components/tools/PdfPasswordCheckRemoveTool";
---
<BaseLayout title="PDF Password Check / Remove" description="Check PDF encryption markers without bypassing passwords."><article class="tool-page"><header class="tool-heading"><nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Documents</nav><p class="eyebrow">Documents</p><h1>PDF Password Check / Remove</h1><p class="lede">Check whether a PDF declares encryption and create a safe copy only when no bypass is needed.</p><div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>No brute force, decryption bypass, or remote verification.</span></div></header><PdfPasswordCheckRemoveTool client:load /><section class="method-card"><h2>Safety contract</h2><ul><li>Encrypted documents are reported and left untouched.</li><li>The remove mode never claims to defeat encryption.</li><li>Unencrypted copies are rebuilt and verified locally.</li></ul></section></article></BaseLayout>
