---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { JsonYamlConverterTool } from "../../components/tools/JsonYamlConverterTool";
const title = "JSON ↔ YAML Converter";
---
<BaseLayout title={title} description="Convert JSON and a safe YAML subset locally.">
  <article class="tool-page">
    <header class="tool-heading"><nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Developer</nav><p class="eyebrow">Developer</p><h1>{title}</h1><p class="lede">Convert JSON and a safe YAML subset locally.</p><div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>Both source and result remain local.</span></div></header>
    <JsonYamlConverterTool client:load />
    <section class="method-card"><p class="eyebrow">Method</p><h2>Explicit direction</h2><p>JSON uses strict parsing; YAML uses the bounded safe parser exposed by the YAML formatter. The conversion never instantiates tags or application objects.</p></section>
  </article>
  <style is:global>.developer-result-json { max-height: 34rem; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; font-family: var(--font-family-mono); }</style>
</BaseLayout>
