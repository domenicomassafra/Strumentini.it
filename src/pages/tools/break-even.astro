---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BreakEvenTool } from "../../components/tools/business-math/BreakEvenTool";
import { breakEvenConfig } from "../../components/tools/business-math/configs";
---
<BaseLayout title={breakEvenConfig.title} description={breakEvenConfig.lede}>
  <article class="tool-page">
    <header class="tool-heading">
      <nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Business math</nav>
      <p class="eyebrow">Business math</p>
      <h1>{breakEvenConfig.title}</h1>
      <p class="lede">{breakEvenConfig.lede}</p>
      <div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>No pricing data is fetched.</span></div>
    </header>
    <BreakEvenTool client:load />
    <section class="method-card" aria-labelledby="break-even-method">
      <p class="eyebrow">Rules &amp; assumptions</p>
      <h2 id="break-even-method">Contribution pays fixed costs</h2>
      <ul><li>Contribution per unit = unit price − variable cost per unit.</li><li>Break-even units round up to the next whole unit.</li></ul>
    </section>
  </article>
</BaseLayout>
