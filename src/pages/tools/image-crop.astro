---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ImageCropTool } from "../../components/tools/image-visual/ImageCropTool";
import "../../components/tools/tool-surface.css";
---
<BaseLayout title="Image Crop" description="Crop a local image to a bounded top-left rectangle with browser-local output.">
  <article class="tool-page">
    <header class="tool-heading">
      <nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Image &amp; visual</nav>
      <p class="eyebrow">Image &amp; visual</p>
      <h1>Image Crop</h1>
      <p class="lede">Crop a local image to a bounded top-left rectangle with browser-local output.</p>
      <div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>Your input stays in this browser tab.</span></div>
    </header>
    <ImageCropTool client:load />
    <section class="method-card"><p class="eyebrow">Bounded contract</p><h2>Crop policy</h2><ul><li>Crops a local image from the top-left corner using the entered width and height.</li><li>Checks supported formats and bounded dimensions before processing.</li><li>The source image is not modified.</li></ul></section>
  </article>
</BaseLayout>
