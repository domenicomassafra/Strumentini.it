---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PercentageHelperTool } from "../../components/tools/business-math/PercentageHelperTool";
import { percentageHelperConfig } from "../../components/tools/business-math/configs";
import "../../components/tools/tool-surface.css";
---
<BaseLayout title={percentageHelperConfig.title} description={percentageHelperConfig.lede}>
  <article class="tool-page">
    <header class="tool-heading">
      <nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Business math</nav>
      <p class="eyebrow">Business math</p>
      <h1>{percentageHelperConfig.title}</h1>
      <p class="lede">{percentageHelperConfig.lede}</p>
      <div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>No jurisdiction or tax rate is inferred.</span></div>
    </header>
    <PercentageHelperTool client:load />
    <section class="method-card" aria-labelledby="percentage-method">
      <p class="eyebrow">Rules &amp; assumptions</p>
      <h2 id="percentage-method">Choose the direction explicitly</h2>
      <ul><li>Add mode calculates base + base × rate.</li><li>Reverse mode calculates net = inclusive total ÷ (1 + rate).</li></ul>
    </section>
  </article>
</BaseLayout>
