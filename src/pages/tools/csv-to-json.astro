---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CsvToJsonTool } from "../../components/tools/csv-to-json/CsvToJsonTool";
import "../../components/tools/tool-surface.css";
---
<BaseLayout title="CSV to JSON" description="Convert bounded CSV records to JSON locally.">
  <article class="tool-page">
    <header class="tool-heading">
      <nav aria-label="Breadcrumb"><a href="/">Workbench</a> / Data</nav>
      <p class="eyebrow">Data tables</p>
      <h1>CSV to JSON</h1>
      <p class="lede">Convert rows to JSON records with a visible duplicate-header and missing-cell policy.</p>
      <div class="trust-strip" role="note"><strong>Runs on this device.</strong><span>JSON is generated in memory from the supplied CSV.</span></div>
    </header>
    <CsvToJsonTool client:load />
    <section class="method-card"><h2>Conversion contract</h2><ul><li>Unique-header mode gives repeated and blank headers deterministic names.</li><li>Missing cells become empty strings rather than guessed values.</li><li>Quoted delimiters and newlines are decoded by the CSV parser first.</li></ul></section>
  </article>
</BaseLayout>
