---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Onboarding } from "../components/onboarding/Onboarding";
import { catalog } from "../generated/catalog";
import { qualityIndex } from "../generated/quality";
---

<BaseLayout
  title="Prepara il tuo set di strumenti"
  description="Costruisci un piccolo set iniziale, locale e modificabile, a partire dal tuo contesto di lavoro e dalle attività che si ripetono."
>
  <noscript>
    <p class="warning" role="note">
      Per completare i quattro passaggi del primo utilizzo e salvare gli strumenti, abilita JavaScript nel browser.
    </p>
  </noscript>
  <Onboarding tools={catalog} quality={qualityIndex} client:load />
</BaseLayout>
