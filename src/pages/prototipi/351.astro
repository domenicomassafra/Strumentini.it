---
import "../../styles/global.css";
import JobCanvas from "../../components/prototipi/351/JobCanvas.astro";

const directions = [
  { id: "minimal", label: "01 / Minimal", subtitle: "Rigore e concentrazione" },
  { id: "editorial", label: "02 / Editoriale", subtitle: "Una storia per ogni lavoro" },
  { id: "workspace", label: "03 / Workspace", subtitle: "Pannelli e continuità" },
] as const;
const operations = [
  { id: "pdf", number: "01", label: "Unisci PDF", note: "Metti in ordine" },
  { id: "csv", number: "02", label: "Pulisci CSV", note: "Rendi i dati leggibili" },
  { id: "utm", number: "03", label: "Esporta UTM", note: "Prepara una campagna" },
] as const;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>Studio 351 · Tre direzioni · Strumentini</title>
    <meta name="description" content="Studio isolato: tre percorsi alternativi per PDF, CSV e UTM, con elaborazione locale." />
  </head>
  <body>
    <main class="prototype351">
      <header class="study-header">
        <div class="study-brand"><span class="brand-symbol" aria-hidden="true">S<span>·</span></span><span>STRUMENTINI <small>LAB / 351</small></span></div>
        <p>Tre proposte di prodotto · accesso sperimentale · nessuna scelta approvata</p>
        <nav class="direction-switch" aria-label="Direzione del prototipo">
          {directions.map((direction, index) => (
            <button type="button" data-switch={direction.id} aria-pressed={index === 0}>
              <span>{direction.label}</span><small>{direction.subtitle}</small>
            </button>
          ))}
        </nav>
      </header>

      <section class="direction minimal" data-direction="minimal" aria-label="Prototipo minimal e rigoroso">
        <div class="minimal-hero">
          <div class="minimal-overline">STUDIO / 01 — INTERFACCIA ESSENZIALE</div>
          <h1>Fare bene.<br /><em>Una cosa alla volta.</em></h1>
          <p>Tre strumenti. Pochi passaggi. Le azioni sono in primo piano, il risultato è sempre leggibile.</p>
          <span class="minimal-rule">01 — 03 / OPERAZIONI LOCALI</span>
        </div>
        <div class="minimal-grid">
          <nav class="minimal-nav" aria-label="Operazioni minimal">
            <span class="nav-caption">SELEZIONA UN'AZIONE</span>
            {operations.map((job, index) => (
              <button type="button" data-select-job={job.id} aria-pressed={index === 0}>
                <span class="number">{job.number}</span><strong>{job.label}</strong><span aria-hidden="true">↗</span>
              </button>
            ))}
            <div class="mini-note"><strong>Controllo, non complessità.</strong><br />Account facoltativo. Nessun file salvato da questo studio.</div>
          </nav>
          <div class="minimal-work"><JobCanvas variant="minimal" /></div>
        </div>
      </section>

      <section class="direction editorial" data-direction="editorial" aria-label="Prototipo editoriale e riconoscibile" hidden>
        <header class="editorial-masthead">
          <div class="edition-top"><strong>STRUMENTINI / IL QUADERNO</strong><span>NUMERO 351 — EDIZIONE SPERIMENTALE</span><span>2026 / ITALIA</span></div>
          <p class="editorial-kicker">LE COSE FATTE CON CURA</p>
          <h1>Il lavoro quotidiano<br /><i>merita strumenti migliori.</i></h1>
          <div class="editorial-deck"><span>UNO STUDIO DI INTERFACCIA, NON UN TEMPLATE</span><p>Documenti che si incontrano, dati che diventano chiari, link pronti da condividere. Scegli una storia e completa il lavoro.</p></div>
        </header>
        <div class="editorial-columns">
          <nav class="editorial-contents" aria-label="Indice dei lavori editoriali">
            <h2>In questo numero <span>↘</span></h2>
            {operations.map((job, index) => (
              <button type="button" data-select-job={job.id} aria-pressed={index === 0}>
                <small>CAPITOLO {job.number}</small><strong>{job.label}</strong><span>{job.note} →</span>
              </button>
            ))}
            <p class="editorial-aside">Ogni capitolo conserva i propri risultati finché non lo azzeri. I file restano nel browser.</p>
          </nav>
          <article class="editorial-work">
            <p class="editorial-article-label">BANCO DI LAVORO / ESTRAIBILE</p>
            <JobCanvas variant="editorial" />
          </article>
        </div>
        <footer class="editorial-footer"><span>Una buona interfaccia aiuta a finire.</span><span>NESSUN ACCOUNT RICHIESTO · NESSUN UPLOAD</span></footer>
      </section>

      <section class="direction workspace" data-direction="workspace" aria-label="Prototipo task e workspace" hidden>
        <header class="workspace-toolbar">
          <div class="workspace-name"><span class="workspace-icon" aria-hidden="true">▦</span><div><small>SPAZIO DI LAVORO / DEMO</small><strong>La tua scrivania</strong></div></div>
          <div class="workspace-info"><span class="online-indicator" aria-hidden="true"></span> Modalità locale <span class="workspace-date">SESSIONE TEMPORANEA</span></div>
        </header>
        <div class="workspace-body">
          <nav class="workspace-rail" aria-label="Attività del workspace">
            <div class="rail-title">ATTIVITÀ <span>3</span></div>
            {operations.map((job, index) => (
              <button type="button" data-select-job={job.id} aria-pressed={index === 0}>
                <span class="rail-index">{job.number}</span><span class="rail-label"><strong>{job.label}</strong><small>{job.note}</small></span><span aria-hidden="true">›</span>
              </button>
            ))}
            <div class="rail-note"><strong>Archivio</strong><p>Le lavorazioni non vengono salvate. Scarica esplicitamente ciò che ti serve.</p></div>
          </nav>
          <div class="workspace-main">
            <div class="workspace-breadcrumb">SCRIVANIA <span>/</span> OPERAZIONE ATTIVA <span class="workspace-private">● PRIVATO</span></div>
            <header class="workspace-heading"><div><small>FILE → AZIONE → RISULTATO</small><h1>Il tuo prossimo passo.</h1><p>Gestisci input e output nello stesso spazio. Cambia attività senza perdere il risultato precedente.</p></div><div class="session-marker">SESSIONE 001<br /><strong>PRONTA</strong></div></header>
            <JobCanvas variant="workspace" />
          </div>
        </div>
      </section>

      <section class="study-rubric" aria-labelledby="rubric-title">
        <div><small>COME CONFRONTARLE / #351</small><h2 id="rubric-title">Tre idee di navigazione, un'unica prova.</h2><p>La direzione visiva resta da scegliere nel ticket #352. Questo laboratorio non compare nel catalogo né sostituisce gli strumenti pubblici.</p></div>
        <div class="rubric-scroll"><table>
          <thead><tr><th scope="col">Criterio</th><th scope="col">Minimal</th><th scope="col">Editoriale</th><th scope="col">Workspace</th></tr></thead>
          <tbody>
            <tr><th scope="row">Ingresso</th><td>Un'azione immediata</td><td>Indice per racconto</td><td>Scrivania per attività</td></tr>
            <tr><th scope="row">Orientamento</th><td>Tre numeri progressivi</td><td>Tre capitoli descrittivi</td><td>Barra attività persistente</td></tr>
            <tr><th scope="row">Risultato</th><td>Accanto alla forma</td><td>Alla fine del capitolo</td><td>Nel pannello di lavoro</td></tr>
            <tr><th scope="row">Tastiera</th><td>Tab + pulsanti nativi</td><td>Indice + Tab</td><td>Rail + Tab</td></tr>
            <tr><th scope="row">Mobile</th><td>Colonna singola</td><td>Indice a schede</td><td>Rail compatto</td></tr>
          </tbody>
        </table></div>
      </section>
    </main>
    <script>
      import { mergePdfs, inspectPdfBytes } from "../../engines/pdf";
      import { readBlobText, cleanCsvText, CSV_HARD_FILE_BYTES } from "../../engines/table/csv";
      import { buildUtmUrl } from "../../engines/campaign-url";

      type Job = "pdf" | "csv" | "utm";
      type RecordState = { active: AbortController | null; downloadUrl: string | null; sequence: number };
      const states = new WeakMap<HTMLElement, RecordState>();
      const directions = [...document.querySelectorAll<HTMLElement>("[data-direction]")];
      const selectButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-switch]")];

      for (const switchButton of selectButtons) {
        switchButton.addEventListener("click", () => {
          const selected = switchButton.dataset.switch;
          for (const button of selectButtons) button.setAttribute("aria-pressed", String(button === switchButton));
          for (const section of directions) section.hidden = section.dataset.direction !== selected;
          const heading = directions.find((section) => section.dataset.direction === selected)?.querySelector<HTMLElement>("h1");
          if (heading) { heading.tabIndex = -1; heading.focus({ preventScroll: true }); }
        });
      }

      function displayError(error: unknown): string {
        const message = error instanceof Error ? error.message : String(error);
        if (/CANCEL|abort/iu.test(message)) return "Operazione annullata. Il risultato precedente rimane disponibile.";
        if (/PDF_LIMIT|limit|size|too many/iu.test(message)) return "Il file supera i limiti locali di questa operazione. Riduci dimensione o numero di file.";
        if (/PDF|unsupported|MALFORMED|INVALID_PDF/iu.test(message)) return "PDF non supportato o non valido. Controlla i documenti e riprova.";
        if (/CSV|PARSE|SEMANTIC|FILE_TOO_LARGE/iu.test(message)) return "CSV non valido o troppo grande. Controlla le righe e riprova.";
        return "Dati non validi. Per UTM usa un URL HTTP(S) e compila sorgente, mezzo e campagna.";
      }

      function revoke(state: RecordState): void {
        if (state.downloadUrl !== null) URL.revokeObjectURL(state.downloadUrl);
        state.downloadUrl = null;
      }

      for (const direction of directions) {
        const choiceButtons = [...direction.querySelectorAll<HTMLButtonElement>("[data-select-job]")];
        for (const choice of choiceButtons) {
          choice.addEventListener("click", () => {
            const job = choice.dataset.selectJob;
            for (const button of choiceButtons) button.setAttribute("aria-pressed", String(button === choice));
            for (const panel of direction.querySelectorAll<HTMLElement>("[data-job]")) panel.hidden = panel.dataset.job !== job;
            const heading = direction.querySelector<HTMLElement>(`[data-job="${job}"] h3`);
            if (heading) { heading.tabIndex = -1; heading.focus({ preventScroll: true }); }
          });
        }
        for (const panel of direction.querySelectorAll<HTMLElement>("[data-job]")) {
          const state: RecordState = { active: null, downloadUrl: null, sequence: 0 };
          states.set(panel, state);
          const form = panel.querySelector<HTMLFormElement>("[data-form]")!;
          const runButton = panel.querySelector<HTMLButtonElement>("[data-run]")!;
          const cancelButton = panel.querySelector<HTMLButtonElement>("[data-cancel]")!;
          const resetButton = panel.querySelector<HTMLButtonElement>("[data-reset]")!;
          const progressWrap = panel.querySelector<HTMLElement>("[data-progress-wrap]")!;
          const progress = panel.querySelector<HTMLProgressElement>("[data-progress]")!;
          const status = panel.querySelector<HTMLElement>("[data-status]")!;
          const error = panel.querySelector<HTMLElement>("[data-error]")!;
          const output = panel.querySelector<HTMLElement>("[data-result]")!;
          const empty = panel.querySelector<HTMLElement>("[data-empty]")!;
          const preview = panel.querySelector<HTMLElement>("[data-preview]")!;
          const bytes = panel.querySelector<HTMLElement>("[data-bytes]")!;
          const download = panel.querySelector<HTMLAnchorElement>("[data-download]")!;
          const field = (name: string) => form.querySelector<HTMLInputElement>(`[name="${name}"]`)!;

          cancelButton.addEventListener("click", () => state.active?.abort());
          resetButton.addEventListener("click", () => {
            state.sequence += 1;
            state.active?.abort();
            state.active = null;
            revoke(state);
            form.reset();
            runButton.disabled = false;
            cancelButton.hidden = true;
            progressWrap.hidden = true;
            error.hidden = true;
            error.textContent = "";
            preview.textContent = "";
            output.hidden = true;
            download.hidden = true;
            download.removeAttribute("href");
            empty.hidden = false;
            status.textContent = "Pronto per un nuovo lavoro.";
          });

          runButton.addEventListener("click", () => { void (async () => {
            if (state.active !== null) return;
            const controller = new AbortController();
            const seq = ++state.sequence;
            state.active = controller;
            error.hidden = true;
            error.textContent = "";
            status.textContent = "Elaborazione locale in corso…";
            runButton.disabled = true;
            cancelButton.hidden = false;
            progressWrap.hidden = false;
            progress.value = 5;
            try {
              // A paint boundary makes progress and cancellation accessible for
              // short synchronous operations without introducing external jobs.
              await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
              if (controller.signal.aborted) throw new DOMException("cancelled", "AbortError");
              let blob: Blob;
              let filename: string;
              let summary: string;
              let resultText: string;
              const job = panel.dataset.job as Job;
              if (job === "pdf") {
                const files = [...(field("pdfFiles").files ?? [])];
                if (files.length < 2) throw new Error("INVALID_PDF: Seleziona almeno due PDF.");
                progress.value = 25;
                const artifact = await mergePdfs(files, controller.signal);
                const verified = inspectPdfBytes(artifact.bytes);
                if (verified.pageCount !== artifact.pageCount) throw new Error("PDF_VERIFICATION_FAILED");
                blob = new Blob([Uint8Array.from(artifact.bytes)], { type: "application/pdf" });
                filename = "unione-351.pdf";
                summary = `${verified.pageCount} pagine unite · PDF verificato localmente`;
                resultText = `${verified.pageCount} pagine · ${files.length} documenti\n${files.map((file) => file.name).join(" → ")}`;
              } else if (job === "csv") {
                const file = field("csvFile").files?.[0];
                if (!file) throw new Error("INVALID_CSV: Seleziona un CSV.");
                if (file.size > CSV_HARD_FILE_BYTES) throw new Error("FILE_TOO_LARGE");
                const source = await readBlobText(file, controller.signal, (fraction) => { progress.value = Math.max(5, fraction * 85); });
                const cleaned = cleanCsvText(source);
                blob = new Blob([cleaned.output], { type: "text/csv;charset=utf-8" });
                filename = file.name.replace(/\.csv$/iu, "") + ".clean.csv";
                summary = `${Math.max(0, cleaned.rows - 1)} righe dati · ${cleaned.columns} colonne pulite`;
                resultText = cleaned.output.slice(0, 1500);
              } else {
                const url = buildUtmUrl(field("baseUrl").value, {
                  source: field("source").value, medium: field("medium").value, campaign: field("campaign").value,
                });
                blob = new Blob([url], { type: "text/plain;charset=utf-8" });
                filename = "campagna-utm-351.txt";
                summary = "URL UTM generato · parametri mantenuti";
                resultText = url;
              }
              if (controller.signal.aborted || state.sequence !== seq) return;
              const objectUrl = URL.createObjectURL(blob);
              revoke(state);
              state.downloadUrl = objectUrl;
              download.href = objectUrl;
              download.download = filename;
              download.hidden = false;
              preview.textContent = resultText;
              bytes.textContent = `${blob.size.toLocaleString("it-IT")} byte · ${filename}`;
              progress.value = 100;
              output.hidden = false;
              empty.hidden = true;
              status.textContent = summary;
            } catch (reason) {
              if (state.sequence !== seq) return;
              error.textContent = displayError(reason);
              error.hidden = false;
              status.textContent = controller.signal.aborted ? "Annullato" : "Verifica i dati e riprova";
            } finally {
              if (state.active === controller) {
                state.active = null;
                runButton.disabled = false;
                cancelButton.hidden = true;
                progressWrap.hidden = true;
              }
            }
          })(); });
        }
      }
      window.addEventListener("pagehide", () => {
        for (const section of directions) for (const panel of section.querySelectorAll<HTMLElement>("[data-job]")) {
          const state = states.get(panel);
          state?.active?.abort();
          if (state) revoke(state);
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--canvas); color: var(--text); font-family: Inter, "Helvetica Neue", Arial, sans-serif; }
  .prototype351 :is(h1,h2,h3,h4) { color: inherit; }
  .prototype351 { width: 100%; overflow-x: clip; }
  .prototype351 [hidden] { display: none !important; }
  .prototype351 button, .prototype351 input, .prototype351 a { font: inherit; }
  .prototype351 button { cursor: pointer; }
  .prototype351 button:disabled { opacity: .45; cursor: wait; }
  .prototype351 :is(button,input,a):focus-visible { outline: 3px solid var(--warning); outline-offset: 3px; }
  .study-header { display: flex; align-items: center; flex-wrap: wrap; gap: 1.2rem; padding: 14px clamp(15px, 3vw, 48px); background: var(--text); color: var(--surface); }
  .study-brand { display: flex; align-items: center; gap: 12px; letter-spacing: .11em; font-weight: 800; font-size: .8rem; }
  .study-brand small { display: block; opacity: .65; font-size: .65rem; font-weight: 500; margin-top: 3px; }
  .brand-symbol { display: grid; place-items: center; width: 41px; height: 41px; border-radius: 50%; background: var(--success-soft); color: var(--text); font-size: 1.5rem; letter-spacing: -.1em; }
  .brand-symbol span { color: var(--warning); }
  .study-header > p { color: var(--surface); font-size: .73rem; margin: 0 auto; max-width: 270px; }
  .direction-switch { display: flex; flex-wrap: wrap; gap: 3px; padding: 3px; background: color-mix(in srgb, var(--text) 90%, var(--surface)); border-radius: 10px; }
  .direction-switch button { text-align: left; border: 0; background: transparent; color: var(--surface); padding: 10px 14px; border-radius: 8px; }
  .direction-switch button span { display: block; font-size: .79rem; font-weight: 750; }
  .direction-switch button small { display: block; font-size: .64rem; margin-top: 3px; }
  .direction-switch button[aria-pressed="true"] { background: var(--canvas); color: var(--text); }
  .direction { min-height: 80vh; }
  .minimal { background: var(--canvas); padding: clamp(28px, 5vw, 86px) clamp(15px, 5.8vw, 100px) 90px; color: var(--text); }
  .minimal-hero { max-width: 900px; margin-bottom: clamp(36px, 5vw, 90px); }
  .minimal-overline, .minimal-rule, .nav-caption { font-size: .69rem; letter-spacing: .19em; font-weight: 750; }
  .minimal-overline { color: var(--text-muted); margin-bottom: 34px; }
  .minimal h1 { font-size: clamp(3.25rem, 8.2vw, 8.8rem); line-height: .97; letter-spacing: -.082em; font-weight: 650; margin: 0 0 27px; }
  .minimal h1 em { font-style: normal; color: var(--text-muted); }
  .minimal-hero p { font-size: clamp(1rem, 1.7vw, 1.25rem); max-width: 560px; line-height: 1.65; color: var(--text-muted); }
  .minimal-rule { display: inline-block; margin-top: 20px; border-top: 2px solid var(--text); padding-top: 14px; }
  .minimal-grid { display: grid; grid-template-columns: minmax(210px, .65fr) minmax(0, 1.9fr); gap: clamp(25px, 5vw, 92px); }
  .minimal-nav { border-top: 1px solid var(--border-strong); padding-top: 15px; }
  .nav-caption { display: block; color: var(--text-muted); margin: 0 0 22px; }
  .minimal-nav button { display: flex; width: 100%; align-items: center; gap: 15px; padding: 24px 0; text-align: left; background: none; border: 0; border-bottom: 1px solid var(--border-strong); color: var(--text-muted); }
  .minimal-nav button strong { font-size: 1.1rem; flex: 1; }
  .minimal-nav button .number { font-size: .76rem; align-self: start; }
  .minimal-nav button[aria-pressed="true"] { color: var(--text); border-bottom-color: var(--text); }
  .minimal-nav button[aria-pressed="true"] strong { font-weight: 800; }
  .mini-note { margin-top: 45px; color: var(--text-muted); font-size: .82rem; line-height: 1.8; }
  .mini-note strong { color: var(--text); }
  .editorial { background: var(--warning-soft); color: var(--text); padding: 0 clamp(16px, 4vw, 78px) 72px; }
  .editorial-masthead { max-width: 1550px; margin: auto; }
  .edition-top { display: flex; gap: 15px; justify-content: space-between; padding: 19px 0 14px; border-bottom: 2px solid var(--text); font-size: .63rem; letter-spacing: .12em; }
  .editorial-kicker { margin: 48px 0 18px; font-size: .75rem; letter-spacing: .28em; color: var(--danger); font-weight: 750; }
  .editorial h1 { font-family: Georgia, "Times New Roman", serif; font-size: clamp(3.35rem, 7.7vw, 8.5rem); line-height: .92; letter-spacing: -.057em; margin: 0; font-weight: 500; max-width: 1400px; }
  .editorial h1 i { color: var(--danger); font-weight: 400; }
  .editorial-deck { display: grid; grid-template-columns: 1fr 1.5fr; gap: 25px; align-items: start; padding: 36px 0 55px; border-bottom: 1px solid var(--border-strong); }
  .editorial-deck span { font-size: .7rem; font-weight: 800; letter-spacing: .15em; }
  .editorial-deck p { margin: 0; font: clamp(1.1rem, 2vw, 1.55rem)/1.5 Georgia,serif; }
  .editorial-columns { max-width: 1550px; margin: 0 auto; display: grid; grid-template-columns: minmax(225px, .8fr) minmax(0, 1.8fr); gap: clamp(26px, 6vw, 110px); padding-top: 35px; }
  .editorial-contents h2 { display: flex; justify-content: space-between; font: 400 2.3rem Georgia,serif; margin: 0 0 20px; }
  .editorial-contents button { display: grid; width: 100%; text-align: left; background: transparent; border: 0; border-top: 1px solid var(--border-strong); padding: 19px 8px 20px; color: var(--text); }
  .editorial-contents button small { letter-spacing: .19em; font-size: .63rem; color: var(--text-muted); }
  .editorial-contents button strong { font: 400 clamp(1.45rem, 2.4vw, 2.35rem) Georgia,serif; margin: 10px 0; }
  .editorial-contents button span { color: var(--text-muted); font-size: .81rem; }
  .editorial-contents button[aria-pressed="true"] { background: var(--warning-soft); padding-left: 14px; border-left: 4px solid var(--danger); }
  .editorial-aside { border-top: 2px solid var(--text); padding-top: 18px; margin-top: 30px; color: var(--text-muted); font: italic 1rem/1.6 Georgia,serif; }
  .editorial-article-label { font-size: .67rem; letter-spacing: .22em; border-bottom: 1px solid var(--border-strong); padding-bottom: 15px; margin: 0 0 24px; }
  .editorial-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; border-top: 3px solid var(--text); padding: 23px 0; margin-top: 90px; font: italic 1.7rem Georgia,serif; }
  .editorial-footer span:last-child { font: .67rem Arial,sans-serif; letter-spacing: .13em; }
  .workspace { background: var(--text); color: var(--surface); min-height: 90vh; }
  .workspace-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 17px clamp(16px, 3vw, 38px); border-bottom: 1px solid color-mix(in srgb, var(--text) 65%, var(--surface)); }
  .workspace-name { display: flex; align-items: center; gap: 12px; }
  .workspace-icon { display: grid; place-items: center; font-size: 1.6rem; color: var(--success-soft); background: color-mix(in srgb, var(--text) 90%, var(--surface)); border-radius: 12px; width: 50px; height: 50px; }
  .workspace-name small, .workspace-heading small { font-size: .64rem; letter-spacing: .13em; color: color-mix(in srgb, var(--surface) 75%, var(--text)); display: block; }
  .workspace-name strong { font-size: 1.12rem; display: block; margin-top: 4px; }
