---
/** Risorse hub: navigation anchors and build-generated quality counts. */
import BaseLayout from "../layouts/BaseLayout.astro";
import UiIcon from "../components/icons/UiIcon.astro";
import { catalog } from "../generated/catalog";
import { qualityIndex } from "../generated/quality";
import { goldToolIds } from "../onboarding/quality";
import { LAST_VALUE_STORAGE_KEY } from "../components/workbench/last-value";
import { THEME_STORAGE_KEY } from "../components/shell/theme";

const totalTools = catalog.length;
const certifiedTools = qualityIndex.tools.length;
const unverifiedTools = totalTools - certifiedTools;
const certifiedPercent = Math.round((certifiedTools / totalTools) * 100);

// The certification index (`quality/receipts/expanded-catalog-certification.json`)
// is the machine authority behind these two counts. The page reads the array
// length it can import and asserts the remainder against the catalog, so a
// drift in the generated files shows up as a wrong number rather than a stale
// hand-written one.
if (!Number.isInteger(certifiedTools) || certifiedTools < 0 || unverifiedTools < 0) {
  throw new Error("Il conteggio di certificazione non corrisponde al catalogo generato.");
}

const certifiedIds = goldToolIds(qualityIndex);

interface SectionLink {
  readonly id: string;
  readonly label: string;
}

const sections: readonly SectionLink[] = [
  { id: "come-funziona", label: "Come funziona" },
  { id: "privacy", label: "Privacy" },
  { id: "domande-frequenti", label: "Domande frequenti" },
  { id: "qualita", label: "Qualità dei risultati" },
  { id: "account", label: "Account" },
];

const faqs: readonly { readonly question: string; readonly answer: string }[] = [
  {
    question: "Serve un account?",
    answer: "No. Tutti gli strumenti funzionano senza registrazione. L'account è opzionale e non sblocca nessuna funzione.",
  },
  {
    question: "Gli strumenti sono davvero gratuiti?",
    answer: "Sì: non c'è un piano a pagamento, un limite di utilizzo o una funzione riservata. Non esiste nemmeno un pulsante per acquistare qualcosa.",
  },
  {
    question: "Conservate i miei file?",
    answer: "Gli strumenti locali elaborano i file nel browser, senza archiviarli sul nostro server. I risultati temporanei non sono recuperabili dopo aver chiuso la scheda. Se scegli espressamente «Conserva questo PDF nel browser», una copia resta nel database locale separato finché non la elimini o il browser non la cancella: non viene sincronizzata con l'account. Il server conserva solo dati dell'account e identificativi dei preferiti, non documenti.",
  },
  {
    question: "Funziona senza rete?",
    answer: "Le operazioni dichiarate locali possono continuare dopo il caricamento dei loro componenti, ma nuove pagine, account e controlli verso servizi esterni richiedono rete. La possibilità di continuare senza connessione dipende anche dai dati e dalle librerie già caricati.",
  },
  {
    question: "Posso usare i risultati per scopi commerciali?",
    answer: "Sì. Quello che produci con gli strumenti è tuo: non rivendichiamo nessun diritto sul risultato e non chiediamo nessuna attribuzione.",
  },
  {
    question: "Cosa succede ai miei dati se svuoto il browser?",
    answer: "I dati memorizzati solo in questo browser, inclusi recenti, preferenze, ultimi risultati brevi ed eventuali PDF conservati volontariamente, possono andare persi. I preferiti già sincronizzati e i dati dell'account possono restare sul server finché non elimini anche l'account: svuotare il browser non li cancella.",
  },
  {
    question: "Esiste un'API?",
    answer: "No. L'unico modo per usare uno strumento è aprirne la pagina: non ci sono endpoint pubblici da chiamare da un tuo script. Puoi però installare l'area di lavoro come app dal browser, perché il manifest è già pubblicato.",
  },
  {
    question: "Perché alcuni strumenti risultano in verifica?",
    answer: "L'indice mostra quali strumenti hanno una certificazione registrata e quali sono ancora in verifica. Una prova precedente non garantisce che ogni variante, browser o nuova versione sia stata verificata: valgono i limiti dichiarati per la singola operazione.",
  },
];
---

<BaseLayout
  title="Risorse"
  description="Come funzionano gli strumenti, cosa resta sul tuo dispositivo, le domande frequenti e cosa significa la certificazione dei risultati."
>
  <article class="resources-page">
    <header class="resources-heading">
      <ol class="breadcrumb">
        <li><a href="/">Home</a></li>
        <li aria-current="page">Risorse</li>
      </ol>
      <h1>Risorse</h1>
      <p class="resources-lede">
        Come funziona uno strumento, cosa resta sul tuo dispositivo e cosa significa
        che un risultato è certificato: qui trovi le risposte, senza giri di parole.
      </p>
    </header>

    <div class="resources-layout">
      <nav class="resources-toc" aria-labelledby="resources-toc-title">
        <h2 class="resources-toc-title" id="resources-toc-title">In questa pagina</h2>
        <ul>
          {sections.map((section) => (
            <li><a href={`#${section.id}`}>{section.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="resources-body">
        <section class="resources-section" aria-labelledby="come-funziona">
          <h2 id="come-funziona">Come funziona</h2>
          <p>
            Le pagine degli strumenti vengono caricate dal sito e il lavoro dichiarato locale
            viene eseguito nel browser. Account, sincronizzazione dei preferiti e strumenti
            che interrogano fonti esterne sono funzioni distinte: quando un'operazione richiede
            la rete, deve essere indicato nello strumento.
          </p>
          <ul class="resources-steps">
            <li>
              <span class="resources-step-icon" aria-hidden="true"><UiIcon name="search" size={20} /></span>
              <strong>Trova lo strumento</strong>
              <p>Con ⌘K (Ctrl+K su Windows e Linux) apri la ricerca da qualsiasi punto del sito, oppure sfoglia tutti gli strumenti con i filtri in <a href="/strumenti/">/strumenti/</a>.</p>
            </li>
            <li>
              <span class="resources-step-icon" aria-hidden="true"><UiIcon name="upload" size={20} /></span>
              <strong>Inserisci dati o file</strong>
              <p>Scrivi nel campo, incolla il testo o scegli un file dal dispositivo: il file viene letto in locale, senza caricamenti.</p>
            </li>
            <li>
              <span class="resources-step-icon" aria-hidden="true"><UiIcon name="check-circle" size={20} /></span>
              <strong>Leggi il risultato</strong>
              <p>Regola solo le opzioni che servono e preleva il risultato dalla colonna dedicata, pronto da copiare o scaricare.</p>
            </li>
          </ul>
          <p class="resources-note">
            Se un'operazione si interrompe, controlla lo stato prima di ricaricare: un risultato
            ancora solo nella scheda potrebbe non essere recuperabile dopo il caricamento.
          </p>
        </section>

        <section class="resources-section" aria-labelledby="privacy">
          <h2 id="privacy">Privacy</h2>
          <p>
            Non serve un account per usare gli strumenti locali: i file selezionati sono
            elaborati sul dispositivo quando lo strumento dichiara la modalità locale.
            L'account opzionale usa il server per autenticazione e preferiti; alcune utility
            che verificano indirizzi o risorse esterne possono richiedere richieste di rete.
            Le singole operazioni devono specificare che cosa viene inviato, quando applicabile.
          </p>

          <div class="resources-card">
            <h3>Cosa viene salvato, e dove</h3>
            <ul class="resources-storage">
              <li>
                <span class="pill pill-brand"><UiIcon name="devices" size={14} /> IndexedDB</span>
                <p>Il database <code>utility-workbench</code> conserva sul browser preferiti, strumenti installati, recenti e profilo di lavoro. Non è un archivio permanente dei file elaborati.</p>
              </li>
              <li>
                <span class="pill pill-brand"><UiIcon name="devices" size={14} /> IndexedDB · solo su richiesta</span>
                <p>Il database <code>strumentini-optin-pdf-341</code> conserva solo PDF verificati che scegli esplicitamente di salvare nel browser, al massimo cinque file e 24 MiB complessivi. Non è sincronizzato né garantito contro la pulizia del browser. Puoi eliminarli individualmente dallo strumento PDF o insieme agli altri dati locali nelle impostazioni.</p>
              </li>
              <li>
                <span class="pill pill-brand"><UiIcon name="clock" size={14} /> localStorage</span>
                <p>La chiave <code>{LAST_VALUE_STORAGE_KEY}</code> può ricordare valori di risultato brevi: non sostituisce il salvataggio volontario di un file. Puoi rimuoverli cancellando i dati del sito.</p>
              </li>
              <li>
                <span class="pill pill-brand"><UiIcon name="sliders" size={14} /> sessionStorage</span>
                <p>La chiave <code>strumentini:workbench-context:v1</code> tiene il contesto di ricerca — gli identificativi degli strumenti installati e recenti — solo per la durata della scheda.</p>
              </li>
              <li>
                <span class="pill pill-brand"><UiIcon name="sun" size={14} /> localStorage</span>
                <p>La chiave <code>{THEME_STORAGE_KEY}</code> ricorda la tua scelta fra tema chiaro e scuro.</p>
              </li>
            </ul>
          </div>

          <div class="resources-card">
            <h3>Account e preferiti sincronizzati</h3>
            <p>
              Con un account vengono conservati sul server i dati necessari all'accesso e gli
              identificativi degli strumenti preferiti sincronizzati. Non viene creato un archivio
              online dei file elaborati o dei risultati temporanei. Cancellare i soli dati locali
              non elimina automaticamente l'account: la cancellazione dell'account è separata.
            </p>
          </div>

          <div class="resources-card">
            <h3>Telemetria di validazione</h3>
            <p>
              È <strong>disattivata per impostazione predefinita</strong>. Anche se una build
              configura <code>PUBLIC_VALIDATION_COHORT=true</code> e
              <code>PUBLIC_TELEMETRY_ENDPOINT</code>, non invia eventi di validazione fino
              al consenso esplicito nel pannello Privacy e telemetria. Il consenso è salvato
              nel browser, revocabile e non include file, nomi o valori inseriti.
            </p>
          </div>

          <p class="resources-note">
            Puoi cancellare tutto in qualsiasi momento dai dati del sito nelle impostazioni del
            browser.
          </p>
        </section>

        <section class="resources-section" aria-labelledby="domande-frequenti">
          <h2 id="domande-frequenti">Domande frequenti</h2>
          <div class="resources-faq">
            {faqs.map((faq) => (
              <details class="resources-faq-item">
                <summary>{faq.question}<UiIcon name="chevron-down" size={18} /></summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="resources-section" aria-labelledby="qualita">
          <h2 id="qualita">Qualità dei risultati</h2>
          <p>
            Il catalogo indica le operazioni disponibili e i loro limiti. Una certificazione
            registrata attesta test eseguiti su specifici casi e revisioni: non garantisce
            tutte le varianti di formato, ogni dispositivo o una release successiva.
          </p>

          <dl class="resources-counts">
            <div>
              <dt>Strumenti nel catalogo</dt>
              <dd>{totalTools}</dd>
            </div>
            <div>
              <dt>Con certificazione registrata nell'indice</dt>
              <dd>{certifiedTools}</dd>
            </div>
            <div>
              <dt>Ancora in verifica nell'indice</dt>
              <dd>{unverifiedTools}</dd>
            </div>
          </dl>

          <p class="resources-note">
            Nell'indice sono registrate certificazioni per {certifiedTools} strumenti su {totalTools}
            ({certifiedPercent}%); gli altri {unverifiedTools} sono in verifica. La validità sulla
            versione pubblicata richiede anche il controllo aggiornato delle fonti e delle dipendenze.
          </p>

          <p>
            Nella pagina di uno strumento lo stato è dichiarato apertamente: <span class="pill pill-success"><UiIcon name="check-circle" size={14} /> Verificato</span>
            per i {certifiedTools} con prova registrata, <span class="pill pill-warning"><UiIcon name="alert" size={14} /> In verifica</span> per gli altri.
            Il badge indica lo stato registrato nell'indice, non una garanzia generale di
            sicurezza, compatibilità o freschezza di tutte le funzioni.
          </p>

          <p class="resources-note">
            I conteggi sono letti a ogni build dall'indice di certificazione generato in
            <code>src/generated/quality.ts</code> ({certifiedIds.size} identificativi) e dal catalogo in
            <code>src/generated/catalog.ts</code>, quindi non restano indietro rispetto al codice.
          </p>
        </section>

        <section class="resources-section" aria-labelledby="account">
          <h2 id="account">Account</h2>
          <p>
            L'account è <strong>opzionale</strong>: gli strumenti locali restano accessibili anche
            senza registrazione. L'accesso gestisce l'identità e la sincronizzazione dei preferiti
            sui dispositivi; non recupera un file o un risultato rimasto soltanto in una scheda.
            Per accedere visita <a href="/accedi/">/accedi/</a>.
          </p>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* One measure for the whole page, so the header, the sticky rail, and the
     prose share the same x-offset on every breakpoint. */
  .resources-page {
    width: min(calc(100% - (var(--container-gutter) * 2)), var(--container-max));
    margin: 0 auto;
    padding: var(--space-8) 0 var(--space-20);
  }

  .resources-heading {
    max-width: var(--measure-copy);
    margin-bottom: var(--space-10);
  }

  .resources-heading h1 {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-display);
    line-height: var(--line-height-display);
    letter-spacing: var(--tracking-display);
  }

  .resources-lede {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-body-lg);
    line-height: var(--line-height-relaxed);
  }

  .resources-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  /* The rail. No framework: the anchor is already the only state a browser
     keeps for a same-page link, so a small script mirrors it onto aria. */
  .resources-toc {
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .resources-toc-title {
    margin: 0 0 var(--space-3);
    color: var(--text-faint);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .resources-toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resources-toc li { display: flex; }

  .resources-toc a {
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .resources-toc a:hover { color: var(--brand); }

  .resources-toc a[aria-current="true"] {
    color: var(--brand);
    font-weight: var(--font-weight-semibold);
  }

  .resources-body { min-width: 0; }

  .resources-section {
    padding-bottom: var(--space-10);
    border-bottom: var(--border-width) solid var(--border);
    margin-bottom: var(--space-10);
    scroll-margin-top: calc(var(--nav-height) + var(--space-4));
  }

  .resources-section:last-of-type {
    padding-bottom: 0;
    border-bottom: 0;
    margin-bottom: 0;
  }

  .resources-section > h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-h2);
    letter-spacing: var(--tracking-heading);
  }

  .resources-section > p {
    max-width: var(--reading-max);
    margin: 0 0 var(--space-5);
    color: var(--text-muted);
    line-height: var(--line-height-relaxed);
  }

  .resources-section > p:last-child { margin-bottom: 0; }

  .resources-note {
    color: var(--text-faint) !important;
    font-size: var(--font-size-sm);
  }

  .resources-step-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--brand-soft);
    color: var(--brand);
  }

  .resources-steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }

  .resources-steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    align-items: center;
    padding: var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .resources-steps li > strong { font-size: var(--font-size-h3); }

  .resources-steps li > p {
    grid-column: 2;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .resources-card {
    padding: var(--space-6);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-5);
  }

  .resources-card:last-child { margin-bottom: 0; }

  .resources-card h3 {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-h3);
  }

  .resources-card p {
    max-width: var(--reading-max);
    margin: 0;
    color: var(--text-muted);
    line-height: var(--line-height-body);
  }

  .resources-storage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resources-storage li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
  }

  .resources-storage p {
    margin: 0;
    padding-top: var(--space-1);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 480px) {
    .resources-storage li { grid-template-columns: minmax(0, 1fr); }
    .resources-storage li > span { justify-self: start; }
    .resources-storage p { padding-top: 0; }
  }

  .resources-faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }

  .resources-faq-item {
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .resources-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
  }

  .resources-faq-item summary::-webkit-details-marker { display: none; }

  .resources-faq-item summary :global(.icon) {
    color: var(--text-faint);
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .resources-faq-item[open] summary :global(.icon) { transform: rotate(180deg); }

  .resources-faq-item p {
    max-width: var(--reading-max);
    margin: 0;
    padding: 0 var(--space-5) var(--space-5);
    color: var(--text-muted);
    line-height: var(--line-height-body);
  }

  .resources-counts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0 0 var(--space-5);
  }

  .resources-counts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .resources-counts dt {
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .resources-counts dd {
    margin: 0;
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-semibold);
    font-variant-numeric: tabular-nums lining-nums;
  }

  code {
    padding: 0 var(--space-1);
    border-radius: var(--radius-xs);
    background: var(--surface-subtle);
    color: var(--text);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-mono);
    overflow-wrap: anywhere;
  }

  /* The rail becomes a sticky column only where there is width for one. */
  @media (min-width: 900px) {
    .resources-layout { grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); }

    .resources-toc {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-4));
    }

    .resources-toc ul {
      flex-direction: column;
      gap: var(--space-2);
    }

    .resources-counts { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    .resources-counts > div {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>

<script>
  /**
   * `:target` already reaches the anchored section; the rail marks the same
   * section for assistive technology by mirroring the hash onto `aria-current`.
   * No framework, no observer, no stored state.
   */
  const railLinks = [...document.querySelectorAll<HTMLAnchorElement>(".resources-toc a")];

  function markCurrentSection(): void {
    const hash = window.location.hash;
    for (const link of railLinks) {
      link.setAttribute("aria-current", link.hash === hash && hash !== "" ? "true" : "false");
    }
  }

  window.addEventListener("hashchange", markCurrentSection);
  markCurrentSection();
</script>
