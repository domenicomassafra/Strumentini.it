# Cloudflare Workers assets and the API Worker use this same policy.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(self)
  X-Frame-Options: DENY

# Astro gives compiled assets content-hashed filenames, so they can be cached across releases.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# These static assets have stable filenames; allow them to refresh after one week.
/fonts/*
  Cache-Control: public, max-age=604800

/models/*
  Cache-Control: public, max-age=604800

/ocr-246/*
  Cache-Control: public, max-age=604800

/ocr-395/*
  Cache-Control: public, max-age=604800
