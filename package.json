{
  "name": "utilityos-validation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "catalog:build": "tsx scripts/build-catalog.ts",
    "catalog:check": "tsx scripts/build-catalog.ts --check",
    "test": "npm run catalog:build && vitest run",
    "check": "npm run catalog:build && astro check",
    "build": "npm run catalog:build && astro build && tsx scripts/inspect-build.ts",
    "gold:business-day": "npm run catalog:build && tsx scripts/gold-certify.ts",
    "gold:sabotage": "npm run catalog:build && node scripts/verify-gold-sabotage.mjs",
    "acceptance:browser": "node scripts/browser-acceptance.mjs",
    "acceptance:image-resize:physical:serve": "npm run build && tsx scripts/generate-image-resize-physical-fixtures.ts && node scripts/serve-image-resize-physical.mjs",
    "acceptance:image-resize:physical:record": "tsx scripts/record-image-resize-physical.ts",
    "gold:image-resize": "tsx scripts/gold/image-resize-certify.ts",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "verify:ticket-01": "npm test && npm run check && npm run build && npm run catalog:check && npm run gold:business-day && npm run gold:sabotage && npm run acceptance:browser && npm run deploy:check"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "astro": "7.3.4",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/papaparse": "^5.5.2",
    "csv-parse": "^7.0.2",
    "hash-wasm": "^4.12.0",
    "papaparse": "^5.7.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "wrangler": "4.137.0",
    "zod": "4.6.5"
  }
}
