{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strumentiutili-it",
  "compatibility_date": "2026-09-24",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Astro writes `/strumenti/index.html`; without this a visitor typing
    // `/strumenti` gets our 404 instead of the page.
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "strumentiutili-auth",
      "database_id": "b172e08e-3a81-41dd-87d4-c8c4859b7274",
      "migrations_dir": "worker/migrations"
    }
  ]
}
