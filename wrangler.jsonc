{
  "$schema": "node_modules/wrangler/config-schema.json",
    "name": "strumentini",
  "compatibility_date": "2026-09-24",
  "main": "worker/index.ts",
  "routes": [
    {
      "pattern": "strumentini.it",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Astro writes `/strumenti/index.html`; without this a visitor typing
    // `/strumenti` gets our 404 instead of the page.
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      // Strumentini auth database; migrated from the pre-rebrand empty account DB.
      "database_name": "strumentini-auth",
      "database_id": "3351c8bf-31fc-4716-9d92-2b07c4d8fd2a",
      "migrations_dir": "worker/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PASSWORD_KDF", "class_name": "PasswordKdf" }]
  },
  "exports": {
    "PasswordKdf": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [
    { "name": "KDF_IP_LIMIT", "namespace_id": "32820263", "simple": { "limit": 8, "period": 60 } },
    { "name": "KDF_COLO_LIMIT", "namespace_id": "32820264", "simple": { "limit": 30, "period": 60 } }
  ]
}
