{
  "schema_version": 1,
  "canonical_fields": [
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_term",
    "utm_content"
  ],
  "vectors": [
    {
      "base": "https://example.com/landing",
      "params": [
        [
          "utm_source",
          "newsletter"
        ],
        [
          "utm_medium",
          "email"
        ],
        [
          "utm_campaign",
          "fall sale"
        ]
      ],
      "built": "https://example.com/landing?utm_source=newsletter&utm_medium=email&utm_campaign=fall+sale"
    },
    {
      "url": "https://example.com/?utm_source=a&utm_source=b&utm_campaign=x%20y",
      "parsed": [
        [
          "utm_source",
          "a"
        ],
        [
          "utm_source",
          "b"
        ],
        [
          "utm_campaign",
          "x y"
        ]
      ]
    },
    {
      "url": "https://example.com/?a=1&utm_source=x&gclid=token#frag",
      "cleaned": "https://example.com/?a=1#frag",
      "dropped": [
        "utm_source",
        "gclid"
      ]
    }
  ],
  "policy": {
    "preserve_unknown_query": true,
    "preserve_fragment": true,
    "known_tracking_match": "ASCII case-insensitive"
  }
}
