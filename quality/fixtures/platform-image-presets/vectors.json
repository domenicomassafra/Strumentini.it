{
  "schema_version": 1,
  "provenance": "Hand-worked arithmetic over the published canvas sizes named in each preset's `source`. The crop, contain and scale results are computed from the two ratios with integer rounding, so every expectation below can be checked with a calculator rather than read back from the implementation. Offsets are rounded half up, the rule JavaScript's Math.round applies, so an odd leftover pixel lands on the right-hand or bottom edge.",
  "source_binding": "Each preset names the platform guidance page that publishes the canvas, and the date it was last checked against it. The values are published recommendations, not contractual requirements, and they change.",
  "rules": {
    "contain": "the largest box with the source ratio that fits inside the canvas: scale = min(canvasWidth/sourceWidth, canvasHeight/sourceHeight)",
    "cover_crop": "the largest box with the canvas ratio that fits inside the source, centred: scale = min(sourceWidth/canvasWidth, sourceHeight/canvasHeight)",
    "cropped_fraction": "1 − (cropWidth × cropHeight) / (sourceWidth × sourceHeight)",
    "fit": "same-ratio when the two ratios differ by less than 0.5%; crop-needed when the source is wider; pad-needed when the source is taller",
    "upscale_factor": "max(1, canvasWidth / min(sourceWidth, cropWidth)), rounded to two decimals"
  },
