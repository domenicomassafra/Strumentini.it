{
  "schema_version": 1,
  "note": "One deterministic public-module vector per promoted PDF tool. Binary inputs live next to this file and are referenced by $fixture markers resolved by scripts/gold/pdf-certify.ts. annotated.pdf and page-scoped-images-metadata.pdf are hand-authored synthetic bytes; simple-*.pdf and jpeg-1page.pdf are frozen engine outputs; tiny.jpg is a 1x1 baseline JPEG.",
  "tool_vectors": [
    { "tool_id": "pdf-merge", "input": { "$fixtures": ["simple-3page.pdf", "simple-3page.pdf"] }, "expected": { "pageCount": 6, "artifactCount": 1 } },
    { "tool_id": "pdf-split", "input": { "$fixture": "simple-3page.pdf", "groups": [[1], [2, 3]] }, "expected": { "artifactCount": 2, "operation": "split" } },
    { "tool_id": "pdf-page-reorder", "input": { "$fixture": "simple-3page.pdf", "order": [3, 1, 2] }, "expected": { "order": [3, 1, 2], "artifactCount": 1 } },
    { "tool_id": "pdf-rotate", "input": { "$fixture": "simple-3page.pdf", "rotations": { "1": 90 } }, "expected": { "rotations": { "1": 90 }, "artifactCount": 1 } },
    { "tool_id": "pdf-page-delete-extract", "input": { "$fixture": "simple-3page.pdf", "pages": [2], "mode": "delete" }, "expected": { "mode": "delete", "pages": [2], "artifactCount": 1 } },
    { "tool_id": "images-to-pdf", "input": { "$fixtures": ["tiny.jpg"] }, "expected": { "pageCount": 1, "artifactCount": 1 } },
    { "tool_id": "pdf-to-images", "input": { "$fixture": "simple-2page.pdf", "pages": [2, 1], "mime": "image/png", "scale": 1, "quality": 0.9 }, "expected": { "pageCount": 2, "selectedPages": [2, 1], "renderer": "pdfjs-local-lazy", "renderedImageCount": 2, "zipIncluded": true, "zipEntries": 2 } },
    { "tool_id": "pdf-text-extraction", "input": { "$fixture": "annotated.pdf", "mode": "content-order" }, "expected": { "text": "===== PAGINA 1 =====\n\nlink page", "mode": "content-order", "selectedPages": [1], "truncated": false } },
    { "tool_id": "pdf-metadata-inspector", "input": { "$fixture": "page-scoped-images-metadata.pdf" }, "expected": { "pageCount": 2, "encrypted": false, "inspection": { "metadata": { "title": "Upgrade fixture", "recognizedInfo": { "Title": "Upgrade fixture", "Author": "Strumentini" }, "unknownInfo": { "CustomKey": "unknown-value" }, "xmpObjectIds": [9] }, "pages": [{ "width": 300, "height": 400 }] } } },
    { "tool_id": "pdf-metadata-remover", "input": { "$fixture": "page-scoped-images-metadata.pdf" }, "expected": { "artifactCount": 1, "verification": { "reparsed": true, "metadataRemoved": true, "pageCount": { "before": 2, "after": 2, "stable": true }, "textBaseline": { "status": "verified", "stable": true, "changedPages": [] } } } },
    { "tool_id": "pdf-page-size-inspector", "input": { "$fixture": "annotated.pdf" }, "expected": { "pageCount": 1, "pages": [{ "width": 300, "height": 400 }] } },
    { "tool_id": "pdf-page-count-verifier", "input": { "$fixture": "annotated.pdf" }, "expected": { "pageCount": 1, "declaredPageCount": 1, "objectCount": 8, "encrypted": false, "validSignature": true } },
    { "tool_id": "pdf-password-check-remove", "input": { "$fixture": "encrypted-mark.pdf", "mode": "check" }, "expected": { "mode": "check", "encrypted": true } },
    { "tool_id": "pdf-flatten", "input": { "$fixture": "annotated.pdf" }, "expected": { "artifactCount": 1 } },
    { "tool_id": "pdf-form-inspector", "input": { "$fixture": "annotated.pdf" }, "expected": { "pageCount": 1, "encrypted": false, "forms": [{ "name": "full_name", "fieldType": "Tx", "value": "Ada" }] } },
    { "tool_id": "pdf-link-extractor", "input": { "$fixture": "annotated.pdf" }, "expected": { "pageCount": 1, "links": [{ "uri": "https://example.test/a" }] } },
    { "tool_id": "pdf-image-extractor", "input": { "$fixture": "page-scoped-images-metadata.pdf", "dedupe": true }, "expected": { "artifactCount": 1, "mode": "embedded-original-compressed-bytes", "deduplicated": true, "selectedPages": [1, 2], "provenance": [{ "object": 5, "occurrences": [{ "page": 1, "resourceName": "ImShared", "object": 5 }, { "page": 2, "resourceName": "ImShared", "object": 5 }] }], "unsupported": [{ "page": 1, "resourceName": "ImUnsupported", "object": 6, "filters": ["FlateDecode"] }] } },
    { "tool_id": "pdf-compare-lite", "input": { "$first": "simple-2page.pdf", "$second": "simple-2page-changed.pdf" }, "expected": { "summary": "Compared 2 and 2 pages; 0 geometry and 1 text differences found." } },
    { "tool_id": "pdf-compression-lite", "input": { "$fixture": "simple-2page.pdf" }, "expected": { "artifactCount": 1 } },
    { "tool_id": "document-handoff-manifest", "input": { "$fixtures": ["simple-3page.pdf"] }, "expected": { "manifest": { "files": [{ "name": "document.pdf", "byteLength": 1141, "mime": "application/pdf", "signature": "pdf", "pageCount": 3, "encrypted": false, "sha256": "d919bbbcec4ae25a614fa6018720f22b0b5ccac35ebe440f91609bea3755a203" }] } } }
  ]
}
