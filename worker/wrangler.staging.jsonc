{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "strumentini-328-staging-20261015",
  "compatibility_date": "2026-09-24",
  "main": "index.ts",
  // This file deliberately has NO production custom-domain route.
  "workers_dev": true,
  "routes": [],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
